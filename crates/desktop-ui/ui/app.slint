// nori's desktop window, laid out as Android's look has it on a wide screen: the page under a top pill and a
// player pill, a panel on the right (queue, lyrics) and a full-window Now Playing. Draws and forwards input only.

import { ListView, Switch, ComboBox } from "std-widgets.slint";
import { Icons, Glyph } from "icons.slint";
export { Icons }
// The Android app's typefaces, from its resources.
import "../../../app/src/main/res/font/inter.ttf";
import "../../../app/src/main/res/font/literata.ttf";

export struct Card {
    id: string,
    title: string,
    sub: string,
    art: string,
    // The artist the subtitle names, whose page a click on it opens (an album's); empty for none.
    sub-artist: string,
    // What it is: 0 an album, 1 an artist, 2 a playlist, 3 a song.
    kind: int,
}

// A piece of the line being sung (sung.rs): a word, a syllable or what lies between, where it was laid
// (x, y, its width w), its fill (the white's alpha at its start a0, at a aa, at b ab and at its end a1, a and
// b being fractions of its width), how far it has risen (0..1) and how much a held note has swelled it.
export struct LyricPiece {
    text: string,
    x: float,
    y: float,
    w: float,
    a: float,
    b: float,
    a0: float,
    aa: float,
    ab: float,
    a1: float,
    lift: float,
    swell: float,
}

// A place the music can play (remote control), as the devices panel lists it: this computer (no id) or one
// of the account's other devices.
export struct DeviceRow {
    id: string,
    name: string,
    // What it plays, or that it plays nothing; empty for this computer.
    line: string,
    // 0 a computer, 1 a phone, 2 a terminal, 3 a guest.
    kind: int,
    // The music plays there.
    active: bool,
    // Its answer to the last command, when it refused.
    note: string,
}

// Someone in the jam this computer hosts: their initial for the avatar, and their role in words.
export struct JamPerson {
    id: string,
    name: string,
    initial: string,
    role: string,
    admin: bool,
}

// A song asked for in the jam, waiting for the host or an admin: who asked, and what accepting does.
export struct JamAsk {
    request: string,
    title: string,
    line: string,
    // What accepting does beyond queueing it (a provider's song is downloaded first); empty for nothing.
    note: string,
    art: string,
}

// A name on an artist line and the artist page it opens; empty for the words between names.
export struct ArtistLink {
    text: string,
    id: string,
}

// How a song's artist line links its artists (menus.rs's artist_line): its names one by one (`pieces`), or
// the artists a click on it lists (`choices`) where it does not name them one by one. Both empty: the line
// opens its one artist.
export struct Credits {
    pieces: [ArtistLink],
    choices: [ArtistLink],
}

// A line of a song's menu beyond playing it (menus.rs's `song_menu`): 0 its seal, 1 its album, 2 one of
// its artists (`id` the page), 3 download, 4 radio, 5 play next, 6 add to queue, 7 add to a playlist,
// 8 remove the download, 9 stop it, 10 add to the library, 11 instant mix, 12 leave out of mixes,
// 13 share, 14 details, 15 start a jam, 16 the lyrics sheet, 17 the sleep timer. `more`: one of the lines
// reached for less, folded under More; `enabled`: offered now, else greyed; `filled`: its seal is the
// filled one (the song is a favorite).
export struct SongGo {
    title: string,
    kind: int,
    id: string,
    more: bool,
    enabled: bool,
    filled: bool,
}

// One line of a song's details: what it is, and the server's value.
export struct Detail {
    label: string,
    value: string,
}

export struct SongRow {
    title: string,
    artist: string,
    credits: Credits,
    album: string,
    // The pages a click on the artist and the album opens; empty for none.
    artist-id: string,
    album-id: string,
    time: string,
    art: string,
    // The list index a click plays or jumps to.
    index: int,
    playing: bool,
    // In the queue: already played (above the song playing).
    played: bool,
    // In the queue: folding away (it is leaving), or new (it opens when it is put in).
    leaving: bool,
    fresh: bool,
    // Who asked for it, when it came in through the jam.
    by: string,
}

// A row of the settings page: 0 a group's heading, 1 a switch, 2 a choice, 3 a button, 4 a fact, 5 a slider,
// 6 a lyrics source in its ranked list, 7 a key typed in, 8 a server, 9 a note,
// 11 a page it opens, 12 a lone button, 13 the season tiles, 14 the four modes. `first` and `last` round the group's corners.
export struct SettingRow {
    kind: int,
    name: string,
    title: string,
    detail: string,
    on: bool,
    enabled: bool,
    options: [string],
    chosen: int,
    button: string,
    value: float,
    min: float,
    max: float,
    first: bool,
    last: bool,
    // A lyrics service switched on only once given the key it lacks: switching it on asks for the key.
    keyed: bool,
    // A usage row's parts, as fractions of the whole, in `options`' order.
    shares: [float],
    // A usage row's downloads, a line per profile, drawn under its downloads part.
    breakdown: [string],
}

// A line with a quieter one under it: an AutoEQ curve, a saved sound profile.
export struct EqLine {
    title: string,
    detail: string,
}

// A kind of profile the login page adds (the core's providers): its words, and the fields its form asks.
export struct LoginKind {
    name: string,
    note: string,
    add: string,
    asks-name: bool,
    asks-address: bool,
    asks-user: bool,
    asks-password: bool,
}

// A band of the equalizer page: its label, its gain, and what its value reads.
export struct EqBandRow {
    label: string,
    gain: float,
    value: string,
    uses-gain: bool,
}

// A mix on Home's "For you": its id, name and caption, up to four cover ids, the mix's own colour under its
// covers, and its card's paper and ink.
export struct Pick {
    id: string,
    title: string,
    sub: string,
    covers: [string],
    seed: color,
    page: color,
    ink: color,
}

export struct Shelf {
    title: string,
    cards: [Card],
    // Read (with or without cards): until then the shelf holds its place with plates.
    loaded: bool,
}

// The chrome's geometry (the compositor's layout, compositor.rs, which must match) and its look.
export global Chrome {
    // The top pill's and the player pill's places in the window (app.rs fills them from the compositor).
    in property <length> top-x;
    in property <length> top-w;
    in property <length> player-x;
    in property <length> player-w;
    out property <length> top-radius: 24px;
    // Concentric with the song's cover: its 14 px corner plus the 6 px it sits in from the edge.
    out property <length> player-radius: 20px;
    // How much of the page's colour lies over the blurred page inside a pill: 55 %, or 88 % where it is not blurred.
    in property <float> tint: 0.55;
    // The room a page keeps under the top pill and above the player pill; content runs on under them.
    out property <length> top-room: 76px;
    out property <length> bottom-room: 96px;
    // The main window's size (the window keeps it).
    in-out property <length> window-width;
    in-out property <length> window-height;
    // How far up a menu `height` tall, opened at `y` in the window, moves to clear the player pill, which
    // lies over the window's foot; never above the top pill.
    public pure function menu-lift(y: length, height: length) -> length {
        return max(0px, min(y + height - (root.window-height - root.bottom-room), y - root.top-room));
    }
    // Where a menu `width` wide opens beside a pointer at `x` in the window: to its right, or flipped to its
    // left where it would run out of the window.
    public pure function menu-flip(x: length, width: length) -> length {
        return x + width > root.window-width - 8px ? -width : 0px;
    }
}

// The menus' shapes: every menu is one popover, its rows inset by `inset`, so a row's corner (and the cover at a
// menu's head) is the popover's less that inset, concentric with it.
global MenuShape {
    out property <length> radius: 14px;
    out property <length> inset: 6px;
    out property <length> inner: self.radius - self.inset;
    out property <length> width: 260px;
    out property <length> row: 32px;
    // A head (a 40 px cover and its inset) and the hairline under it.
    out property <length> head: 40px + 2 * self.inset + 1px;
}

// The two typefaces, as Android has them: Inter for everything, Literata for what a page is called.
export global Type {
    out property <string> body: "Inter Variable";
    out property <string> title: "Literata";
}

// Reduced motion (nori's Motion setting, app.rs fills it): every flourish is a direct change.
export global Motion {
    in property <bool> reduced;
}

// Whether the music is moving now (playing, not waiting for bytes): the playing bars move only then.
export global Playing {
    in property <bool> advancing;
}

// The song playing's glyph, as Android's: four bars at speeds that never fall into step, moving with the
// music and standing at rest while it waits or is paused. About thirty steps a second, and only while a
// row with it is on screen.
component PlayingBars inherits Rectangle {
    in property <color> colour;
    property <float> phase;
    property <length> bar: self.width / 7;
    Timer {
        interval: 34ms;
        running: Playing.advancing;
        triggered => { root.phase += 0.034; }
    }
    for i in 4: Rectangle {
        property <float> level: Playing.advancing ? 0.5 + 0.5 * sin((root.phase * (5.1 + i * 1.3) + i * 1.7) * 1rad) : [0.35, 0.8, 0.5, 0.65][i];
        x: i * root.bar * 2;
        width: root.bar;
        height: root.height * (0.28 + 0.72 * self.level);
        y: root.height - self.height;
        border-radius: root.bar / 2;
        background: root.colour;
    }
}

// The colors of the page the window is on (look.rs paints them: the season's palette, or a cover's page).
export global Theme {
    in property <color> ground;
    in property <color> text;
    in property <color> dim;
    in property <color> faint;
    in property <color> hairline;
    in property <color> hover;
    in property <color> chosen;
    in property <color> fill;
    in property <color> panel;
    in property <color> raised;
    in property <color> accent;
    in property <color> on-accent;
    // The page's main button (Play) and a quieter plate with its ink.
    in property <color> pill;
    in property <color> pill-ink;
    in property <color> plate;
    in property <color> plate-ink;
    // The chrome's outline.
    in property <color> outline;
    // A switch that is on.
    in property <color> on;
    in property <color> on-on;
    in property <color> danger;
    in property <color> edge;
    in property <bool> dark;
    // Each season's page and accent (spring to winter), for the season tiles.
    in property <[color]> season-pages;
    in property <[color]> season-accents;
    // A storage bar's first parts (the core's `usage_accents`).
    in property <[color]> usage-accents;
    // The sheet on the right (lyrics, the queue, the devices).
    out property <length> panel-w: 320px;
}

// The jam this computer hosts, or is a guest in (app.rs fills it). The queue panel shows it while it is
// on; the devices panel and the song menus start it.
export global Jam {
    // Jams are switched on and the server relays them: they can be started.
    in property <bool> on;
    in property <bool> hosting;
    // This computer is a guest in someone's jam: the app asks the host for songs and plays nothing itself.
    in property <bool> guest;
    // The host's name, for a guest.
    in property <string> host;
    // Why jams cannot start here, when they are switched on and cannot.
    in property <string> note;
    in property <string> link;
    // Why the invite works only at home (the server's address is a home network's), or empty.
    in property <string> reach;
    in property <image> qr;
    // Who joined, the host left out.
    in property <[JamPerson]> people;
    // "Jam · 2 listening", for the player and the devices panel; "2 listening" under the jam's title.
    in property <string> strip;
    in property <string> listening;
    in property <[JamAsk]> asks;
    // The jam's guests may listen along.
    in property <bool> along;
    callback set-along(bool);
    in property <bool> remote-songs;
    callback set-remote-songs(bool);
    // A guest plays the jam here, in step with the host; why it cannot when it asked to.
    in property <bool> here;
    // What the player offers a guest by its role (an admin's reach the host, a guest's play and pause its own
    // listening); all of it outside a jam.
    in property <bool> can-play: true;
    in property <bool> can-skip: true;
    in property <bool> can-seek: true;
    in property <string> along-note;
    callback listen(bool);
    callback start();
    callback end();
    callback copy-link();
    callback decide(string, bool);
    callback promote(string, bool);
    callback send-out(string);
    callback leave();
}

// Opens an artist's or an album's page, from wherever its name shows (app.rs answers).
export global Go {
    callback artist(string);
    callback album(string);
}

// An artist's or album's name that opens its page: a pointer and an underline under it while hovered.
component Link inherits Text {
    in property <string> artist;
    in property <string> album;
    property <length> size: root.font-size > 0 ? root.font-size : 13px;
    lt := TouchArea {
        enabled: root.artist != "" || root.album != "";
        mouse-cursor: self.enabled ? pointer : default;
        clicked => {
            if root.artist != "" {
                Go.artist(root.artist);
            } else {
                Go.album(root.album);
            }
        }
    }
    if lt.has-hover && lt.enabled: Rectangle {
        x: root.horizontal-alignment == TextHorizontalAlignment.center ? (root.width - self.width) / 2 : 0;
        y: root.height / 2 + root.size * 0.55;
        width: min(root.width, root.preferred-width);
        height: 1px;
        background: root.color;
    }
}

// A song's artists as links: each name its own where the line names them one by one, else the line opens
// its one artist, or lists its several artists to choose from.
component ArtistLine inherits HorizontalLayout {
    in property <string> text;
    in property <string> artist;
    in property <Credits> credits;
    in property <brush> color;
    in property <length> font-size: 13px;
    alignment: start;
    for p in root.credits.pieces: Link {
        text: p.text;
        artist: p.id;
        color: root.color;
        font-size: root.font-size;
        vertical-alignment: center;
        overflow: elide;
        // Only names elide; what stands between them stays whole.
        min-width: p.id == "" ? self.preferred-width : 0;
    }
    if root.credits.pieces.length == 0 && root.credits.choices.length == 0: Link {
        text: root.text;
        artist: root.artist;
        color: root.color;
        font-size: root.font-size;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.credits.choices.length > 0: Text {
        text: root.text;
        color: root.color;
        font-size: root.font-size;
        vertical-alignment: center;
        overflow: elide;
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { list.show(); }
        }
        if ta.has-hover: Rectangle {
            y: parent.height / 2 + root.font-size * 0.55;
            width: min(parent.width, parent.preferred-width);
            height: 1px;
            background: root.color;
        }
        list := PopupWindow {
            x: 0;
            y: parent.height + 4px;
            width: 220px;
            close-policy: close-on-click-outside;
            Rectangle {
                border-radius: MenuShape.radius;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.hairline;
                VerticalLayout {
                    padding: MenuShape.inset;
                    for c in root.credits.choices: Rectangle {
                        height: MenuShape.row;
                        border-radius: MenuShape.inner;
                        background: ca.has-hover ? Theme.hover : transparent;
                        Text {
                            x: 10px;
                            width: parent.width - 20px;
                            text: c.text;
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        ca := TouchArea {
                            clicked => {
                                list.close();
                                Go.artist(c.id);
                            }
                        }
                    }
                }
            }
        }
    }
}

// The glyph of something drawn without one.
global NoGlyph {
    out property <Glyph> glyph;
}

// An Iconoir glyph (icons.slint) on a 24 unit square: its lines 1.5 units wide at any size, and its fill.
component Icon inherits Rectangle {
    in property <Glyph> glyph;
    in property <brush> colour: Theme.text;
    property <length> line: 1.5 * self.width / 24;
    width: 18px;
    height: 18px;
    if root.glyph.fill != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.glyph.fill;
        fill: root.colour;
        opacity: 1 - root.glyph.fade;
    }
    if root.glyph.lines != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.glyph.lines;
        stroke: root.colour;
        stroke-width: root.line;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    if root.glyph.plain != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.glyph.plain;
        stroke: root.colour;
        stroke-width: root.line;
    }
    if root.glyph.round-ends != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.glyph.round-ends;
        stroke: root.colour;
        stroke-width: root.line;
        stroke-line-cap: round;
    }
    if root.glyph.round-corners != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.glyph.round-corners;
        stroke: root.colour;
        stroke-width: root.line;
        stroke-line-join: round;
    }
}

// Every menu's pane, as Android's popover: the surface with one hairline edge, no shadow.
component Popover inherits Rectangle {
    border-radius: MenuShape.radius;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.hairline;
}

// A row of a menu: a glyph, its words, and a few more at the end.
component MenuRow inherits Rectangle {
    in property <Glyph> icon;
    in property <string> text;
    in property <string> detail;
    callback clicked;
    height: MenuShape.row;
    border-radius: MenuShape.inner;
    background: ta.has-hover ? Theme.hover : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            glyph: root.icon;
            colour: Theme.text;
            width: 18px;
            height: 18px;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.detail != "": Text {
            text: root.detail;
            color: Theme.dim;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A pane in the chrome's outline: the surface, a hairline round it, no shadow.
component Glass inherits Rectangle {
    in property <length> radius: 18px;
    border-radius: root.radius;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.outline;
}


// A borderless button: a glyph that is quiet unless lit, and a faint round plate under the pointer.
component IconButton inherits Rectangle {
    in property <Glyph> glyph;
    in property <bool> lit;
    in property <bool> quiet;
    in property <bool> enabled: true;
    opacity: root.enabled ? 1 : 0.3;
    in property <length> size: 32px;
    in property <length> icon: 20px;
    in property <color> ink: Theme.text;
    in property <color> base: transparent;
    out property <bool> hovered: touch.has-hover;
    callback clicked;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: touch.has-hover ? Theme.hover : root.base;
    Icon {
        glyph: root.glyph;
        colour: root.lit ? Theme.accent : (root.quiet ? Theme.dim : root.ink);
        width: root.icon;
        height: root.icon;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Small capitals over a list, in the quiet ink: the page's captions. Give it the words in capitals.
component Caption inherits Text {
    color: Theme.dim;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
}

// A word that does something (Clear, Undo): the ink, and a faint plate under the pointer.
component TextButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 28px;
    width: label.preferred-width + 20px;
    border-radius: self.height / 2;
    background: touch.has-hover ? Theme.hover : transparent;
    label := Text {
        text: root.text;
        color: Theme.text;
        font-size: 13px;
        font-weight: 600;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A tab of the top pill: its glyph and, when named, its name; the current one lit in the accent and bold.
component TabButton inherits Rectangle {
    in property <string> text;
    in property <Glyph> icon;
    in property <bool> current;
    in property <bool> named;
    callback clicked;
    height: 36px;
    width: row.preferred-width;
    border-radius: 18px;
    background: touch.has-hover ? Theme.hover : transparent;
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        // Favorites' seal is stamped while it is the current tab, as a liked one is.
        Icon {
            y: (parent.height - self.height) / 2;
            glyph: root.current && root.icon == Icons.seal-outline ? Icons.seal : root.icon;
            transform-rotation: root.current && root.icon == Icons.seal-outline ? -4deg : 0deg;
            colour: root.current ? Theme.accent : Theme.dim;
            width: 20px;
            height: 20px;
        }
        // As wide as the bold name, so lighting a tab moves none of the others.
        if root.named || root.current: Rectangle {
            width: bold.preferred-width;
            bold := Text {
                visible: false;
                text: root.text;
                font-weight: 700;
            }
            Text {
                text: root.text;
                color: root.current ? Theme.accent : Theme.dim;
                font-weight: root.current ? 700 : 400;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Play and pause: the bare glyph, the two cross-fading by 180 ms with a scale from .8. While
// the player waits, a spinner takes the glyph's place, but only after 300 ms.
component PlayPause inherits Rectangle {
    in property <bool> playing;
    in property <bool> waiting;
    in property <length> size: 44px;
    in property <length> icon: 26px;
    in property <color> ink: Theme.text;
    callback clicked;
    property <bool> spinning;
    property <duration> swap: Motion.reduced ? 0ms : 180ms;
    changed waiting => {
        delay.running = self.waiting;
        if !self.waiting {
            self.spinning = false;
        }
    }
    delay := Timer {
        interval: 300ms;
        running: false;
        triggered => {
            root.spinning = root.waiting;
            self.running = false;
        }
    }
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: touch.has-hover ? Theme.hover : transparent;
    Icon {
        glyph: Icons.play-solid;
        colour: root.ink;
        width: root.icon;
        height: root.icon;
        opacity: root.playing || root.spinning ? 0 : 1;
        transform-scale: root.playing || root.spinning ? 0.8 : 1;
        animate opacity, transform-scale { duration: root.swap; easing: ease-out; }
    }
    Icon {
        glyph: Icons.pause-solid;
        colour: root.ink;
        width: root.icon;
        height: root.icon;
        opacity: root.playing && !root.spinning ? 1 : 0;
        transform-scale: root.playing && !root.spinning ? 1 : 0.8;
        animate opacity, transform-scale { duration: root.swap; easing: ease-out; }
    }
    if root.spinning: Path {
        width: root.icon * 0.8;
        height: self.width;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M12 3 A9 9 0 0 1 21 12";
        stroke: root.ink;
        stroke-width: 2.4px;
        stroke-line-cap: round;
        // From the tick: an animated binding would only run on a change, and this one is made already spinning.
        transform-rotation: Motion.reduced ? 0deg : 360deg * mod(animation-tick() / 900ms, 1);
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A favorite is the seal. Not liked: its outline, upright, in the ink of the icons beside it. Liked: filled with the accent,
// tilted 4 degrees, and stamped on when it is pressed to like (it lands from half as big again on a
// firm spring); a seal that changes by itself is drawn, not stamped. Taking a like off is immediate.
component Seal inherits Rectangle {
    in property <bool> liked;
    in property <length> size: 26px;
    // The outline's ink while not liked.
    in property <color> muted: Theme.text;
    callback clicked;
    property <float> scale: 1;
    property <duration> landing: 0ms;
    width: root.size + 8px;
    height: root.size + 8px;
    border-radius: self.width / 2;
    background: touch.has-hover ? Theme.hover : transparent;
    Icon {
        glyph: root.liked ? Icons.seal : Icons.seal-outline;
        colour: root.liked ? Theme.accent : root.muted;
        width: root.size;
        height: root.size;
        transform-rotation: root.liked ? -4deg : 0deg;
        transform-scale: root.scale;
        animate transform-scale { duration: root.landing; easing: cubic-bezier(0.3, 1.9, 0.5, 1); }
    }
    // The next frame lets it settle: the scale is set to 1.5 at once, then run down to 1.
    settle := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            root.landing = 380ms;
            root.scale = 1;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if !root.liked && !Motion.reduced {
                root.landing = 0ms;
                root.scale = 1.5;
                settle.running = true;
            }
            root.clicked();
        }
    }
}

// A page as it comes on screen: a tab's root fades in; a page pushed over another (an album, a collection)
// slides in from the right, opaque. Reduced motion shows it at once.
component Fade inherits Rectangle {
    in property <bool> push;
    property <bool> shown;
    property <duration> span: Motion.reduced ? 0ms : 300ms;
    opacity: self.shown || Motion.reduced ? 1 : 0;
    x: self.shown || !self.push ? 0 : self.width * 0.3;
    background: self.push ? Theme.ground : transparent;
    animate opacity { duration: root.span * 0.8; easing: ease-out; }
    animate x { duration: root.span; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
    init => { self.shown = true; }
}

// The button a page is built around (Play): a full pill in the page's colour.
component Capsule inherits Rectangle {
    in property <string> text;
    in property <Glyph> icon;
    in property <color> ink: Theme.pill;
    in property <color> label: Theme.pill-ink;
    // Its height; the glyph, words and least width grow with it.
    in property <length> size: 28px;
    callback clicked;
    height: root.size;
    width: max(root.size * 3.6, row.preferred-width + root.size * 1.2);
    border-radius: self.height / 2;
    background: root.ink;
    opacity: touch.pressed ? 0.75 : 1;
    row := HorizontalLayout {
        alignment: center;
        spacing: 7px;
        if root.icon != NoGlyph.glyph: Icon {
            y: (parent.height - self.height) / 2;
            glyph: root.icon;
            colour: root.label;
            width: root.size * 0.38;
            height: root.size * 0.38;
        }
        Text {
            text: root.text;
            color: root.label;
            font-weight: 600;
            font-size: root.size * 0.38;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A thin bar that can be dragged: the seek bar and the volume. `value` is 0 to 1; `done` says where it was
// let go, `moved` where it is while held.
component Bar inherits Rectangle {
    in property <float> value;
    in property <duration> settling: 180ms;
    in property <bool> progress;
    property <float> previous;
    property <duration> transition: 0ms;
    init => { root.previous = root.value; }
    changed value => {
        root.transition = !Motion.reduced && (!root.progress || abs(root.value - root.previous) * root.width >= 1px) ? root.settling : 0ms;
        root.previous = root.value;
    }
    in property <length> thin: 3px;
    in property <length> thick: 5px;
    in property <color> fill: Theme.text;
    in property <color> track: Theme.chosen;
    out property <bool> hot: touch.has-hover || root.held >= 0;
    callback moved(float);
    callback done(float);
    property <float> held: -1;
    property <float> shown: root.held >= 0 ? root.held : max(0, min(1, root.value));
    animate shown { duration: root.held >= 0 ? 0ms : root.transition; easing: linear; }
    height: 12px;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.hot ? root.thick : root.thin;
        animate height { duration: Motion.reduced ? 0ms : 120ms; easing: ease-out; }
        border-radius: self.height / 2;
        background: root.track;
        clip: true;
        // Rounded as Android's: a plain rectangle is drawn without anti-aliasing, so its end would step whole pixels.
        Rectangle {
            x: 0;
            width: parent.width * root.shown;
            border-radius: parent.border-radius;
            background: root.fill;
        }
    }
    touch := TouchArea {
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.held = max(0, min(1, self.mouse-x / root.width));
                root.moved(root.held);
            }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.held >= 0 {
                root.done(root.held);
                root.held = -1;
            }
        }
        moved => {
            if self.pressed {
                root.held = max(0, min(1, self.mouse-x / root.width));
                root.moved(root.held);
            }
        }
    }
}

// Artwork: rounded, with a hairline edge so covers keep their shape on a page of their own color.
component Art inherits Rectangle {
    in property <image> source;
    border-radius: 12px;
    background: Theme.fill;
    Icon {
        glyph: Icons.music-note;
        colour: Theme.faint;
        width: parent.width * 0.34;
        height: self.width;
        visible: root.source.width == 0;
    }
    Rectangle {
        border-radius: root.border-radius;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            // Artwork fills its box; decoded dimensions do not size the layout.
            preferred-width: 0px;
            preferred-height: 0px;
            source: root.source;
            image-fit: cover;
        }
    }
    Rectangle {
        border-radius: root.border-radius;
        border-width: 1px;
        border-color: Theme.fill;
    }
}

// A dialog's pane: the page's paper, a hairline edge, and corners concentric with the buttons standing in its
// corner: their 14 px pill and the 16 px they stand in.
component MenuSheet inherits Rectangle {
    border-radius: 30px;
    background: Theme.ground;
    border-width: 1px;
    border-color: Theme.hairline;
}

// What a menu is about, at its head: its artwork (its corner concentric with the popover's), its title and a
// line under it, then a hairline.
component MenuHead inherits VerticalLayout {
    in property <image> picture;
    in property <string> title;
    in property <string> line;
    HorizontalLayout {
        height: MenuShape.head - MenuShape.inset - 1px;
        padding-bottom: MenuShape.inset;
        spacing: 10px;
        Art {
            y: 0;
            width: 40px;
            height: 40px;
            border-radius: MenuShape.inner;
            source: root.picture;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            if root.line != "": Text {
                text: root.line;
                color: Theme.dim;
                font-size: 12px;
                overflow: elide;
            }
        }
    }
    Rectangle {
        height: 1px;
        background: Theme.hairline;
    }
}

// A menu's rows, one under another on the popover itself.
component MenuGroup inherits VerticalLayout {
    @children
}

// A row of a menu: its glyph in ink, its words, and a hairline under it from where the words start.
component MenuLine inherits Rectangle {
    in property <Glyph> icon;
    in property <string> text;
    in property <bool> divider: true;
    in property <bool> enabled: true;
    // A chevron at its end: it opens more lines.
    in property <bool> opens;
    callback clicked;
    height: MenuShape.row;
    opacity: root.enabled ? 1 : 0.38;
    border-radius: MenuShape.inner;
    background: ta.has-hover && root.enabled ? Theme.hover : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        if root.icon != NoGlyph.glyph: Icon {
            y: (parent.height - self.height) / 2;
            glyph: root.icon;
            colour: Theme.text;
            width: 18px;
            height: 18px;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.opens: Icon {
            y: (parent.height - self.height) / 2;
            glyph: Icons.nav-arrow-right;
            colour: Theme.dim;
            width: 18px;
            height: 18px;
        }
    }
    if root.divider: Rectangle {
        x: root.icon != NoGlyph.glyph ? 36px : 8px;
        y: parent.height - 1px;
        width: parent.width - self.x - 8px;
        height: 1px;
        background: Theme.hairline;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// What a right press on an album, playlist, song card or mix offers, as Android's card menu: what it is at
// the head, then play it, play it next, add it to the queue, and start a jam with it while one can start. A
// guest's songs go to the host, so it has no Play.
component CollectionMenu inherits PopupWindow {
    in property <image> picture;
    in property <string> title;
    in property <string> line;
    callback play;
    callback queue(bool);
    callback jam;
    property <bool> jams: Jam.on && !Jam.hosting && !Jam.guest;
    width: MenuShape.width;
    close-policy: close-on-click-outside;
    Popover {
        VerticalLayout {
            padding: MenuShape.inset;
            MenuHead {
                picture: root.picture;
                title: root.title;
                line: root.line;
            }
            MenuGroup {
                if !Jam.guest: MenuLine {
                    icon: Icons.play;
                    text: "Play";
                    clicked => { root.play(); root.close(); }
                }
                MenuLine {
                    icon: Icons.playlist-play;
                    text: "Play next";
                    clicked => { root.queue(true); root.close(); }
                }
                MenuLine {
                    icon: Icons.playlist;
                    text: "Add to queue";
                    divider: root.jams;
                    clicked => { root.queue(false); root.close(); }
                }
                if root.jams: MenuLine {
                    icon: Icons.community;
                    text: "Start a jam";
                    divider: false;
                    clicked => { root.jam(); root.close(); }
                }
            }
        }
    }
}

// An album, artist or playlist in a grid or on a shelf: the artwork, and the title and the artist under
// it. The pointer over it brings a play button onto the artwork, as Music does.
component CardView inherits Rectangle {
    in property <Card> card;
    in property <image> picture;
    in property <bool> round;
    in property <bool> playable: !root.round;
    in property <length> side: 176px;
    callback open;
    callback play;
    // Its menu's lines: next (true) or at the end of the queue, and play it with a jam.
    callback queue(bool);
    callback jam;
    width: root.side;
    height: root.side + 46px;
    Art {
        y: 0;
        width: root.side;
        height: root.side;
        source: root.picture;
        border-radius: root.round ? self.width / 2 : 12px;
        Rectangle {
            border-radius: parent.border-radius;
            background: touch.has-hover ? Theme.ground.with-alpha(0.25) : transparent;
            animate background { duration: Motion.reduced ? 0ms : 180ms; easing: ease-out; }
        }
    }
    Text {
        y: root.side + 8px;
        width: root.side;
        text: root.card.title;
        color: Theme.text;
        font-size: 14px;
        font-weight: 500;
        overflow: elide;
        horizontal-alignment: root.round ? center : left;
    }
    // A click opens it; a right press on one that plays opens its menu where it was pressed.
    touch := TouchArea {
        clicked => { root.open(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down && root.playable {
                root.menu-x = self.mouse-x + Chrome.menu-flip(self.absolute-position.x + self.mouse-x, MenuShape.width);
                root.menu-y = self.mouse-y;
                root.menu-at = self.absolute-position.y + self.mouse-y;
                card-menu.show();
            }
        }
    }
    Link {
        y: root.side + 26px;
        width: root.side;
        text: root.card.sub;
        artist: root.card.sub-artist;
        color: Theme.dim;
        font-size: 12.5px;
        overflow: elide;
        horizontal-alignment: root.round ? center : left;
    }
    property <length> menu-x;
    property <length> menu-y;
    // Where in the window it was pressed: the menu opens there, moved up by its own height as far as it must.
    property <length> menu-at;
    card-menu := CollectionMenu {
        x: root.menu-x;
        y: root.menu-y - Chrome.menu-lift(root.menu-at, self.height);
        picture: root.picture;
        title: root.card.title;
        line: root.card.sub;
        play => { root.play(); }
        queue(next) => { root.queue(next); }
        jam => { root.jam(); }
    }
    if root.playable: Rectangle {
        x: 10px;
        y: root.side - self.height - 10px;
        opacity: touch.has-hover || play-touch.has-hover ? 1 : 0;
        transform-scale: touch.has-hover || play-touch.has-hover ? 1 : 0.8;
        animate opacity, transform-scale { duration: Motion.reduced ? 0ms : 180ms; easing: ease-out; }
        width: 34px;
        height: 34px;
        border-radius: 17px;
        background: play-touch.has-hover ? Theme.panel : Theme.ground.with-alpha(0.8);
        border-width: 1px;
        border-color: Theme.outline;
        Icon {
            x: (parent.width - self.width) / 2 + 1px;
            glyph: Icons.play-solid;
            colour: Theme.text;
            width: 14px;
            height: 14px;
        }
        play-touch := TouchArea {
            enabled: parent.opacity > 0.5;
            clicked => { root.play(); }
        }
    }
}

// A choice, as Android's chip: the chosen one raised on the surface with a hairline edge and in ink, the
// others quiet words.
component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> lit;
    callback clicked;
    height: 34px;
    width: cl.preferred-width + 28px;
    border-radius: self.height / 2;
    background: root.lit ? Theme.panel : ch.has-hover ? Theme.hover : transparent;
    border-width: root.lit ? 1px : 0;
    border-color: Theme.hairline;
    cl := Text {
        text: root.text;
        color: root.lit ? Theme.text : Theme.dim;
        font-size: 14px;
        font-weight: 500;
    }
    ch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Cards in rows filling the page width; only nearby rows keep components and images.
// Where the page shown is scrolled: `at` as it scrolls, `want` where the next page shown starts, and `asked`
// counts the pages shown, so a page view that stays (an album opened from an artist) starts again too.
export global Scroll {
    in-out property <length> at;
    in property <length> want;
    in property <int> asked;
}

// A page's scroll that Back returns to: it starts at `Scroll.want` once its content reaches that far (pages
// fill in after they open) or the user scrolls it, and keeps `Scroll.at`. Off (`remember`), it is a plain one.
component Remembered inherits Flickable {
    in property <bool> remember: true;
    property <bool> placed;
    property <int> asked: Scroll.asked;
    function place() {
        if root.remember && !root.placed && root.content-height - root.height >= Scroll.want {
            root.content-y = -Scroll.want;
            root.placed = true;
        }
    }
    init => { root.place(); }
    changed asked => {
        root.placed = false;
        root.place();
    }
    changed content-height => { root.place(); }
    changed content-y => {
        if root.remember && root.placed {
            Scroll.at = -root.content-y;
        }
    }
    flicked => {
        root.placed = true;
    }
}

component Grid inherits Remembered {
    in property <[Card]> cards;
    in property <int> rev;
    in property <bool> round;
    in property <length> pad: 32px;
    in property <length> bottom: 100px;
    // A page title above the cards, scrolling with them, and the orders it can be in as chips under it.
    in property <string> title;
    in property <[string]> orders;
    in property <int> order;
    callback ordered(int);
    property <length> head: root.title == "" ? 0 : Chrome.top-room + 56px + (root.orders.length > 0 ? 48px : 0);
    pure callback art(string, int, int) -> image;
    callback open(Card);
    callback play(Card);
    callback queue(Card, bool);
    callback jam(Card);
    property <length> gap: 22px;
    property <int> columns: max(2, floor((self.width - root.pad * 2 + root.gap) / (176px + root.gap)));
    // The cards grow a little so the rows reach both edges.
    property <length> side: (self.width - root.pad * 2 - (root.columns - 1) * root.gap) / root.columns;
    property <length> row-step: root.side + 46px + 24px;
    property <int> first: max(0, floor((-self.content-y - root.head) / root.row-step) - 1) * root.columns;
    property <int> visible-count: max(0, min(root.cards.length - root.first, (ceil(self.height / root.row-step) + 2) * root.columns));
    content-height: root.head + ceil(root.cards.length / root.columns) * root.row-step + root.bottom;
    if root.title != "": Text {
        x: root.pad;
        y: Chrome.top-room + 8px;
        text: root.title;
        color: Theme.text;
        font-family: Type.title;
        font-size: 34px;
        font-weight: 700;
        letter-spacing: -0.5px;
    }
    if root.orders.length > 0: HorizontalLayout {
        x: root.pad;
        y: Chrome.top-room + 58px;
        height: 34px;
        spacing: 8px;
        for o[i] in root.orders: Chip {
            text: o;
            lit: i == root.order;
            clicked => { root.ordered(i); }
        }
    }
    // The cards drawn. A repeater over a count makes its cards anew whenever the count is worked out
    // again, a card under a press with them; held here, they are made anew only when the count changes.
    property <int> slots;
    init => { root.slots = root.visible-count; }
    changed visible-count => { root.slots = root.visible-count; }
    for slot in root.slots: CardView {
        property <int> i: root.first + slot;
        property <Card> c: root.cards[self.i];
        x: root.pad + mod(self.i, root.columns) * (root.side + root.gap);
        y: root.head + floor(self.i / root.columns) * root.row-step;
        side: root.side;
        card: self.c;
        round: root.round;
        picture: root.art(self.c.art, 0, root.rev);
        open => { root.open(self.c); }
        play => { root.play(self.c); }
        queue(next) => { root.queue(self.c, next); }
        jam => { root.jam(self.c); }
    }
}

// A section's heading, as Android's: Inter, and with `more` a quiet arrow at the row's end; the whole heading
// then opens the section in full.
component SectionTitle inherits Rectangle {
    in property <string> text;
    in property <bool> more;
    callback clicked;
    height: 30px;
    min-width: label.min-width;
    preferred-width: label.preferred-width + (root.more ? 28px : 0);
    HorizontalLayout {
        spacing: 8px;
        label := Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.text;
            font-size: 19px;
            font-weight: 600;
            letter-spacing: -0.2px;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.more: Icon {
            y: (parent.height - self.height) / 2;
            glyph: Icons.nav-arrow-right;
            colour: Theme.dim;
            width: 20px;
            height: 20px;
        }
    }
    if root.more: TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// An artist's releases, a grid per kind; `titled` heads each, else only the kinds after the first.
component ReleaseShelves inherits VerticalLayout {
    in property <[Shelf]> shelves;
    in property <bool> titled;
    in property <int> rev;
    pure callback art(string, int, int) -> image;
    callback open(Card);
    callback play(Card);
    callback queue(Card, bool);
    callback jam(Card);
    spacing: 12px;
    for shelf[i] in root.shelves: VerticalLayout {
        spacing: 12px;
        if root.titled || i > 0: SectionTitle {
            text: shelf.title;
        }
        Grid {
            height: self.content-height;
            pad: 0;
            bottom: 0;
            interactive: false;
            remember: false;
            cards: shelf.cards;
            rev: root.rev;
            art(a, s, r) => { return root.art(a, s, r); }
            open(c) => { root.open(c); }
            play(c) => { root.play(c); }
            queue(c, next) => { root.queue(c, next); }
            jam(c) => { root.jam(c); }
        }
    }
}

// A shelf of cards that scrolls sideways, under its title, as Music's: as many whole cards as fit across
// the page (grown a little to reach both edges), paged by the arrows over its sides while the pointer is on
// it. Until its cards are read it holds its place with plates, so the page does not shift as rows arrive.
// The cards are its children, placed at `gap + i * step` and `side` wide.
component ShelfView inherits VerticalLayout {
    in property <string> title;
    in property <int> count;
    // Its title opens the whole row.
    in property <bool> more;
    callback show-all;
    in property <bool> loading;
    in property <bool> round;
    // A card's narrowest, and the height under its square (its captions).
    in property <length> least: 176px;
    in property <length> below: 46px;
    out property <length> gap: 22px;
    property <length> pad: 32px;
    property <int> columns: max(2, floor((self.width - root.pad * 2 + root.gap) / (root.least + root.gap)));
    out property <length> side: (self.width - root.pad * 2 - (root.columns - 1) * root.gap) / root.columns;
    out property <length> step: root.side + root.gap;
    out property <int> first: max(0, floor(-flick.content-x / root.step) - 1);
    out property <int> visible-count: max(0, min(root.count - root.first, ceil(root.seen / root.step) + 2));
    // Off screen, a shelf draws no cards.
    in property <bool> live: true;
    // The cards drawn, held at the count as Grid's are.
    out property <int> slots;
    function hold() { root.slots = root.live ? root.visible-count : 0; }
    init => { root.hold(); }
    changed visible-count => { root.hold(); }
    changed live => { root.hold(); }
    property <int> shown: root.loading ? root.columns : root.count;
    // The row is seen from a gap before the left margin to a gap past the right one, so the cards beside
    // the whole ones are not glimpsed; it scrolls until its last card stands at the right margin.
    property <length> inset: root.pad - root.gap;
    property <length> seen: root.width - 2 * root.inset;
    property <length> end: min(0, root.seen - (root.gap + root.shown * root.step));
    // An arrow's page moves smoothly; a scroll by hand follows the hand.
    property <bool> paging;
    function page(by: int) {
        root.paging = true;
        flick.content-x = max(root.end, min(0, flick.content-x - by * root.columns * root.step));
        settle.running = true;
    }
    spacing: 10px;
    padding-bottom: 44px;
    HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        SectionTitle {
            text: root.title;
            more: root.more && !root.loading && root.count > 0;
            clicked => { root.show-all(); }
        }
    }
    hover := TouchArea {
        height: root.side + root.below;
        flick := Flickable {
            x: root.inset;
            width: root.seen;
            content-width: root.gap + root.shown * root.step;
            animate content-x { duration: root.paging && !Motion.reduced ? 420ms : 0ms; easing: cubic-bezier(0.25, 0.8, 0.3, 1); }
            if root.loading: Rectangle {
                for i in root.columns: Rectangle {
                    x: root.gap + i * root.step;
                    width: root.side;
                    Rectangle {
                        y: 0;
                        height: root.side;
                        border-radius: root.round ? self.width / 2 : 8px;
                        background: Theme.fill;
                    }
                    Rectangle {
                        y: root.side + 12px;
                        width: root.side * 0.7;
                        x: 0;
                        height: 9px;
                        border-radius: 4.5px;
                        background: Theme.fill;
                    }
                    Rectangle {
                        y: root.side + 29px;
                        width: root.side * 0.45;
                        x: 0;
                        height: 9px;
                        border-radius: 4.5px;
                        background: Theme.hairline;
                    }
                }
            }
            Rectangle {
                visible: !root.loading;
                x: floor(flick.content-x / 1phx + 0.5) * 1phx - flick.content-x;
                @children
            }
        }
        for b[i] in [{ by: -1, glyph: Icons.nav-arrow-left }, { by: 1, glyph: Icons.nav-arrow-right }]: Rectangle {
            property <bool> shown: hover.has-hover && (b.by < 0 ? flick.content-x < 0 : flick.content-x > root.end);
            x: b.by < 0 ? root.pad - self.width / 2 : root.width - root.pad - self.width / 2;
            y: (root.side - self.height) / 2;
            width: 34px;
            height: 34px;
            border-radius: 17px;
            background: arrow.has-hover ? Theme.panel : Theme.ground.with-alpha(0.85);
            border-width: 1px;
            border-color: Theme.outline;
            opacity: self.shown ? 1 : 0;
            animate opacity { duration: Motion.reduced ? 0ms : 160ms; easing: ease-out; }
            Icon {
                glyph: b.glyph;
                colour: Theme.text;
                width: 16px;
                height: 16px;
            }
            arrow := TouchArea {
                enabled: parent.shown;
                clicked => { root.page(b.by); }
            }
        }
    }
    settle := Timer {
        interval: 450ms;
        running: false;
        triggered => {
            root.paging = false;
            self.running = false;
        }
    }
}

// A mix on "For you", as Android's: a portrait card on the season's paper dyed with the mix (the core's
// `mix_card_colours`, or its first cover's page once known), its covers a square on top running into that
// paper, its name in Literata and a line under it in the card's ink.
component PickCard inherits Rectangle {
    in property <Pick> pick;
    in property <length> side;
    in property <image> picture;
    callback open;
    callback play;
    callback queue(bool);
    width: floor(root.side / 1phx) * 1phx;
    height: floor(root.side * 206 / 150 / 1phx) * 1phx;
    border-radius: 18px;
    clip: true;
    background: root.pick.page;
    animate background { duration: Motion.reduced ? 0ms : 240ms; easing: ease-out; }
    // A new mosaic fades in over the one it replaces: `faded` runs from the last change's count to this one's.
    property <image> under;
    property <image> over;
    property <int> changes;
    init => { root.over = root.picture; }
    property <float> faded: root.changes;
    animate faded { duration: Motion.reduced ? 0ms : 240ms; easing: ease-out; }
    changed picture => {
        root.under = root.over;
        root.over = root.picture;
        root.changes += 1;
    }
    Rectangle {
        y: 0;
        height: root.width;
        background: root.pick.seed;
        animate background { duration: Motion.reduced ? 0ms : 240ms; easing: ease-out; }
        Image {
            width: root.width;
            height: root.width;
            source: root.under;
            image-fit: cover;
        }
        Image {
            width: root.width;
            height: root.width;
            source: root.over;
            image-fit: cover;
            opacity: clamp(root.faded - root.changes + 1, 0, 1);
        }
        // The covers rubbed out into the card's paper from under halfway down.
        Rectangle {
            background: @linear-gradient(180deg, root.pick.page.with-alpha(0) 45%, root.pick.page 100%);
        }
    }
    VerticalLayout {
        y: root.width;
        height: root.height - self.y;
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.pick.title;
            color: root.pick.ink;
            font-family: Type.title;
            font-size: 18px;
            font-weight: 600;
            letter-spacing: -0.3px;
            overflow: elide;
        }
        Text {
            text: root.pick.sub;
            color: root.pick.ink.with-alpha(0.7);
            font-size: 12px;
            overflow: elide;
        }
    }
    Rectangle {
        background: touch.has-hover ? root.pick.page.with-alpha(0.15) : transparent;
        animate background { duration: Motion.reduced ? 0ms : 180ms; easing: ease-out; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                root.menu-x = self.mouse-x + Chrome.menu-flip(self.absolute-position.x + self.mouse-x, MenuShape.width);
                root.menu-y = self.mouse-y;
                root.menu-at = self.absolute-position.y + self.mouse-y;
                pick-menu.show();
            }
        }
    }
    property <length> menu-x;
    property <length> menu-y;
    // Where in the window it was pressed: the menu opens there, moved up by its own height as far as it must.
    property <length> menu-at;
    pick-menu := CollectionMenu {
        x: root.menu-x;
        y: root.menu-y - Chrome.menu-lift(root.menu-at, self.height);
        picture: root.picture;
        title: root.pick.title;
        line: root.pick.sub;
        play => { root.play(); }
        queue(next) => { root.queue(next); }
    }
}



// A song in a list, as Music lists them: the number (or the small artwork), the title, the artist and
// album, and the length, over a hairline. Double click plays; a right click offers the rest.
// A song menu line's icon, by its kind (`SongGo`).
global SongIcons {
    public pure function song-icon(go: SongGo) -> Glyph {
        let kind = go.kind;
        if kind == 0 { return go.filled ? Icons.seal : Icons.seal-outline; }
        if kind == 1 { return Icons.compact-disc; }
        if kind == 2 { return Icons.user; }
        if kind == 3 { return Icons.download; }
        if kind == 4 { return Icons.antenna-signal; }
        if kind == 5 { return Icons.playlist-play; }
        if kind == 6 { return Icons.playlist; }
        if kind == 7 { return Icons.plus-circle; }
        if kind == 8 { return Icons.trash; }
        if kind == 9 { return Icons.xmark; }
        if kind == 10 { return Icons.folder-plus; }
        if kind == 11 { return Icons.sparks; }
        if kind == 12 { return Icons.prohibition; }
        if kind == 13 { return Icons.share-ios; }
        if kind == 15 { return Icons.community; }
        if kind == 16 { return Icons.emoji-sing-right-note; }
        if kind == 17 { return Icons.half-moon; }
        return Icons.info-circle;
    }
}

// A song's menu, as Android's sheet: the song at its head, then its lines (the core's `song_menu`) grouped on
// one card, those reached for less behind More, which shows them in the card's place under Back. The two
// share one cell, as tall as the longer, so the menu, placed for its height as it opens, never moves.
component SongMenuBody inherits Popover {
    in property <image> picture;
    in property <string> title;
    in property <string> line;
    in property <[SongGo]> lines;
    // Play first, where the menu is a row's.
    in property <bool> playable;
    callback play;
    callback chosen(SongGo);
    property <bool> more-shown;
    VerticalLayout {
        padding: MenuShape.inset;
        MenuHead {
            picture: root.picture;
            title: root.title;
            line: root.line;
        }
        GridLayout {
            MenuGroup {
                row: 0;
                col: 0;
                alignment: start;
                visible: !root.more-shown;
                if root.playable: MenuLine {
                    icon: Icons.play;
                    text: "Play";
                    divider: root.lines.length > 0;
                    clicked => { root.play(); }
                }
                for m[i] in root.lines: VerticalLayout {
                    if !m.more: MenuLine {
                        icon: SongIcons.song-icon(m);
                        text: m.title;
                        enabled: m.enabled;
                        divider: i < root.lines.length - 1;
                        clicked => { root.chosen(m); }
                    }
                    if m.more && (i == 0 || !root.lines[i - 1].more): MenuLine {
                        icon: Icons.more-horiz;
                        text: "More";
                        divider: false;
                        opens: true;
                        clicked => { root.more-shown = true; }
                    }
                }
            }
            MenuGroup {
                row: 0;
                col: 0;
                alignment: start;
                visible: root.more-shown;
                MenuLine {
                    icon: Icons.nav-arrow-left;
                    text: "Back";
                    clicked => { root.more-shown = false; }
                }
                for m[i] in root.lines: VerticalLayout {
                    if m.more: MenuLine {
                        icon: SongIcons.song-icon(m);
                        text: m.title;
                        enabled: m.enabled;
                        divider: i < root.lines.length - 1;
                        clicked => { root.chosen(m); }
                    }
                }
            }
        }
    }
}

component SongLine inherits Rectangle {
    in property <SongRow> song;
    in property <int> number;
    in property <bool> show-album: true;
    in property <bool> thumb;
    // A playlist's row: the artist in a column of its own, under its head.
    in property <bool> table;
    // A table's columns: what is left beside the artwork and the time, split a half, a quarter, a quarter
    // (the playlist's heads use the same sums).
    property <length> cols: root.width - 8px - 12px - 44px - 44px - 4 * 12px;
    in property <image> picture;
    // The cover at the head of its menu: the row's own, or its album's where the row shows none.
    in property <image> menu-picture: root.picture;
    callback play;
    // The menu's lines, asked for as it opens, and one of them chosen.
    callback menu() -> [SongGo];
    callback act(int, string);
    property <[SongGo]> lines;
    height: root.thumb ? 56px : 44px;
    border-radius: 7px;
    background: touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Motion.reduced ? 0ms : 140ms; easing: ease-out; }
    Rectangle {
        x: root.thumb ? 64px : 44px;
        y: parent.height - 1px;
        width: parent.width - self.x - 8px;
        height: 1px;
        background: Theme.hairline;
    }
    // A right press opens the song's menu where it was pressed, drawn as the app's own menus are.
    touch := TouchArea {
        double-clicked => { root.play(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                root.menu-x = self.mouse-x + Chrome.menu-flip(self.absolute-position.x + self.mouse-x, MenuShape.width);
                root.lines = root.menu();
                root.menu-y = self.mouse-y;
                root.menu-at = self.absolute-position.y + self.mouse-y;
                song-menu.show();
            }
        }
    }
    property <length> menu-x;
    property <length> menu-y;
    // Where in the window it was pressed: the menu opens there, moved up by its own height as far as it must.
    property <length> menu-at;
    song-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y - Chrome.menu-lift(root.menu-at, self.height);
        width: MenuShape.width;
        close-policy: close-on-click-outside;
        SongMenuBody {
            picture: root.menu-picture;
            title: root.song.title;
            line: root.song.album != "" ? root.song.artist + " · " + root.song.album : root.song.artist;
            lines: root.lines;
            playable: !Jam.guest;
            play => {
                root.play();
                song-menu.close();
            }
            // The menu closes after: closed, it can no longer reach the row.
            chosen(m) => {
                if m.kind == 1 {
                    Go.album(m.id);
                } else if m.kind == 2 {
                    Go.artist(m.id);
                } else {
                    root.act(m.kind, m.id);
                }
                song-menu.close();
            }
        }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 12px;
        spacing: 12px;
        if root.thumb: Art {
            y: (parent.height - self.height) / 2;
            width: 44px;
            height: 44px;
            border-radius: 5px;
            source: root.picture;
        }
        if !root.thumb: Rectangle {
            width: 24px;
            if root.song.playing: PlayingBars {
                x: parent.width - self.width - 2px;
                y: (parent.height - self.height) / 2;
                colour: Theme.accent;
                width: 14px;
                height: 13px;
            }
            if !root.song.playing: Text {
                width: 100%;
                text: root.number;
                color: Theme.dim;
                font-size: 13px;
                horizontal-alignment: right;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 2;
            preferred-width: 0;
            Text {
                text: root.song.title;
                color: root.song.playing ? Theme.accent : Theme.text;
                font-size: 13px;
                overflow: elide;
            }
            if (root.thumb || root.show-album) && !root.table: ArtistLine {
                text: root.song.artist;
                artist: root.song.artist-id;
                credits: root.song.credits;
                color: Theme.dim;
            }
        }
        if root.show-album && !root.table: Link {
            horizontal-stretch: 1;
            preferred-width: 0;
            text: root.song.album;
            album: root.song.album-id;
            color: Theme.dim;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        // A table's two columns stand at fixed places (the heads use the same sums), not where the layout
        // would share the width out.
        if root.table: Rectangle {
            preferred-width: 0;
            horizontal-stretch: 2;
        }
        // "Asked": a guest's request, until the host takes it.
        if root.song.by != "": Rectangle {
            y: (parent.height - self.height) / 2;
            height: 18px;
            width: bt.preferred-width + 14px;
            border-radius: 9px;
            background: Theme.chosen;
            bt := Text {
                text: root.song.by;
                color: Theme.dim;
                font-size: 10px;
                font-weight: 600;
            }
        }
        Text {
            text: root.song.time;
            color: Theme.dim;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 44px;
        }
    }
    if root.table: ArtistLine {
        x: 8px + 44px + 12px + root.cols * 0.5 + 12px;
        width: root.cols * 0.25;
        text: root.song.artist;
        artist: root.song.artist-id;
        credits: root.song.credits;
        color: Theme.dim;
        height: root.height;
    }
    if root.table: Link {
        x: 8px + 44px + 12px + root.cols * 0.75 + 24px;
        width: root.cols * 0.25;
        text: root.song.album;
        album: root.song.album-id;
        color: Theme.dim;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// The column heads over a table of SongLines: the same sums as its columns.
component SongHeads inherits Rectangle {
    property <length> cols: self.width - 8px - 12px - 44px - 44px - 4 * 12px;
    for h in [{ t: "Song", x: 0, w: 0.5, g: 0 }, { t: "Artist", x: 0.5, w: 0.25, g: 1 }, { t: "Album", x: 0.75, w: 0.25, g: 2 }]: Text {
        x: 8px + 44px + 12px + root.cols * h.x + h.g * 12px;
        width: root.cols * h.w;
        text: h.t;
        color: Theme.dim;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
    }
    Text {
        x: root.width - 12px - 44px;
        width: 44px;
        text: "Time";
        color: Theme.dim;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

component Heading inherits VerticalLayout {
    in property <string> title;
    in property <string> caption;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: Chrome.top-room + 8px;
    padding-bottom: 16px;
    spacing: 2px;
    Text {
        text: root.title;
        color: Theme.text;
        font-family: Type.title;
        font-size: 34px;
        font-weight: 700;
        letter-spacing: -0.5px;
    }
    if root.caption != "": Text {
        text: root.caption;
        color: Theme.dim;
        font-size: 13px;
    }
}

// A text field: a rounded well, a magnifier or another icon, the placeholder until something is typed.
// A page with nothing to list: its glyph in a soft disc, what is missing, and where it comes from.
component EmptyNote inherits VerticalLayout {
    in property <Glyph> icon;
    in property <string> title;
    in property <string> line;
    alignment: center;
    spacing: 8px;
    Rectangle {
        height: 72px;
        Rectangle {
            width: 72px;
            height: 72px;
            border-radius: 36px;
            background: Theme.fill;
            Icon {
                glyph: root.icon;
                colour: Theme.dim;
                width: 32px;
                height: 32px;
            }
        }
    }
    Rectangle {
        height: 6px;
    }
    Text {
        text: root.title;
        color: Theme.text;
        font-family: Type.title;
        font-size: 22px;
        font-weight: 700;
        horizontal-alignment: center;
    }
    Text {
        text: root.line;
        color: Theme.dim;
        font-size: 14px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

component Field inherits Rectangle {
    in property <string> placeholder;
    in property <Glyph> icon;
    in property <bool> secret;
    in-out property <string> text;
    callback edited(string);
    callback accepted;
    height: 34px;
    border-radius: 9px;
    background: Theme.panel;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.hairline;
    public function take-focus() {
        input.focus();
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;
        if root.icon != NoGlyph.glyph: Icon {
            y: (parent.height - self.height) / 2;
            glyph: root.icon;
            colour: Theme.dim;
            width: 15px;
            height: 15px;
        }
        Rectangle {
            input := TextInput {
                width: 100%;
                text <=> root.text;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                input-type: root.secret ? InputType.password : InputType.text;
                selection-background-color: Theme.accent.with-alpha(0.4);
                edited => { root.edited(self.text); }
                accepted => { root.accepted(); }
            }
            if root.text == "": Text {
                x: 0;
                text: root.placeholder;
                color: Theme.faint;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }
}

// The glyphs of where the sound goes, as Android draws them.
global Glyphs {
    // A nori device by its kind (`DeviceRow::kind`).
    public pure function device(kind: int) -> Glyph {
        return kind == 1 ? Icons.smartphone-device : kind == 2 ? Icons.terminal : kind == 3 ? Icons.user : Icons.computer;
    }
    // This computer's output by the core's `output_look`: 0 its own speakers, 1 headphones, 2 Bluetooth, 3 another.
    public pure function port(glyph: int) -> Glyph {
        return glyph == 1 ? Icons.headset : glyph == 2 ? Icons.bluetooth : glyph == 3 ? Icons.airplay : Icons.computer;
    }
}

// Where the sound goes (app.rs fills it): this computer's output, or the device playing while it is another.
export global Output {
    in property <bool> elsewhere;
    // `Glyphs.device`'s kind while elsewhere, else `Glyphs.port`'s.
    in property <int> glyph;
    in property <string> name;
    out property <Glyph> shown: self.elsewhere ? Glyphs.device(self.glyph) : Glyphs.port(self.glyph);
}

// The output button, as Android's: the glyph of what plays, in the full ink while another device plays,
// and with `named` the device's name beside it, both one button.
component OutputLine inherits Rectangle {
    in property <bool> named;
    in property <length> icon: 22px;
    in property <color> idle: Theme.dim;
    callback clicked;
    property <color> ink: Output.elsewhere ? Theme.text : root.idle;
    height: 44px;
    width: row.preferred-width;
    border-radius: self.height / 2;
    background: touch.has-hover ? Theme.hover : transparent;
    row := HorizontalLayout {
        padding-left: root.named ? 14px : 11px;
        padding-right: root.named ? 14px : 11px;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            glyph: Output.shown;
            colour: root.ink;
            width: root.icon;
            height: root.icon;
        }
        if root.named: Text {
            text: Output.name;
            color: root.ink;
            font-size: 15px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The player pill's content: the song on the left; shuffle, previous, play, next and repeat in the middle with the
// seek bar and both times under them; on the right the seal, the speaker (the devices; the jam in its place), lyrics,
// the queue and the volume. A narrow pill drops the volume slider, then the panel buttons.
component PlayerControls inherits Rectangle {
    in property <bool> has-song;
    in property <string> now-title;
    in property <string> now-artist;
    in property <string> now-album;
    in property <string> now-artist-id;
    in property <string> now-album-id;
    in property <Credits> now-credits;
    in property <bool> now-starred;
    in property <string> now-art;
    in property <bool> playing;
    in property <bool> buffering;
    in property <int> position-ms;
    in property <int> duration-ms;
    // A radio station or live stream plays: "Live" stands where the seek bar would.
    in property <bool> live;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <float> volume: 1;
    in property <int> inspector;
    in property <int> covers-rev;
    in property <bool> devices-on;
    // The jam this computer hosts, as the strip beside the song says it ("Jam · 2 listening"); empty for none.
    in property <string> jam;
    // "Playing on <device>" while another device plays and this player controls it; empty while it plays here.
    in property <string> playing-on;
    // A jam guest's player: it shows the jam's song; shuffle, repeat and the volume are the host's.
    in property <bool> guest;
    // What the player offers: a jam guest's by its role (an admin's skips and seeks reach the host, a
    // guest's play and pause its own listening), all of them for this computer's own.
    in property <bool> can-play: true;
    in property <bool> can-skip: true;
    in property <bool> can-seek: true;
    pure callback art(string, int, int) -> image;
    // The seal pressed.
    callback star();
    callback toggle();
    callback next();
    callback previous();
    callback seek(float);
    callback set-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback set-inspector(int);
    callback open-full();
    // The song playing's menu, which opens in the main window.
    callback open-song-menu();

    // The pill's width, which decides what it can show.
    in property <length> room;
    property <bool> wide: root.room >= 900px;
    property <bool> roomy: root.room >= 720px;
    property <int> dragged: -1;
    property <int> shown-ms: root.dragged >= 0 ? root.dragged : root.position-ms;
    // The transport sits in the middle; the song and the buttons share what is left equally.
    property <length> transport-w: clamp(root.room * 0.34, 260px, 420px);
    property <length> side-w: max(120px, (root.room - 18px - 24px - root.transport-w) / 2);

    function clock(ms: int) -> string {
        let s = floor(max(0, ms) / 1000);
        return floor(s / 60) + ":" + (mod(s, 60) < 10 ? "0" : "") + mod(s, 60);
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 12px;
        spacing: 12px;
        // The song: its cover (the player on a click), the title, and the artist and album as links.
        HorizontalLayout {
            width: root.side-w;
            spacing: 10px;
            // 6 px in from the pill on three sides, its corner the pill's less that rim.
            Art {
                y: (parent.height - self.height) / 2;
                width: 52px;
                height: 52px;
                border-radius: 14px;
                source: root.art(root.now-art, 0, root.covers-rev);
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if root.has-song {
                            root.open-full();
                        }
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: root.has-song ? root.now-title : "Not playing";
                    color: Theme.text;
                    font-weight: 600;
                    overflow: elide;
                }
                // While another device plays, its name takes the artist's place; else a jam's strip.
                if root.playing-on != "" || (root.jam != ""): HorizontalLayout {
                    spacing: 4px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        glyph: root.playing-on != "" ? Output.shown : Icons.community;
                        colour: Theme.accent;
                        width: 14px;
                        height: 14px;
                    }
                    Text {
                        text: root.playing-on != "" ? root.playing-on : root.jam;
                        color: Theme.accent;
                        font-size: 12px;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.set-inspector(root.playing-on != "" ? 3 : 1); }
                        }
                    }
                }
                if root.playing-on == "" && root.jam == "": HorizontalLayout {
                    alignment: start;
                    ArtistLine {
                        max-width: self.preferred-width;
                        // The artists before the album, which elides first.
                        horizontal-stretch: 0;
                        text: root.now-artist;
                        artist: root.now-artist-id;
                        credits: root.now-credits;
                        color: Theme.dim;
                        font-size: 12px;
                    }
                    if root.now-album != "": Text {
                        text: " · ";
                        color: Theme.dim;
                        font-size: 12px;
                    }
                    if root.now-album != "": Link {
                        horizontal-stretch: 1;
                        text: root.now-album;
                        album: root.now-album-id;
                        color: Theme.dim;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
            }
        }
        // The transport, and the seek bar with its times under it.
        VerticalLayout {
            width: root.transport-w;
            alignment: center;
            spacing: 0;
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                height: 40px;
                if !root.guest: IconButton {
                    y: (parent.height - self.height) / 2;
                    glyph: Icons.shuffle;
                    lit: root.shuffle;
                    quiet: true;
                    size: 34px;
                    clicked => { root.toggle-shuffle(); }
                }
                if root.can-skip: IconButton {
                    y: (parent.height - self.height) / 2;
                    glyph: Icons.rewind-solid;
                    size: 38px;
                    icon: 24px;
                    clicked => { root.previous(); }
                }
                if root.can-play: PlayPause {
                    y: (parent.height - self.height) / 2;
                    playing: root.playing;
                    waiting: root.buffering;
                    clicked => { root.toggle(); }
                }
                if root.can-skip: IconButton {
                    y: (parent.height - self.height) / 2;
                    glyph: Icons.forward-solid;
                    size: 38px;
                    icon: 24px;
                    clicked => { root.next(); }
                }
                if !root.guest: IconButton {
                    y: (parent.height - self.height) / 2;
                    glyph: root.repeat == 1 ? Icons.repeat-once : Icons.repeat;
                    lit: root.repeat != 0;
                    quiet: true;
                    size: 34px;
                    clicked => { root.cycle-repeat(); }
                }
            }
            if root.live: Text {
                height: 14px;
                text: "Live";
                color: Theme.accent;
                font-size: 11px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if !root.live: HorizontalLayout {
                height: 14px;
                spacing: 8px;
                Text {
                    width: 34px;
                    text: root.clock(root.shown-ms);
                    color: Theme.dim;
                    font-size: 11px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                Bar {
                    horizontal-stretch: 1;
                    y: (parent.height - self.height) / 2;
                    value: root.duration-ms > 0 ? root.shown-ms / root.duration-ms : 0;
                    progress: true;
                    settling: 250ms;
                    fill: Theme.text;
                    track: Theme.chosen;
                    moved(v) => {
                        if root.can-seek {
                            root.dragged = v * root.duration-ms;
                        }
                    }
                    done(v) => {
                        root.dragged = -1;
                        if root.can-seek {
                            root.seek(v);
                        }
                    }
                }
                Text {
                    width: 34px;
                    text: root.clock(root.duration-ms);
                    color: Theme.dim;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
        // The right, as Android's bar: where the sound goes and the seal, then lyrics, the queue, the volume.
        HorizontalLayout {
            width: root.side-w;
            alignment: end;
            spacing: 2px;
            // The device glyphs are drawn to the seal's height and line, and both at the size of the icons beside
            // them, so every line in the row is as thick.
            if root.devices-on: OutputLine {
                y: (parent.height - self.height) / 2;
                height: 34px;
                icon: 20px;
                idle: root.inspector == 3 ? Theme.accent : Theme.text.with-alpha(0.75);
                clicked => { root.set-inspector(root.inspector == 3 ? 0 : 3); }
            }
            if root.has-song && !root.guest: Seal {
                y: (parent.height - self.height) / 2;
                size: 20px;
                width: 34px;
                height: 34px;
                muted: Theme.text.with-alpha(0.75);
                liked: root.now-starred;
                clicked => { root.star(); }
            }
            if root.roomy || root.inspector == 2: IconButton {
                y: (parent.height - self.height) / 2;
                glyph: Icons.emoji-sing-right-note;
                lit: root.inspector == 2;
                size: 34px;
                clicked => { root.set-inspector(root.inspector == 2 ? 0 : 2); }
            }
            if root.roomy || root.inspector == 1: IconButton {
                y: (parent.height - self.height) / 2;
                glyph: Icons.playlist;
                lit: root.inspector == 1;
                size: 34px;
                clicked => { root.set-inspector(root.inspector == 1 ? 0 : 1); }
            }
            if root.wide && !root.guest: IconButton {
                y: (parent.height - self.height) / 2;
                glyph: root.volume <= 0 ? Icons.sound-off : (root.volume < 0.5 ? Icons.sound-low : Icons.sound-high);
                size: 34px;
                clicked => { root.set-volume(root.volume > 0 ? 0 : 1); }
            }
            if root.wide && !root.guest: Bar {
                y: (parent.height - self.height) / 2;
                width: 84px;
                value: root.volume;
                fill: Theme.text;
                track: Theme.chosen;
                moved(v) => { root.set-volume(v); }
                done(v) => { root.set-volume(v); }
            }
            if root.has-song && !root.guest: IconButton {
                y: (parent.height - self.height) / 2;
                glyph: Icons.more-horiz;
                size: 34px;
                clicked => { root.open-song-menu(); }
            }
        }
    }
}

// A small rounded button of the Mac's.
component SmallButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    height: 28px;
    width: bl.preferred-width + 24px;
    border-radius: self.height / 2;
    background: ba.pressed ? Theme.faint : (ba.has-hover ? Theme.chosen : Theme.fill);
    opacity: root.enabled ? 1 : 0.4;
    bl := Text {
        text: root.text;
        color: Theme.text;
        font-size: 13px;
    }
    ba := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A row of the devices panel: its glyph in a disc (lit in the accent for what is chosen), a title and a
// line under it; what it holds after them (an icon button) sits at its end.
component PanelRow inherits Rectangle {
    in property <Glyph> icon;
    in property <string> title;
    in property <string> line;
    in property <bool> lit;
    callback clicked;
    height: 52px;
    border-radius: 10px;
    background: rt.has-hover ? Theme.hover : transparent;
    animate background { duration: Motion.reduced ? 0ms : 140ms; easing: ease-out; }
    rt := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 10px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 34px;
            height: 34px;
            border-radius: 17px;
            background: root.lit ? Theme.chosen : Theme.fill;
            animate background { duration: Motion.reduced ? 0ms : 180ms; easing: ease-out; }
            Icon {
                glyph: root.icon;
                colour: root.lit ? Theme.accent : Theme.text;
                width: 18px;
                height: 18px;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 0;
            Text {
                text: root.title;
                color: root.lit ? Theme.accent : Theme.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            if root.line != "": Text {
                text: root.line;
                color: Theme.dim;
                font-size: 11px;
                overflow: elide;
            }
        }
        @children
    }
}

// A hairline between the panel's groups.
component PanelRule inherits Rectangle {
    height: 13px;
    Rectangle {
        x: 6px;
        width: parent.width - 12px;
        height: 1px;
        background: Theme.hairline;
    }
}

// Where the music plays (remote control), as Music's AirPlay list and Spotify's devices: this computer
// first, then the account's other devices with what each plays, the one playing ticked. A click moves the
// music there; this player then shows and controls it. Under them pairing, then the jam.
component DevicesView inherits Rectangle {
    in property <[DeviceRow]> devices;
    in property <string> pairing-link;
    callback forget-devices();
    callback pick(string);
    // The jam's row was clicked while it is on: the queue panel shows it.
    callback open-jam();
    callback join-jam();
    callback show-pairing();
    Flickable {
        VerticalLayout {
            alignment: start;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 2px;
            HorizontalLayout {
                padding-left: 6px;
                height: 34px;
                Text {
                    text: "Play on";
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 700;
                }
            }
            for d in root.devices: VerticalLayout {
                PanelRow {
                    icon: Glyphs.device(d.kind);
                    title: d.name;
                    line: d.line;
                    lit: d.active;
                    clicked => { root.pick(d.id); }
                    if d.active: Icon {
                        y: (parent.height - self.height) / 2;
                        glyph: Icons.check;
                        colour: Theme.accent;
                        width: 16px;
                        height: 16px;
                    }
                }
                if d.note != "": HorizontalLayout {
                    padding-left: 50px;
                    padding-right: 6px;
                    Text {
                        text: d.note;
                        color: Theme.danger;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }
            // Pairing another device on this network: its code, a code from it, and forgetting them all.
            if root.pairing-link != "": PanelRule {}
            if root.pairing-link != "": PanelRow {
                icon: Icons.smartphone-device;
                title: "Pair a device";
                line: "Show a code to scan or copy";
                clicked => { root.show-pairing(); }
            }
            if root.pairing-link != "": PanelRow {
                icon: Icons.trash;
                title: "Forget paired devices";
                line: "They pair again with a new code";
                clicked => { root.forget-devices(); }
            }
            // The jam: starting one, or the one on (its row opens it in the queue panel) and ending it.
            if Jam.on || Jam.hosting || Jam.note != "": PanelRule {}
            if Jam.note != "": Text {
                text: Jam.note;
                color: Theme.dim;
                font-size: 12px;
                wrap: word-wrap;
            }
            if Jam.on || Jam.hosting: PanelRow {
                icon: Icons.community;
                title: Jam.hosting ? "Your Jam" : "Start a jam";
                line: Jam.hosting ? Jam.strip : "Others join with a link and ask for songs";
                lit: Jam.hosting;
                clicked => {
                    if Jam.hosting {
                        root.open-jam();
                    } else {
                        Jam.start();
                    }
                }
                if Jam.hosting: IconButton {
                    y: (parent.height - self.height) / 2;
                    glyph: Icons.log-out;
                    size: 30px;
                    icon: 16px;
                    ink: Theme.danger;
                    clicked => { Jam.end(); }
                }
            }
            // Someone else's jam, joined with their invite link.
            if !Jam.guest: PanelRow {
                icon: Icons.plus;
                title: "Join a Jam…";
                line: root.pairing-link != "" ? "With an invite link or a pairing code" : "With the invite link someone sent you";
                clicked => { root.join-jam(); }
            }
        }
    }
}

// A round button in a panel's row: a quiet grey one, or the accent's for the yes.
component RoundButton inherits Rectangle {
    in property <Glyph> glyph;
    in property <bool> lit;
    callback clicked;
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background: root.lit ? Theme.pill : (rt.has-hover ? Theme.chosen : Theme.fill);
    animate background { duration: Motion.reduced ? 0ms : 140ms; easing: ease-out; }
    Icon {
        glyph: root.glyph;
        colour: root.lit ? Theme.pill-ink : Theme.text;
        width: 13px;
        height: 13px;
        transform-scale: rt.pressed ? 0.85 : 1;
        animate transform-scale { duration: Motion.reduced ? 0ms : 220ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    }
    rt := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A switch in the Mac's own manner.
component Toggle inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Theme.on : Theme.chosen;
    opacity: root.enabled ? 1 : 0.4;
    animate background { duration: Motion.reduced ? 0ms : 160ms; easing: ease-out; }
    Rectangle {
        x: root.on ? parent.width - self.width - 2px : 2px;
        animate x { duration: Motion.reduced ? 0ms : 180ms; easing: cubic-bezier(0.3, 1.2, 0.6, 1); }
        y: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.on ? Theme.on-on : Theme.faint;
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { root.toggled(!root.on); }
    }
}

// A person's initial in a circle, coloured by their place in the jam.
component Avatar inherits Rectangle {
    in property <string> initial;
    in property <int> place;
    in property <length> side: 24px;
    width: root.side;
    height: root.side;
    border-radius: root.side / 2;
    background: Theme.chosen;
    border-width: 1.5px;
    border-color: Theme.panel;
    Text {
        text: root.initial;
        color: Theme.text;
        font-size: root.side * 0.46;
        font-weight: 700;
    }
}


// The jam over the queue, as Music's SharePlay and Spotify's Jam put it: who listens (their avatars and how
// many), the invite (a QR code and the link, in a popover), ending it, and the songs asked for, each to
// accept or refuse.
component JamHeader inherits VerticalLayout {
    in property <int> covers-rev;
    pure callback art(string, int, int) -> image;
    spacing: 0;
    padding-bottom: 12px;
    HorizontalLayout {
        height: 30px;
        spacing: 8px;
        padding-left: 4px;
        Icon {
            y: (parent.height - self.height) / 2;
            glyph: Icons.community;
            colour: Theme.dim;
            width: 20px;
            height: 20px;
        }
        Text {
            horizontal-stretch: 1;
            text: Jam.guest ? Jam.host + "’s Jam" : "Jam";
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        // A guest plays the jam here or only watches it, where the host has Invite.
        if Jam.guest: Rectangle {
            y: (parent.height - self.height) / 2;
            height: 26px;
            width: hl.preferred-width + 34px;
            border-radius: 13px;
            background: ha.has-hover ? Theme.chosen : Theme.fill;
            animate background { duration: Motion.reduced ? 0ms : 140ms; easing: ease-out; }
            HorizontalLayout {
                alignment: center;
                spacing: 5px;
                Icon {
                    y: (parent.height - self.height) / 2;
                    glyph: Icons.sound-high-solid;
                    colour: Jam.here ? Theme.accent : Theme.text;
                    width: 13px;
                    height: 13px;
                }
                hl := Text {
                    text: Jam.here ? "Playing here" : "Listen here";
                    color: Jam.here ? Theme.accent : Theme.text;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            ha := TouchArea {
                clicked => { Jam.listen(!Jam.here); }
            }
        }
        if !Jam.guest: Rectangle {
            y: (parent.height - self.height) / 2;
            height: 26px;
            width: il.preferred-width + 34px;
            border-radius: 13px;
            background: ia.has-hover ? Theme.pill.with-alpha(0.85) : Theme.pill;
            HorizontalLayout {
                alignment: center;
                spacing: 5px;
                Icon {
                    y: (parent.height - self.height) / 2;
                    glyph: Icons.plus;
                    colour: Theme.pill-ink;
                    width: 11px;
                    height: 11px;
                }
                il := Text {
                    text: "Invite";
                    color: Theme.pill-ink;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            ia := TouchArea {
                clicked => { invite.show(); }
            }
        }
        if !Jam.guest: IconButton {
            y: (parent.height - self.height) / 2;
            glyph: Icons.settings;
            size: 28px;
            icon: 16px;
            ink: Theme.plate-ink;
            base: Theme.plate;
            clicked => { people.show(); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            glyph: Icons.log-out;
            size: 28px;
            icon: 16px;
            ink: Theme.danger;
            base: Theme.plate;
            clicked => {
                if Jam.guest {
                    Jam.leave();
                } else {
                    Jam.end();
                }
            }
        }
    }
    if Jam.along-note != "": Text {
        text: Jam.along-note;
        color: Theme.dim;
        font-size: 11px;
        wrap: word-wrap;
        x: 4px;
    }
    // Who listens: their avatars overlapping and how many; the people popover on a click.
    HorizontalLayout {
        height: 34px;
        spacing: 8px;
        padding-left: 4px;
        Rectangle {
            width: Jam.people.length == 0 ? 0 : min(Jam.people.length, 5) * 17px + 7px;
            for p[i] in Jam.people: Avatar {
                visible: i < 5;
                x: i * 17px;
                y: (parent.height - self.height) / 2;
                initial: p.initial;
                place: i;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { people.show(); }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: Jam.listening;
            color: pa.has-hover ? Theme.text : Theme.dim;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            pa := TouchArea {
                mouse-cursor: pointer;
                clicked => { people.show(); }
            }
        }
    }
    if Jam.asks.length > 0: Text {
        text: Jam.guest ? "You asked for" : "Asked for";
        color: Theme.dim;
        font-size: 12px;
        font-weight: 600;
        height: 26px;
        vertical-alignment: bottom;
        x: 4px;
    }
    for a in Jam.asks: Rectangle {
        height: a.note != "" ? 62px : 50px;
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 2px;
            spacing: 8px;
            Art {
                y: (parent.height - self.height) / 2;
                width: 34px;
                height: 34px;
                border-radius: 4px;
                source: root.art(a.art, 0, root.covers-rev);
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                min-width: 0;
                padding-left: 2px;
                Text {
                    text: a.title;
                    color: Theme.text;
                    font-size: 13px;
                    overflow: elide;
                }
                Text {
                    text: a.line;
                    color: Theme.dim;
                    font-size: 11px;
                    overflow: elide;
                }
                if a.note != "": Text {
                    text: a.note;
                    color: Theme.faint;
                    font-size: 10px;
                    overflow: elide;
                }
            }
            if Jam.guest: Rectangle {
                y: (parent.height - self.height) / 2;
                height: 18px;
                width: at.preferred-width + 14px;
                border-radius: 9px;
                background: Theme.fill;
                at := Text {
                    text: "Asked";
                    color: Theme.dim;
                    font-size: 10px;
                    font-weight: 600;
                }
            }
            if !Jam.guest: RoundButton {
                y: (parent.height - self.height) / 2;
                glyph: Icons.xmark;
                clicked => { Jam.decide(a.request, false); }
            }
            if !Jam.guest: RoundButton {
                y: (parent.height - self.height) / 2;
                glyph: Icons.check;
                lit: true;
                clicked => { Jam.decide(a.request, true); }
            }
        }
        Rectangle {
            x: 48px;
            y: parent.height - 1px;
            width: parent.width - 52px;
            height: 1px;
            background: Theme.hairline;
        }
    }

    invite := PopupWindow {
        x: 0;
        y: 34px;
        width: root.width;
        close-policy: close-on-click-outside;
        Popover {
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                Text {
                    text: "Invite to your Jam";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 184px;
                        height: 184px;
                        border-radius: 14px;
                        background: white;
                        Image {
                            width: 160px;
                            height: 160px;
                            source: Jam.qr;
                            image-rendering: pixelated;
                        }
                    }
                }
                Text {
                    text: "Others join by scanning this code with nori, or by opening the link.";
                    color: Theme.dim;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                if Jam.reach != "": Text {
                    text: Jam.reach;
                    color: Theme.dim;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                Rectangle {
                    height: 28px;
                    border-radius: 7px;
                    background: Theme.hover;
                    border-width: 1px;
                    border-color: Theme.fill;
                    Text {
                        x: 9px;
                        width: parent.width - 18px;
                        text: Jam.link;
                        color: Theme.dim;
                        font-size: 11px;
                        overflow: elide;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    Capsule {
                        text: "Copy link";
                        icon: Icons.copy;
                        clicked => {
                            Jam.copy-link();
                            invite.close();
                        }
                    }
                }
            }
        }
    }

    people := PopupWindow {
        x: 0;
        y: 64px;
        width: root.width;
        close-policy: close-on-click-outside;
        Popover {
            VerticalLayout {
                padding: MenuShape.inset;
                spacing: 0;
                if !Jam.guest: HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 6px;
                    padding-bottom: 6px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: "Let guests listen along";
                            color: Theme.text;
                            font-size: 13px;
                        }
                        Text {
                            text: "They hear the music on their own phones, in step with this computer.";
                            color: Theme.dim;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                    Toggle {
                        y: (parent.height - self.height) / 2;
                        on: Jam.along;
                        toggled(v) => { Jam.set-along(v); }
                    }
                }
                if !Jam.guest: HorizontalLayout {
                    padding: 8px;
                    spacing: 10px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text { text: "Allow remote songs"; color: Theme.text; font-size: 13px; }
                        Text { text: "Guests can request songs from external providers."; color: Theme.dim; font-size: 11px; wrap: word-wrap; }
                    }
                    Toggle { on: Jam.remote-songs; toggled(v) => { Jam.set-remote-songs(v); } }
                }
                Text {
                    text: "People";
                    color: Theme.dim;
                    font-size: 12px;
                    font-weight: 600;
                    height: 26px;
                    vertical-alignment: center;
                    x: 8px;
                }
                if Jam.people.length == 0: Text {
                    text: "No one has joined yet. Invite people with the link or the code.";
                    color: Theme.dim;
                    font-size: 12px;
                    wrap: word-wrap;
                    x: 8px;
                }
                for p[i] in Jam.people: Rectangle {
                    height: 44px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 6px;
                        spacing: 10px;
                        Avatar {
                            y: (parent.height - self.height) / 2;
                            side: 28px;
                            initial: p.initial;
                            place: i;
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            min-width: 0;
                            Text {
                                text: p.name;
                                color: Theme.text;
                                font-size: 13px;
                                overflow: elide;
                            }
                            Text {
                                text: p.role;
                                color: Theme.dim;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                        // An admin's key is lit; a click makes them a guest again, or an admin.
                        if !Jam.guest: RoundButton {
                            y: (parent.height - self.height) / 2;
                            glyph: Icons.key;
                            lit: p.admin;
                            clicked => { Jam.promote(p.id, !p.admin); }
                        }
                        if !Jam.guest: RoundButton {
                            y: (parent.height - self.height) / 2;
                            glyph: Icons.xmark;
                            clicked => { Jam.send-out(p.id); }
                        }
                    }
                }
            }
        }
    }
}

// What plays next: "Playing next" with where the songs come from and Clear, Autoplay and AutoMix as lit
// glyphs, the songs with their artwork, and Autoplay's promise at the end.
// The panels beside the song: with remote control on, the other devices; lyrics; the queue. The one showing
// is lit. In the order of the player pill's buttons for them.
component PanelTabs inherits HorizontalLayout {
    in property <int> current;
    in property <bool> devices;
    callback picked(int);
    spacing: 2px;
    if root.devices: TabButton {
        text: "Devices";
        icon: Output.shown;
        named: true;
        current: root.current == 3;
        clicked => { root.picked(3); }
    }
    TabButton {
        text: "Lyrics";
        icon: Icons.emoji-sing-right-note;
        named: true;
        current: root.current == 2;
        clicked => { root.picked(2); }
    }
    TabButton {
        text: "Queue";
        icon: Icons.playlist;
        named: true;
        current: root.current == 1;
        clicked => { root.picked(1); }
    }
}

component QueueView inherits Rectangle {
    // Every song in play order: those played (dimmed, under "History", seen by scrolling up), the one playing,
    // then "Playing next" and the rest, as Android's queue.
    in property <[SongRow]> queue;
    in property <string> from;
    in property <int> covers-rev;
    // Its songs can be taken out, moved and cleared (here or on the device playing).
    in property <bool> editable: true;
    // Rows move up and down: the list plays in its order (not shuffled).
    in property <bool> movable;
    // "Removed “Song”" for a few seconds after a song is taken out, with Undo beside it.
    in property <string> undo-text;
    pure callback art(string, int, int) -> image;
    callback jump(int);
    callback clear;
    // A row's song taken out, by its list index.
    callback remove(int);
    // The song at a list index moved to another's.
    callback move(int, int);
    callback undo;
    // The list was scrolled by hand: it stays where it was put until the panel opens again.
    property <bool> browsed;
    // A song being dragged to another place: its row (-1: none), how far it has moved, and the row it would
    // land on (rows of 54 px; only among the songs still to come).
    property <int> drag-from: -1;
    property <length> drag-dy;
    property <length> drag-start;
    property <bool> dragging: false;
    // Let go: the held row glides into its slot (dropping), then the move is sent and every row is drawn
    // at its new place at once (landing), so nothing slides back first.
    property <bool> dropping;
    property <bool> landing;
    Timer {
        interval: Motion.reduced ? 1ms : 120ms;
        running: root.dropping;
        triggered => {
            root.dropping = false;
            root.landing = true;
            root.move(root.queue[root.drag-from].index, root.queue[root.drag-to].index);
            root.drag-from = -1;
            root.drag-dy = 0;
        }
    }
    Timer {
        interval: 16ms;
        running: root.landing;
        triggered => { root.landing = false; }
    }
    // The row of the song playing: songs land after it.
    property <int> playing-row: -1;
    property <int> drag-to: root.drag-from < 0 ? -1 : max(root.playing-row + 1, min(root.queue.length - 1, root.drag-from + round(root.drag-dy / 54px)));
    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 0;
        if Jam.hosting || Jam.guest: JamHeader {
            vertical-stretch: 0;
            covers-rev: root.covers-rev;
            art(a, s, r) => { return root.art(a, s, r); }
        }
        if root.from != "" || (root.editable && root.queue.length > 0): HorizontalLayout {
            vertical-stretch: 0;
            padding-left: 8px;
            padding-bottom: 4px;
            Text {
                horizontal-stretch: 1;
                text: root.from != "" ? "From " + root.from : "";
                color: Theme.dim;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.editable && root.queue.length > 0: TextButton {
                y: (parent.height - self.height) / 2;
                text: "Clear";
                clicked => { root.clear(); }
            }
        }
        queue-scroll := Flickable {
            // A mouse's press and drag moves a song; the wheel and touch still scroll.
            mouse-drag-pan-enabled: false;
            width: root.width - 24px;
            content-width: self.width;
            vertical-stretch: 1;
            content-height: rows.preferred-height;
            flicked => { root.browsed = true; }
            rows := VerticalLayout {
            width: parent.width;
            alignment: start;
            padding-bottom: 60px;
            for s[i] in root.queue: qrow := Rectangle {
                width: parent.width;
                property <length> top: self.y + rows.y + queue-scroll.content-y;
                property <bool> on-screen: self.top + self.height > -100px && self.top < queue-scroll.height + 100px;
                // A row put in opens from nothing; one leaving folds away (app.rs takes it out after).
                property <bool> opened: !s.fresh;
                // Its buttons show while the pointer is over the row.
                property <bool> hot: qt.has-hover || up.hovered || dn.hovered || rm.hovered;
                // A caption over the first song played, and over the first after the one playing.
                property <string> caption: i == 0 && s.played ? "HISTORY" : i > 0 && root.queue[i - 1].playing ? "PLAYING NEXT" : "";
                property <length> caption-h: self.caption == "" ? 0 : 34px;
                height: s.leaving || !self.opened ? 0 : self.caption-h + 54px;
                opacity: s.leaving || !self.opened ? 0 : 1;
                animate height, opacity { duration: Motion.reduced ? 0ms : 180ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
                clip: s.leaving || !self.opened;
                z: i == root.drag-from ? 1 : 0;
                property <bool> is-playing: s.playing;
                changed is-playing => {
                    if self.is-playing {
                        root.playing-row = i;
                    }
                }
                // Where a drag puts this row: the dragged one under the pointer, those it passes a row aside.
                property <length> shift: i == root.drag-from ? root.drag-dy
                    : root.drag-from >= 0 && i > root.drag-from && i <= root.drag-to ? -54px
                    : root.drag-from >= 0 && i < root.drag-from && i >= root.drag-to ? 54px : 0;
                Timer {
                    interval: 16ms;
                    running: !parent.opened;
                    triggered => { parent.opened = true; }
                }
                // The song playing is the list's first row: when it opens, and when the next one takes over.
                function follow() {
                    if s.playing && !root.browsed {
                        queue-scroll.content-y = -max(0px, min(self.y + self.caption-h, queue-scroll.content-height - queue-scroll.height));
                    }
                }
                init => {
                    self.follow();
                    if s.playing {
                        root.playing-row = i;
                    }
                }
                changed y => { self.follow(); }
                if qrow.caption != "": Caption {
                    x: 8px;
                    y: 10px;
                    height: 20px;
                    text: qrow.caption;
                    vertical-alignment: center;
                }
                Rectangle {
                    y: qrow.caption-h + qrow.shift;
                    animate y { duration: (i == root.drag-from && root.dragging) || root.landing || Motion.reduced ? 0ms : i == root.drag-from ? 120ms : 160ms; easing: ease-out; }
                    height: 54px;
                    // Concentric with the cover: its 8 px corner and the 7 px around it.
                    border-radius: 15px;
                    background: i == root.drag-from && (root.dragging || root.dropping) ? Theme.chosen : qt.has-hover ? Theme.hover : transparent;
                    // Already played: quieter.
                    opacity: s.played ? 0.45 : 1;
                    // The row's content inside it, so the row stays hovered over its links and buttons.
                    // A song still to come is dragged to another place: pressed, it follows the pointer once it
                    // has moved a few pixels, and lands on the row it is let go over.
                    qt := TouchArea {
                        double-clicked => { root.jump(s.index); }
                        pointer-event(e) => {
                            if e.button != PointerEventButton.left {
                                return;
                            }
                            if e.kind == PointerEventKind.down && root.editable && root.movable && !root.dropping && !s.played && !s.playing {
                                root.drag-from = i;
                                root.drag-dy = 0;
                                root.dragging = false;
                                root.drag-start = self.absolute-position.y + self.mouse-y;
                            }
                            if e.kind == PointerEventKind.up && root.drag-from == i {
                                if root.dragging && root.drag-to != i {
                                    root.drag-dy = (root.drag-to - i) * 54px;
                                    root.dragging = false;
                                    root.dropping = true;
                                } else {
                                    root.drag-from = -1;
                                    root.dragging = false;
                                    root.drag-dy = 0;
                                }
                            }
                        }
                        moved => {
                            if root.drag-from == i {
                                root.drag-dy = self.absolute-position.y + self.mouse-y - root.drag-start;
                                if abs(root.drag-dy) > 4px {
                                    root.dragging = true;
                                }
                            }
                        }
                    HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 4px;
                        spacing: 12px;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 40px;
                            height: 40px;
                            Art {
                                width: 100%;
                                height: 100%;
                                border-radius: 8px;
                                source: qrow.on-screen ? root.art(s.art, 0, root.covers-rev) : root.art("", 0, 0);
                            }
                            // The song playing: its cover darkened under the playing glyph.
                            if s.playing: Rectangle {
                                border-radius: 8px;
                                background: #00000066;
                                PlayingBars {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colour: white;
                                    width: 17px;
                                    height: 16px;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: s.title;
                                color: s.playing ? Theme.accent : Theme.text;
                                font-size: 14px;
                                font-weight: s.playing ? 600 : 400;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                alignment: start;
                                ArtistLine {
                                    max-width: self.preferred-width;
                                    // The artists before the album, which elides first.
                                    horizontal-stretch: 0;
                                    text: s.artist;
                                    artist: s.artist-id;
                                    credits: s.credits;
                                    color: Theme.dim;
                                    font-size: 12px;
                                }
                                if s.album != "": Text {
                                    text: " — ";
                                    color: Theme.dim;
                                    font-size: 12px;
                                }
                                if s.album != "": Link {
                                    horizontal-stretch: 1;
                                    text: s.album;
                                    album: s.album-id;
                                    color: Theme.dim;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                        }
                        // Who asked for it in the jam.
                        if s.by != "": Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 18px;
                            width: min(bt.preferred-width, 72px) + 14px;
                            border-radius: 9px;
                            background: Theme.chosen;
                            bt := Text {
                                width: min(self.preferred-width, 72px);
                                text: s.by;
                                color: Theme.dim;
                                font-size: 10px;
                                font-weight: 600;
                                overflow: elide;
                            }
                        }
                        // Up and down for the songs still to come, and out, while hovered.
                        edit := Rectangle {
                            property <bool> to-come: !s.played && !s.playing;
                            width: root.editable && qrow.hot ? (root.movable && self.to-come ? 78px : 26px) : 0;
                            clip: true;
                            animate width { duration: Motion.reduced ? 0ms : 160ms; easing: ease-out; }
                            HorizontalLayout {
                                alignment: end;
                                up := IconButton {
                                    y: (parent.height - self.height) / 2;
                                    visible: root.movable && edit.to-come;
                                    glyph: Icons.nav-arrow-up;
                                    size: 26px;
                                    icon: 14px;
                                    quiet: i == 0 || root.queue[i - 1].playing;
                                    clicked => {
                                        if i > 0 && !root.queue[i - 1].playing {
                                            root.move(s.index, root.queue[i - 1].index);
                                        }
                                    }
                                }
                                dn := IconButton {
                                    y: (parent.height - self.height) / 2;
                                    visible: root.movable && edit.to-come;
                                    glyph: Icons.nav-arrow-down;
                                    size: 26px;
                                    icon: 14px;
                                    quiet: i == root.queue.length - 1;
                                    clicked => {
                                        if i < root.queue.length - 1 {
                                            root.move(s.index, root.queue[i + 1].index);
                                        }
                                    }
                                }
                                rm := IconButton {
                                    y: (parent.height - self.height) / 2;
                                    glyph: Icons.xmark;
                                    size: 26px;
                                    icon: 13px;
                                    clicked => { root.remove(s.index); }
                                }
                            }
                        }
                    }
                    }
                }
            }
            }
        }
    }
    // The undo of a song taken out, as a pill over the foot of the list.
    if root.undo-text != "": Rectangle {
        x: 12px + (parent.width - 24px - self.width) / 2;
        y: parent.height - self.height - 12px;
        width: min(parent.width - 24px, ut.preferred-width + ua.preferred-width + 40px);
        height: 34px;
        border-radius: 17px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.outline;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 12px;
            ut := Text {
                horizontal-stretch: 1;
                text: root.undo-text;
                color: Theme.text;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            ua := Text {
                text: "Undo";
                color: Theme.accent;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.undo(); }
                }
            }
        }
    }
}

// A menu of choices: the one chosen and a chevron; a click opens the list under it.
component Chooser inherits Rectangle {
    in property <[string]> options;
    in property <int> chosen;
    in property <bool> enabled: true;
    callback picked(int);
    // As Android's choice row: the value quiet, a chevron, and the choices in a popover, the one chosen checked.
    width: row.preferred-width;
    height: 32px;
    border-radius: 16px;
    background: ca.has-hover ? Theme.hover : transparent;
    opacity: root.enabled ? 1 : 0.4;
    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 4px;
        Text {
            text: root.chosen >= 0 && root.chosen < root.options.length ? root.options[root.chosen] : "—";
            color: Theme.dim;
            font-size: 13.5px;
            vertical-alignment: center;
        }
        Icon {
            y: (parent.height - self.height) / 2;
            glyph: Icons.nav-arrow-right;
            colour: Theme.dim;
            width: 20px;
            height: 20px;
        }
    }
    ca := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { menu.show(); }
    }
    menu := PopupWindow {
        x: root.width - self.width;
        y: root.height + 4px;
        width: 240px;
        close-policy: close-on-click-outside;
        Popover {
            VerticalLayout {
                padding: MenuShape.inset;
                for o[i] in root.options: Rectangle {
                    height: MenuShape.row;
                    border-radius: MenuShape.inner;
                    background: oa.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 10px;
                        Text {
                            horizontal-stretch: 1;
                            text: o;
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if i == root.chosen: Icon {
                            y: (parent.height - self.height) / 2;
                            glyph: Icons.check;
                            colour: Theme.dim;
                            width: 18px;
                            height: 18px;
                        }
                    }
                    oa := TouchArea {
                        clicked => {
                            root.picked(i);
                            menu.close();
                        }
                    }
                }
            }
        }
    }
}

// The four seasons as tiles, as Android's: each its season's paper with its kanji in its accent and its name
// under it, the one worn ringed in that accent. `options` names them; `picked` reports the tile's index,
// spring first.
component SeasonTiles inherits VerticalLayout {
    in property <[string]> options;
    in property <int> chosen;
    in property <length> tile-height: 72px;
    callback picked(int);
    HorizontalLayout {
        spacing: 10px;
        for o[i] in root.options: VerticalLayout {
            spacing: 6px;
            Rectangle {
                height: root.tile-height;
                border-radius: 18px;
                background: Theme.season-pages[i];
                border-width: i == root.chosen ? 2px : 1px;
                border-color: i == root.chosen ? Theme.season-accents[i] : Theme.hairline;
                Icon {
                    glyph: Icons.seasons[i];
                    colour: Theme.season-accents[i];
                    width: 32px;
                    height: 32px;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.picked(i); }
                }
            }
            Text {
                text: o;
                color: i == root.chosen ? Theme.text : Theme.dim;
                font-size: 12px;
                font-weight: 500;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }
}

// A row's part of its group's card, as Android's: the surface with a hairline edge round the whole group,
// the card's corners where the group starts and ends.
component Plate inherits Rectangle {
    in property <bool> first;
    in property <bool> last;
    in property <color> ground: Theme.panel;
    clip: true;
    Rectangle {
        y: root.first ? 0 : -20px;
        height: root.height + (root.first ? 0 : 20px) + (root.last ? 0 : 20px);
        border-radius: 18px;
        background: root.ground;
        border-width: 1px;
        border-color: Theme.hairline;
    }
}

// One row of the settings page, of whichever kind.
// The storage bar's colors, one per kind of thing stored: shades of the page's ink, as Android's, the biggest strongest.
global UsageColors {
    public pure function of(i: int) -> color {
        return i < Theme.usage-accents.length ? Theme.usage-accents[i] : Theme.dim;
    }
}

// The lyrics service held by its handle and dragged to another rank: which (empty: none), where its
// middle stood and how tall it is, how far it has moved, and how many places it has passed (down +).
global RankDrag {
    in-out property <string> held;
    in-out property <int> from;
    in-out property <length> mid;
    in-out property <length> tall;
    in-out property <length> dy;
    in-out property <int> by;
    // Let go: every row is drawn at its new place at once.
    in-out property <bool> landing;
}

// A lyrics service among the ranked ones: its switch, its key behind a button where it takes one, and a
// handle that drags it to another rank. The rows it passes step out of its way, whatever their heights.
component SourceLine inherits Rectangle {
    in property <SettingRow> item;
    callback source(string, bool);
    callback ask-key(string, string, bool);
    callback placed(string, int);
    property <bool> held: RankDrag.held == root.item.name;
    // Its middle where it is laid out, and whether the one held has gone past it.
    property <length> mid: self.absolute-position.y + self.height / 2;
    property <bool> passed-down: RankDrag.held != "" && !root.held && RankDrag.from < root.item.chosen && RankDrag.mid + RankDrag.dy > root.mid;
    property <bool> passed-up: RankDrag.held != "" && !root.held && RankDrag.from > root.item.chosen && RankDrag.mid + RankDrag.dy < root.mid;
    changed passed-down => { RankDrag.by += root.passed-down ? 1 : -1; }
    changed passed-up => { RankDrag.by += root.passed-up ? -1 : 1; }
    min-height: line.preferred-height;
    z: root.held ? 1 : 0;
    plate := Rectangle {
        y: root.held ? RankDrag.dy : root.passed-down ? -RankDrag.tall : root.passed-up ? RankDrag.tall : 0;
        animate y { duration: root.held || RankDrag.landing || Motion.reduced ? 0ms : 160ms; easing: ease-out; }
        height: root.height;
        background: root.held ? Theme.chosen : Theme.panel;
        border-top-left-radius: root.item.first || root.held ? 18px : 0;
        border-top-right-radius: root.item.first || root.held ? 18px : 0;
        border-bottom-left-radius: root.item.last || root.held ? 18px : 0;
        border-bottom-right-radius: root.item.last || root.held ? 18px : 0;
        line := HorizontalLayout {
            padding-left: 16px;
            padding-right: 6px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: root.item.title;
                    color: Theme.text;
                    opacity: root.item.enabled ? 1 : 0.45;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                Text {
                    text: root.item.detail;
                    color: Theme.dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
            if root.item.button != "": SmallButton {
                y: (parent.height - self.height) / 2;
                text: root.item.button;
                // A key kept shows as Change key (settings.rs).
                clicked => { root.ask-key(root.item.name, root.item.title, root.item.button == "Change key"); }
            }
            Toggle {
                y: (parent.height - self.height) / 2;
                on: root.item.on;
                enabled: root.item.enabled;
                toggled(v) => {
                    if v && root.item.keyed {
                        root.ask-key(root.item.name, root.item.title, false);
                    } else {
                        root.source(root.item.name, v);
                    }
                }
            }
            Rectangle {
                width: 32px;
                Icon {
                    glyph: Icons.menu;
                    colour: root.held ? Theme.text : Theme.dim;
                    width: 18px;
                    height: 18px;
                }
                handle := TouchArea {
                    mouse-cursor: root.held ? MouseCursor.grabbing : MouseCursor.grab;
                    property <length> start;
                    pointer-event(e) => {
                        if e.button != PointerEventButton.left {
                            return;
                        }
                        if e.kind == PointerEventKind.down {
                            self.start = self.absolute-position.y + self.mouse-y;
                            RankDrag.by = 0;
                            RankDrag.dy = 0;
                            RankDrag.from = root.item.chosen;
                            RankDrag.mid = root.mid;
                            RankDrag.tall = root.height;
                            RankDrag.held = root.item.name;
                        }
                        if e.kind == PointerEventKind.up && root.held {
                            RankDrag.landing = true;
                            if RankDrag.by != 0 {
                                root.placed(root.item.name, RankDrag.by);
                            }
                            RankDrag.held = "";
                            RankDrag.dy = 0;
                            RankDrag.by = 0;
                        }
                    }
                    moved => {
                        if root.held {
                            RankDrag.dy = self.absolute-position.y + self.mouse-y - self.start;
                        }
                    }
                }
            }
        }
        Rectangle {
            x: 14px;
            y: parent.height - 1px;
            width: parent.width - 14px;
            height: 1px;
            visible: !root.item.last && !root.held;
            background: Theme.hairline;
        }
    }
    Timer {
        interval: 16ms;
        running: RankDrag.landing;
        triggered => { RankDrag.landing = false; }
    }
}

component SettingLine inherits VerticalLayout {
    // Where usage part `i` starts along the bar: the parts before it.
    pure function usage-start(i: int) -> float {
        let shares = root.item.shares;
        return (i > 0 ? shares[0] : 0) + (i > 1 ? shares[1] : 0) + (i > 2 ? shares[2] : 0) + (i > 3 ? shares[3] : 0) + (i > 4 ? shares[4] : 0);
    }
    in property <SettingRow> item;
    callback toggled(string, bool);
    callback chosen(string, int);
    callback action(string);
    callback slid(string, float, bool);
    callback typed(string, string);
    callback placed(string, int);
    callback ask-key(string, string, bool);
    callback source(string, bool);
    if root.item.kind == 6: SourceLine {
        item: root.item;
        source(id, on) => { root.source(id, on); }
        ask-key(id, title, set) => { root.ask-key(id, title, set); }
        placed(id, by) => { root.placed(id, by); }
    }
    // A group's heading: small capitals over its card (settings.rs gives the words in capitals).
    if root.item.kind == 0: HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 22px;
        padding-bottom: 8px;
        Text {
            text: root.item.title;
            color: Theme.dim;
            font-size: 11.5px;
            font-weight: 600;
            letter-spacing: 0.7px;
            overflow: elide;
        }
    }
    if root.item.kind == 9: HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 6px;
        padding-bottom: 6px;
        Text {
            text: root.item.title;
            color: Theme.dim;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
    if root.item.kind == 13: VerticalLayout {
        padding-bottom: 12px;
        SeasonTiles {
            options: root.item.options;
            chosen: root.item.chosen;
            picked(i) => { root.chosen(root.item.name, i); }
        }
    }
    if root.item.kind != 0 && root.item.kind != 6 && root.item.kind != 9 && root.item.kind != 13: Plate {
        first: root.item.first;
        last: root.item.last;
        min-height: 54px;
        if root.item.kind == 11 || root.item.kind == 12 || (root.item.kind == 8 && !root.item.on): TouchArea {
            clicked => { root.action(root.item.kind == 8 ? "server:" + root.item.name : root.item.name); }
        }
        VerticalLayout {
            padding-left: 16px;
            padding-right: 14px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 12px;
                if root.item.kind == 8: Icon {
                    y: (parent.height - self.height) / 2;
                    glyph: Icons.server;
                    colour: root.item.on ? Theme.accent : Theme.dim;
                    width: 18px;
                    height: 18px;
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.item.title;
                        color: root.item.kind == 12 ? Theme.accent : Theme.text;
                        opacity: root.item.enabled || root.item.kind == 4 ? 1 : 0.45;
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                    if root.item.detail != "" && root.item.kind != 11: Text {
                        text: root.item.detail;
                        color: Theme.dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
                if root.item.kind == 1: Toggle {
                    y: (parent.height - self.height) / 2;
                    on: root.item.on;
                    enabled: root.item.enabled;
                    toggled(v) => { root.toggled(root.item.name, v); }
                }
                if root.item.kind == 2: Chooser {
                    y: (parent.height - self.height) / 2;
                    options: root.item.options;
                    chosen: root.item.chosen;
                    enabled: root.item.enabled;
                    picked(i) => { root.chosen(root.item.name, i); }
                }
                if root.item.kind == 3: SmallButton {
                    y: (parent.height - self.height) / 2;
                    text: root.item.button;
                    enabled: root.item.enabled;
                    clicked => { root.action(root.item.name); }
                }
                if root.item.kind == 8 && root.item.button != "": SmallButton {
                    y: (parent.height - self.height) / 2;
                    text: root.item.button;
                    clicked => { root.action("edit:" + root.item.name); }
                }
                if root.item.kind == 8 && root.item.on: Text {
                    text: "✓";
                    color: Theme.accent;
                    vertical-alignment: center;
                }
                if root.item.kind == 11: Text {
                    text: root.item.detail;
                    color: Theme.dim;
                    vertical-alignment: center;
                }
                if root.item.kind == 11: Icon {
                    y: (parent.height - self.height) / 2;
                    glyph: Icons.nav-arrow-right;
                    colour: Theme.dim;
                    width: 12px;
                    height: 12px;
                }
            }
            // The four modes, as chips under their title, the same room above and below them.
            if root.item.kind == 14: HorizontalLayout {
                alignment: start;
                spacing: 6px;
                for o[i] in root.item.options: Chip {
                    text: o;
                    lit: i == root.item.chosen;
                    clicked => { root.chosen(root.item.name, i); }
                }
            }
            // What is stored, by kind: one bar split in the parts' colors, then a line per part.
            if root.item.kind == 15: Rectangle {
                height: 10px;
                border-radius: 5px;
                clip: true;
                background: Theme.hairline;
                for share[i] in root.item.shares: Rectangle {
                    x: root.usage-start(i) * parent.width;
                    width: max(0px, share * parent.width - 2px);
                    background: UsageColors.of(i);
                }
            }
            if root.item.kind == 15: VerticalLayout {
                spacing: 2px;
                for part[i] in root.item.options: VerticalLayout {
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: UsageColors.of(i);
                        }
                        Text {
                            text: part;
                            color: Theme.dim;
                            font-size: 12px;
                        }
                    }
                    // The downloads, each profile's under them, in from the dot.
                    if i == 1: VerticalLayout {
                        padding-left: 16px;
                        spacing: 2px;
                        for line in root.item.breakdown: Text {
                            text: line;
                            color: Theme.dim;
                            font-size: 12px;
                        }
                    }
                }
            }
            if root.item.kind == 5: Bar {
                thin: 4px;
                thick: 6px;
                fill: Theme.text;
                value: (root.item.value - root.item.min) / max(0.0001, root.item.max - root.item.min);
                moved(v) => { root.slid(root.item.name, root.item.min + v * (root.item.max - root.item.min), false); }
                done(v) => { root.slid(root.item.name, root.item.min + v * (root.item.max - root.item.min), true); }
            }
        }
        if !root.item.last: Rectangle {
            x: 16px;
            y: parent.height - 1px;
            width: parent.width - 16px;
            height: 1px;
            background: Theme.hairline;
        }
    }
}

// A vertical slider, as a graphic equalizer's band: dragged up and down, filled from 0 dB to its level.
component BandSlider inherits Rectangle {
    in property <float> value;
    in property <float> lo: -12;
    in property <float> hi: 12;
    in property <bool> enabled: true;
    callback moved(float, bool);
    property <float> held: -100;
    property <float> shown: root.held > -99 ? root.held : root.value;
    property <length> track: root.height - 14px;
    property <length> knob: (1 - (root.shown - root.lo) / (root.hi - root.lo)) * root.track;
    property <length> zero: (1 - (0 - root.lo) / (root.hi - root.lo)) * root.track;
    width: 22px;
    opacity: root.enabled ? 1 : 0.45;
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 7px;
        height: root.track;
        width: 4px;
        border-radius: 2px;
        background: Theme.chosen;
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: min(root.knob, root.zero) + 7px;
        width: 4px;
        height: abs(root.knob - root.zero);
        background: Theme.text;
    }
    Rectangle {
        y: root.knob;
        width: parent.width;
        height: 14px;
        border-radius: 7px;
        background: Theme.text;
    }
    ta := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.held = round(max(root.lo, min(root.hi, root.hi - (self.mouse-y - 7px) / root.track * (root.hi - root.lo))) * 2) / 2;
                root.moved(root.held, false);
            }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.held > -99 {
                root.moved(root.held, true);
                root.held = -100;
            }
        }
        moved => {
            if self.pressed {
                root.held = round(max(root.lo, min(root.hi, root.hi - (self.mouse-y - 7px) / root.track * (root.hi - root.lo))) * 2) / 2;
                root.moved(root.held, false);
            }
        }
    }
}

// A row with a label, a horizontal slider and its value.
component LevelRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> shown;
    in property <float> value;
    in property <float> lo;
    in property <float> hi;
    in property <bool> enabled: true;
    callback moved(float, bool);
    spacing: 12px;
    height: 32px;
    if root.label != "": Text {
        width: 80px;
        text: root.label;
        color: Theme.text;
        vertical-alignment: center;
    }
    Bar {
        y: (parent.height - self.height) / 2;
        horizontal-stretch: 1;
        thin: 4px;
        thick: 6px;
        fill: Theme.text;
        opacity: root.enabled ? 1 : 0.45;
        value: (root.value - root.lo) / max(0.0001, root.hi - root.lo);
        moved(v) => { root.moved(root.lo + v * (root.hi - root.lo), false); }
        done(v) => { root.moved(root.lo + v * (root.hi - root.lo), true); }
    }
    if root.shown != "": Text {
        width: 72px;
        text: root.shown;
        color: Theme.dim;
        font-size: 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

component EqSection inherits Text {
    color: Theme.text;
    font-size: 15px;
    font-weight: 700;
    height: 40px;
    vertical-alignment: bottom;
}

// A switch with its title and a line under it.
component ToggleLine inherits HorizontalLayout {
    in property <string> title;
    in property <string> detail;
    in property <bool> on;
    callback toggled(bool);
    spacing: 12px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Text {
            text: root.title;
            color: Theme.text;
        }
        if root.detail != "": Text {
            text: root.detail;
            color: Theme.dim;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
    Toggle {
        y: (parent.height - self.height) / 2;
        on: root.on;
        toggled(v) => { root.toggled(v); }
    }
}

// A group of the equalizer's on a plate, as settings' groups are.
component EqPlate inherits Rectangle {
    background: Theme.panel;
    border-radius: 10px;
    height: plate.preferred-height;
    plate := VerticalLayout {
        padding: 14px;
        spacing: 10px;
        @children
    }
}

component EqualizerPage inherits Flickable {
    in property <bool> on;
    in property <bool> graphic;
    in property <int> count;
    in property <[EqBandRow]> bands;
    in property <string> curve;
    in property <[string]> presets;
    in property <bool> auto-preamp;
    in property <float> preamp;
    in property <string> preamp-label;
    in property <float> balance;
    in property <string> balance-label;
    in property <bool> mono;
    in property <bool> limiter;
    in property <float> ceiling;
    in property <string> ceiling-label;
    in property <string> bypass;
    in property <[float]> ranges;
    callback back;
    callback set(string, string);
    callback level(string, float, bool);
    callback gain(int, float, bool);
    callback tool(string, int);
    callback sized(length, length);
    // Headphones: the AutoEQ list (none until fetched), searched; the last curve's word or a failure.
    in property <int> autoeq-count;
    in property <string> autoeq-search-words;
    in property <[EqLine]> autoeq-hits;
    // Over the hits while nothing is searched: whose curves they may be (the output playing).
    in property <string> autoeq-for;
    in property <string> autoeq-note;
    in property <bool> autoeq-busy;
    in property <[EqLine]> profiles;
    callback autoeq-search(string);
    callback autoeq-pick(int);
    callback autoeq-download();
    callback profile-apply(int);
    callback profile-delete(int);
    callback profile-save(string);
    property <string> autoeq-query;
    property <string> profile-name;
    content-height: page.preferred-height;
    // Settings' column, as wide as the top pill, and its title; each part on a plate as settings' groups are.
    page := VerticalLayout {
        width: parent.width;
        padding-left: Chrome.top-x;
        padding-right: max(0px, root.width - Chrome.top-x - Chrome.top-w);
        padding-bottom: 110px;
        spacing: 12px;
        HorizontalLayout {
            height: Chrome.top-room + 52px;
            padding-bottom: 12px;
            spacing: 10px;
            IconButton {
                y: parent.height - self.height - 16px;
                glyph: Icons.arrow-left;
                size: 30px;
                icon: 16px;
                clicked => { root.back(); }
            }
            Text {
                text: "Equalizer";
                color: Theme.text;
                font-family: Type.title;
                font-size: 34px;
                font-weight: 700;
                letter-spacing: -0.5px;
                horizontal-alignment: center;
                vertical-alignment: bottom;
                horizontal-stretch: 1;
            }
            Toggle {
                y: parent.height - self.height - 18px;
                on: root.on;
                toggled(v) => { root.set("eq", v ? "true" : "false"); }
            }
        }
        if root.bypass != "": Rectangle {
            border-radius: 10px;
            background: Theme.danger.with-alpha(0.2);
            height: bt.preferred-height + 20px;
            bt := Text {
                x: 12px;
                width: parent.width - 24px;
                text: root.bypass;
                color: Theme.text;
                wrap: word-wrap;
            }
        }
        EqPlate {
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Chip {
                text: "Graphic";
                lit: root.graphic;
                clicked => { root.set("eqMode", "GRAPHIC"); }
            }
            Chip {
                text: "Parametric";
                lit: !root.graphic;
                clicked => { root.set("eqMode", "PARAMETRIC"); }
            }
            Rectangle {
                width: 16px;
            }
            if root.graphic: HorizontalLayout {
                spacing: 8px;
                for n in [5, 10, 15, 31]: Chip {
                    text: n + " bands";
                    lit: root.count == n;
                    clicked => { root.set("eqLayout", n); }
                }
            }
        }
        Text {
            text: root.graphic ? "Each slider is the level at its frequency. Neighbouring bands are corrected for each other, so the sound follows the sliders." : "Each band is a filter of its own: drag its level, or add another.";
            color: Theme.dim;
            font-size: 12px;
            wrap: word-wrap;
        }
        // The curve the graphic equalizer plays, and a vertical slider per band under it.
        if root.graphic: Rectangle {
            height: 96px;
            border-radius: 10px;
            background: Theme.hover;
            Rectangle {
                y: parent.height / 2;
                height: 1px;
                background: Theme.hairline;
            }
            // Drawn by the core at this box's own size, so the curve fills it (a path keeps its box's shape).
            changed width => { root.sized(self.width - 24px, self.height); }
            init => { root.sized(self.width - 24px, self.height); }
            Path {
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                viewbox-width: self.width / 1px;
                viewbox-height: self.height / 1px;
                commands: root.curve;
                stroke: root.on ? Theme.accent : Theme.dim;
                stroke-width: 2px;
                stroke-line-cap: round;
                stroke-line-join: round;
                fill: transparent;
            }
        }
        if root.graphic: HorizontalLayout {
            height: 220px;
            alignment: space-between;
            for b[i] in root.bands: VerticalLayout {
                spacing: 6px;
                Text {
                    text: b.value;
                    color: Theme.dim;
                    font-size: 10px;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    BandSlider {
                        value: b.gain;
                        lo: root.ranges.length > 1 ? root.ranges[0] : -12;
                        hi: root.ranges.length > 1 ? root.ranges[1] : 12;
                        enabled: root.on;
                        moved(v, last) => { root.gain(i, v, last); }
                    }
                }
                Text {
                    text: b.label;
                    color: Theme.dim;
                    font-size: 10px;
                    horizontal-alignment: center;
                }
            }
        }
        if !root.graphic: VerticalLayout {
            spacing: 2px;
            for b[i] in root.bands: HorizontalLayout {
                spacing: 8px;
                if b.uses-gain: LevelRow {
                    horizontal-stretch: 1;
                    label: b.label;
                    shown: b.value + " dB";
                    value: b.gain;
                    lo: root.ranges.length > 1 ? root.ranges[0] : -12;
                    hi: root.ranges.length > 1 ? root.ranges[1] : 12;
                    enabled: root.on;
                    moved(v, last) => { root.gain(i, v, last); }
                }
                if !b.uses-gain: Text {
                    horizontal-stretch: 1;
                    text: b.label + "   " + b.value;
                    color: Theme.text;
                    height: 32px;
                    vertical-alignment: center;
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    glyph: Icons.xmark;
                    quiet: true;
                    size: 26px;
                    icon: 12px;
                    clicked => { root.tool("remove-band", i); }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            if !root.graphic: Chip {
                text: "Add band";
                clicked => { root.tool("add-band", 0); }
            }
            Chip {
                text: "Reset";
                clicked => { root.tool("reset", 0); }
            }
        }
        }
        EqSection {
            text: "Presets";
        }
        EqPlate {
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            for pr[i] in root.presets: Chip {
                text: pr;
                clicked => { root.tool("preset", i); }
            }
        }
        ToggleLine {
            padding-top: 12px;
            title: root.preamp-label;
            detail: "Automatic pulls the level down by the largest boost so the curve cannot clip";
            on: root.auto-preamp;
            toggled(v) => { root.tool(v ? "auto-preamp" : "manual-preamp", 0); }
        }
        if !root.auto-preamp: LevelRow {
            value: root.preamp;
            lo: root.ranges.length > 3 ? root.ranges[2] : -20;
            hi: root.ranges.length > 3 ? root.ranges[3] : 6;
            enabled: root.on;
            moved(v, last) => { root.level("eqPreamp", v, last); }
        }
        }
        EqSection {
            text: "Headphones";
        }
        // AutoEQ's measured curves, as Android's headphone presets: search the list, pick one, and it is the curve.
        EqPlate {
            if root.autoeq-count == 0: Text {
                text: "AutoEQ measures headphones and publishes a correction curve for each. The list is one download of about 850 kB; after that, searching happens on this computer.";
                color: Theme.dim;
                font-size: 12px;
                wrap: word-wrap;
            }
            if root.autoeq-count == 0: HorizontalLayout {
                alignment: start;
                SmallButton {
                    text: root.autoeq-busy ? "Downloading…" : "Download the list";
                    enabled: !root.autoeq-busy;
                    clicked => { root.autoeq-download(); }
                }
            }
            if root.autoeq-count > 0: Field {
                icon: Icons.search;
                placeholder: root.autoeq-search-words;
                text <=> root.autoeq-query;
                edited(t) => { root.autoeq-search(t); }
            }
            if root.autoeq-note != "": Text {
                text: root.autoeq-note;
                color: Theme.accent;
                font-size: 12px;
                wrap: word-wrap;
            }
            if root.autoeq-query == "" && root.autoeq-hits.length > 0: Text {
                text: root.autoeq-for;
                color: Theme.dim;
                font-size: 12px;
            }
            for hit[i] in root.autoeq-hits: Rectangle {
                height: hit-lines.preferred-height + 12px;
                border-radius: 8px;
                background: hit-touch.has-hover ? Theme.hover : transparent;
                hit-lines := VerticalLayout {
                    padding-left: 8px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    Text {
                        text: hit.title;
                        color: Theme.text;
                    }
                    Text {
                        text: hit.detail;
                        color: Theme.dim;
                        font-size: 11px;
                    }
                }
                hit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.autoeq-pick(i); }
                }
            }
            if root.autoeq-count > 0: Text {
                text: "Curves from AutoEQ (autoeq.app), measured by the reviewers named under each.";
                color: Theme.faint;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
        EqSection {
            text: "Profiles";
        }
        // The sound saved under a name, to use again or give a device (Remember sound per device).
        EqPlate {
            for p[i] in root.profiles: HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: profile-lines.preferred-height + 12px;
                    border-radius: 8px;
                    background: profile-touch.has-hover ? Theme.hover : transparent;
                    profile-lines := VerticalLayout {
                        padding-left: 8px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        alignment: center;
                        Text {
                            text: p.title;
                            color: Theme.text;
                        }
                        if p.detail != "": Text {
                            text: p.detail;
                            color: Theme.dim;
                            font-size: 11px;
                        }
                    }
                    profile-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.profile-apply(i); }
                    }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    glyph: Icons.xmark;
                    quiet: true;
                    size: 26px;
                    icon: 12px;
                    clicked => { root.profile-delete(i); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Field {
                    placeholder: "Save the sound as…";
                    text <=> root.profile-name;
                    accepted => {
                        root.profile-save(root.profile-name);
                        root.profile-name = "";
                    }
                }
                SmallButton {
                    y: (parent.height - self.height) / 2;
                    text: "Save";
                    enabled: root.profile-name != "";
                    clicked => {
                        root.profile-save(root.profile-name);
                        root.profile-name = "";
                    }
                }
            }
        }
        EqSection {
            text: "Output";
        }
        EqPlate {
        LevelRow {
            label: "Balance";
            shown: root.balance-label;
            value: root.balance;
            lo: -1;
            hi: 1;
            moved(v, last) => { root.level("balance", v, last); }
        }
        ToggleLine {
            title: "Mono";
            detail: "Both channels summed, for one-earbud listening";
            on: root.mono;
            toggled(v) => { root.set("mono", v ? "true" : "false"); }
        }
        ToggleLine {
            title: "Limiter";
            detail: "Catches what a boost or a positive ReplayGain would clip. Adds 5 ms of delay; below the ceiling the audio passes through untouched.";
            on: root.limiter;
            toggled(v) => { root.set("limiter", v ? "true" : "false"); }
        }
        if root.limiter: LevelRow {
            label: "Ceiling";
            shown: root.ceiling-label;
            value: root.ceiling;
            lo: root.ranges.length > 7 ? root.ranges[6] : -12;
            hi: root.ranges.length > 7 ? root.ranges[7] : 0;
            moved(v, last) => { root.level("limiter", v, last); }
        }
        }
    }
}

// "Show all" beside a section's title: quiet, as a shelf's.
component ShowAllLink inherits Text {
    callback clicked;
    color: Theme.dim;
    font-size: 14px;
    vertical-alignment: center;
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Show all under a list cut short: a plate with its words in the page's ink, as the page's other buttons.
component ShowAllButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 34px;
    width: label.preferred-width + 32px;
    border-radius: self.height / 2;
    background: touch.has-hover ? Theme.chosen : Theme.fill;
    label := Text {
        text: root.text;
        color: Theme.text;
        font-size: 14px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A page's buttons, as Android's: Shuffle and the seal bare glyphs either side of Play, an ink pill on the page's
// paper. Shuffle lights and Play is Pause while the queue this page started plays (the core's `hero_buttons`). A
// mix keeps itself as a playlist with Save as playlist after Play.
component PageActions inherits HorizontalLayout {
    in property <bool> seal;
    in property <bool> liked;
    in property <bool> shuffle-lit;
    in property <bool> pausing;
    in property <bool> can-save;
    callback play(bool);
    callback star();
    callback save();
    spacing: 6px;
    height: 48px;
    IconButton {
        y: (parent.height - self.height) / 2;
        glyph: Icons.shuffle;
        lit: root.shuffle-lit;
        size: 48px;
        icon: 24px;
        clicked => { root.play(true); }
    }
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 46px;
        width: max(180px, pl.preferred-width + 48px);
        border-radius: self.height / 2;
        background: Theme.pill;
        opacity: pt.pressed ? 0.75 : 1;
        pl := HorizontalLayout {
            alignment: center;
            spacing: 7px;
            Icon {
                y: (parent.height - self.height) / 2;
                glyph: root.pausing ? Icons.pause-solid : Icons.play-solid;
                colour: Theme.pill-ink;
                width: 18px;
                height: 18px;
            }
            Text {
                text: root.pausing ? "Pause" : "Play";
                color: Theme.pill-ink;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        pt := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.play(false); }
        }
    }
    if root.seal: Seal {
        y: (parent.height - self.height) / 2;
        width: 48px;
        height: 48px;
        size: 24px;
        liked: root.liked;
        clicked => { root.star(); }
    }
    if root.can-save: IconButton {
        y: (parent.height - self.height) / 2;
        glyph: Icons.plus-circle;
        size: 48px;
        icon: 24px;
        clicked => { root.save(); }
    }
}

// Where the window is dragged from, and double-clicked to zoom: the content runs up under the titlebar.
component TitleStrip inherits TouchArea {
    callback drag;
    callback zoom;
    height: 44px;
    pointer-event(e) => {
        if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
            root.drag();
        }
    }
    double-clicked => { root.zoom(); }
}

// The top pill's content: Home, then the library's sections; the search on the right, then the settings.
component TopContent inherits Rectangle {
    in property <int> view;
    in property <int> page-kind;
    // A jam guest's: the host's library, without the account's playlists and favorites.
    in property <bool> guest;
    in-out property <string> search-text;
    callback go(int);
    callback open-menu();
    callback search-edited(string);
    // The search field took or gave up the keys.
    callback typing(bool);
    // The pill's width (the window's), which decides whether the tabs are named.
    in property <length> room;
    property <bool> named: root.room >= 880px;
    public function focus-search() {
        input.focus();
    }
    public function end-search() {
        input.clear-focus();
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 2px;
        TabButton {
            y: (parent.height - self.height) / 2;
            text: "Home";
            icon: Icons.home-simple;
            named: root.named;
            current: root.view == 0 || root.view == 10 || root.view == 11;
            clicked => { root.go(0); }
        }
        Rectangle {
            width: 9px;
            Rectangle {
                width: 1px;
                height: 20px;
                background: Theme.hairline;
            }
        }
        TabButton {
            y: (parent.height - self.height) / 2;
            text: "Albums";
            icon: Icons.compact-disc;
            named: root.named;
            current: root.view == 2 || (root.view == 6 && root.page-kind == 0);
            clicked => { root.go(2); }
        }
        TabButton {
            y: (parent.height - self.height) / 2;
            text: "Artists";
            icon: Icons.user;
            named: root.named;
            current: root.view == 3 || (root.view == 6 && root.page-kind == 1);
            clicked => { root.go(3); }
        }
        TabButton {
            y: (parent.height - self.height) / 2;
            text: "Songs";
            icon: Icons.music-note;
            named: root.named;
            current: root.view == 5;
            clicked => { root.go(5); }
        }
        if !root.guest: TabButton {
            y: (parent.height - self.height) / 2;
            text: "Playlists";
            icon: Icons.playlist;
            named: root.named;
            current: root.view == 4 || (root.view == 6 && root.page-kind == 2);
            clicked => { root.go(4); }
        }
        if !root.guest: TabButton {
            y: (parent.height - self.height) / 2;
            text: "Favorites";
            icon: Icons.seal-outline;
            named: root.named;
            current: root.view == 12;
            clicked => { root.go(12); }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        // The search field, a filled capsule 6 px in from the pill (its corner the pill's less that). It widens
        // while typed in; typing shows what it finds on the search page.
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: input.has-focus ? (root.named ? 280px : 220px) : root.named ? 180px : 36px;
            animate width { duration: Motion.reduced ? 0ms : 200ms; easing: ease-out; }
            height: 36px;
            border-radius: 18px;
            clip: true;
            // As Android's search field: a capsule raised on the surface, outlined in the accent while it has the keys.
            background: touch-search.has-hover && !input.has-focus ? Theme.raised : Theme.panel;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent : Theme.hairline;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 12px;
                spacing: 7px;
                Icon {
                    y: (parent.height - self.height) / 2;
                    glyph: Icons.search;
                    colour: input.has-focus || root.view == 1 ? Theme.accent : Theme.dim;
                    width: 18px;
                    height: 18px;
                }
                Rectangle {
                    FocusScope {
                        key-pressed(e) => {
                            if e.text == Key.Escape {
                                input.clear-focus();
                                return accept;
                            }
                            reject
                        }
                        input := TextInput {
                            width: 100%;
                            height: 100%;
                            text <=> root.search-text;
                            color: Theme.text;
                            vertical-alignment: center;
                            single-line: true;
                            selection-background-color: Theme.accent.with-alpha(0.4);
                            edited => { root.search-edited(self.text); }
                            changed has-focus => { root.typing(self.has-focus); }
                        }
                    }
                    if root.search-text == "" && (root.named || input.has-focus): Text {
                        x: 0;
                        text: input.has-focus ? "Artists, albums and songs" : "Search";
                        color: input.has-focus ? Theme.faint : Theme.dim;
                        vertical-alignment: center;
                    }
                }
            }
            // Until it has the keys, a click anywhere on the capsule gives them to it.
            touch-search := TouchArea {
                enabled: !input.has-focus;
                mouse-cursor: text;
                clicked => {
                    input.focus();
                    if root.search-text != "" && root.view != 1 { root.go(1); }
                }
            }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            glyph: Icons.settings;
            lit: root.view == 8 || root.view == 9;
            quiet: true;
            size: 36px;
            clicked => { root.open-menu(); }
        }
    }
}


export component AppWindow inherits Window {
    // The window's corner holds macOS's traffic lights.
    in property <bool> traffic-lights;
    init => {
        Chrome.window-width = self.width;
        Chrome.window-height = self.height;
    }
    in property <bool> downloads;
    // The season tile and the appearance chosen (the settings', for the settings menu).
    in property <int> season-worn;
    in property <bool> season-following;
    // The follow switch's setting name and value ([`settings::seasons`]), and its line under it.
    in property <string> season-switch;
    in property <string> season-detail;
    in property <int> appearance-pick;
    public function show-menu() { gear.show(); }
    title: "nori";
    icon: @image-url("assets/logo.png");
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 860px;
    min-height: 560px;
    background: Theme.ground;
    default-font-size: 13px;
    default-font-family: Type.body;


    // 0 home, 1 search, 2 albums, 3 artists, 4 playlists, 5 songs, 6 a page (album, artist, playlist), 7 login.
    in-out property <int> view: 0;
    in property <string> server;
    in property <string> greeting;
    in property <bool> loading;
    in property <string> failed;
    in property <string> note;
    in property <bool> note-error;
    // A button on the note ("Apply", "Undo"), and its press.
    in property <string> note-action;
    callback note-act();
    // Bumped whenever a cover arrives: every picture asks `art` again and finds the new one.
    in property <int> covers-rev;
    pure callback art(string, int, int) -> image;
    pure callback pick-art([string], int) -> image;

    in property <[Shelf]> shelves;
    in property <string> show-all-text;
    in-out property <int> shown-shelf;
    in property <[Pick]> picks;
    // Home's Continue card: offered, the song, where it stands ("Artist · 3 of 12") and its cover.
    in property <bool> offer-shown;
    in property <string> offer-title;
    in property <string> offer-line;
    in property <string> offer-art;
    callback take-offer();
    callback dismiss-offer();
    // The page is one of the mixes, laid out as a playlist.
    in property <bool> page-mix;
    in property <bool> picks-loaded;
    callback open-mix(string);
    in property <[Card]> albums;
    // The album grid's orders, the one in use, and its rows when it is drawn a row per artist.
    in property <[string]> album-sorts;
    in property <int> album-sort;
    in property <bool> albums-in-rows;
    in property <[Shelf]> album-rows;
    callback album-sort-chosen(int);
    in property <[Card]> artists;
    in property <[Card]> playlists;
    in property <[SongRow]> songs;
    in property <bool> more-songs;

    in property <[Card]> search-artists;
    in property <[Card]> search-albums;
    in property <[Card]> search-playlists;
    in property <[SongRow]> search-songs;
    in property <string> search-note;
    // The server has not answered the search yet.
    in property <bool> search-busy;

    // The page open: 0 album, 1 artist, 2 playlist, and its id (the sidebar marks a playlist's).
    in property <int> page-kind;
    in property <string> page-id;
    in property <string> page-title;
    in property <string> page-sub;
    // The artist the page's subtitle names (an album's), whose page a click on it opens.
    in property <string> page-sub-artist;
    in property <string> page-caption;
    in property <string> page-art;
    in property <[SongRow]> page-songs;
    // More songs wait behind Show all: an artist's, search's (callback all-songs: 0 the page, 2 search).
    in property <bool> page-songs-more;
    in property <bool> search-songs-more;
    callback all-songs(int);
    // An artist's releases, a shelf per kind (pages.rs's `release_groups`).
    in property <[Shelf]> page-shelves;
    // The page wears its cover's colours: the blurred cover (nori-look's wash, dyed as the page is) runs out
    // into the page's own colour, so there is no line where the picture stops.
    in property <image> page-wash;
    // A mix's covers, two by two in the cover's place.
    in property <[string]> page-covers;
    // The list head's glyphs, the core's `page_actions` in their order: 0 download, 1 download the rest, 2
    // remove the download, 3 download everything, 4 add to queue, 5 a new draw.
    in property <[int]> page-acts;
    callback page-act(int);
    // The page's Shuffle and Play for the queue it started (the core's `hero_buttons`).
    in property <bool> page-shuffle-lit;
    in property <bool> page-pausing;
    // A mix can be kept on the account as a playlist.
    in property <bool> page-can-save;
    callback page-save();
    // Colors from the cover on album and artist pages and in Now Playing; off in Midnight.
    in property <bool> covers-tint: true;

    // What plays.
    in property <bool> has-song;
    in property <string> now-title;
    in property <string> now-artist;
    in property <string> now-album;
    in property <string> now-artist-id;
    in property <Credits> now-credits;
    in property <bool> now-starred;
    in property <string> now-album-id;
    in property <string> now-art;
    in property <bool> playing;
    in property <bool> mixing;
    in property <string> mixing-label;
    in property <bool> buffering;
    in property <int> position-ms;
    in property <int> display-position-ms: root.position-ms;
    in property <int> duration-ms;
    // A radio station or live stream plays: "Live" stands where the seek bar would.
    in property <bool> live;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <float> volume: 1;
    in property <[SongRow]> queue;
    // Now Playing's ground: the cover playing, blurred (nori-look's wash), in two layers that cross-fade.
    in property <image> wash-a;
    in property <image> wash-b;
    in property <bool> wash-on-b;
    // The inspector on the right: 0 shut, 1 Playing Next, 2 lyrics, 3 the other devices. It keeps showing
    // the last one while it slides away.
    in-out property <int> inspector;
    // How far the sheet on the right is in: it floats over the page, which stays where it is.
    property <float> panel-in: self.inspector != 0 ? 1 : 0;
    animate panel-in { duration: Motion.reduced ? 0ms : 240ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
    // Remote control is on: the devices button, and the places the music can play.
    in property <bool> devices-on;
    in property <[DeviceRow]> devices;
    // A device row was clicked: the music moves there ("" for this computer).
    callback pick-device(string);
    in property <string> pairing-link;
    // The pairing sheet: this computer's code as a QR and a link to copy.
    in property <image> pairing-qr;
    in-out property <bool> pairing-open;
    callback copy-pairing();
    callback forget-devices();
    // "Playing on <device>" while another device plays: the player shows and controls it.
    in property <string> playing-on;
    property <int> shown-panel: 1;
    changed inspector => {
        if self.inspector != 0 {
            self.shown-panel = self.inspector;
        }
        self.player-changed();
    }
    in-out property <bool> full-player;
    // What Now Playing shows beside the artwork: 0 nothing, 1 the queue, 2 the lyrics; and how tall the line
    // sung is (the compositor keeps it sharp).
    in-out property <int> full-panel: 2;
    out property <length> full-lyric-h: 60px;
    // Where the line sung is on the window now, as the lyrics scroll to it: the compositor's sharp band
    // follows it. Scrolled by hand, every line is sharp until the next one is sung.
    out property <length> full-lyric-top: full-lyrics.y + full-lyrics.content-y + root.full-lyric-at;
    out property <bool> full-lyrics-browsed;
    property <length> full-lyric-at;
    // The page's area moved (the window was resized), or what the player window mirrors changed.
    callback page-moved();
    callback player-changed();
    changed width => {
        Chrome.window-width = self.width;
        root.page-moved();
    }
    changed height => {
        Chrome.window-height = self.height;
        root.page-moved();
    }
    changed full-player => { root.player-changed(); }
    changed full-panel => { root.player-changed(); }
    changed view => { root.player-changed(); }
    // The lyrics of the song playing: the lines, the one sung (-1 for none), and a line about them.
    in property <[string]> lyrics-lines;
    // The lines broken into the rows the sung line's pieces take, per view (app.rs `rows`): drawn so, no line
    // moves its words as it is sung or let go. Empty until laid out.
    in property <[string]> lyrics-side-rows;
    in property <[string]> lyrics-full-rows;
    in property <int> lyrics-active: -1;
    // The lit line filling word by word (lyrics with word times): what is sung, the character being sung and
    // how far, and the rest.
    in property <bool> lyric-sweeping;
    in property <string> lyric-sung;
    in property <string> lyric-now;
    in property <float> lyric-mix;
    in property <string> lyric-rest;
    callback lyric-tapped(int);
    in property <[LyricPiece]> lyric-pieces-side;
    in property <[LyricPiece]> lyric-pieces-full;
    in property <bool> lyrics-synced;
    in property <string> lyrics-note;
    // The song's lyrics are being looked for; their words come only if that takes a while
    // (`lyrics-slow`), so a song whose lyrics are at hand changes without a flash of them.
    in property <bool> lyrics-waiting;
    property <bool> lyrics-slow;
    changed lyrics-waiting => {
        self.lyrics-slow = false;
        lyrics-slow-timer.running = self.lyrics-waiting;
    }
    lyrics-slow-timer := Timer {
        interval: 600ms;
        running: false;
        triggered => {
            self.running = false;
            root.lyrics-slow = true;
        }
    }
    // What stands where the lyrics would: shown once there is something to say.
    property <float> lyrics-note-shown: !root.lyrics-waiting || root.lyrics-slow ? 1 : 0;
    in property <[SettingRow]> settings;
    // Who is signed in (the account row), and the text the page's list is narrowed by.
    in property <string> account;
    in property <string> account-initial;
    callback open-accounts();
    in-out property <string> find-text;
    // The library list shown has nothing in it.
    property <bool> list-empty: (root.view == 2 && root.albums.length == 0) || (root.view == 3 && root.artists.length == 0) || (root.view == 4 && root.playlists.length == 0) || ((root.view == 5 || root.view == 12) && root.songs.length == 0);
    property <string> list-name: root.view == 10 ? root.shelves[root.shown-shelf].title : root.view == 11 ? "For you" : root.view == 2 ? "Albums" : root.view == 3 ? "Artists" : root.view == 4 ? "Playlists" : root.view == 5 ? "Songs" : root.view == 12 ? "Favorites" : root.view == 6 && root.page-kind == 0 ? "Album" : root.view == 6 && root.page-kind == 2 ? (root.page-mix ? "Mix" : "Playlist") : "";
    callback find-edited(string);
    // The artist chosen on the Artists page.
    in property <string> artist-chosen;
    callback choose-artist(string);
    // The equalizer page (view 9), from the settings.
    in property <bool> eq-on;
    in property <bool> eq-graphic;
    in property <int> eq-count;
    in property <[EqBandRow]> eq-bands;
    in property <string> eq-curve;
    in property <[string]> eq-presets;
    in property <bool> eq-auto-preamp;
    in property <float> eq-preamp;
    in property <string> eq-preamp-label;
    in property <float> eq-balance;
    in property <string> eq-balance-label;
    in property <bool> eq-mono;
    in property <bool> eq-limiter;
    in property <float> eq-ceiling;
    in property <string> eq-ceiling-label;
    in property <string> eq-bypass;
    in property <[float]> eq-ranges;
    in property <int> eq-autoeq-count;
    in property <string> eq-autoeq-search-words;
    in property <[EqLine]> eq-autoeq-hits;
    in property <string> eq-autoeq-for;
    in property <string> eq-autoeq-note;
    in property <bool> eq-autoeq-busy;
    in property <[EqLine]> eq-profiles;
    callback eq-autoeq-search(string);
    callback eq-autoeq-pick(int);
    callback eq-autoeq-download();
    callback eq-profile-apply(int);
    callback eq-profile-delete(int);
    callback eq-profile-save(string);
    callback setting-slid(string, float, bool);
    callback setting-typed(string, string);
    // A lyrics service dragged some places (down +), and the sheet its key is typed in.
    callback source-moved(string, int);
    in-out property <bool> key-open;
    in-out property <string> key-service;
    in-out property <string> key-title;
    in-out property <string> key-text;
    in-out property <bool> key-set;
    callback eq-set(string, string);
    callback eq-gain(int, float, bool);
    callback eq-tool(string, int);
    callback eq-sized(length, length);
    // The curve's box, points.
    in-out property <length> eq-curve-w: 800px;
    in-out property <length> eq-curve-h: 96px;
    // Where the queue's songs come from.
    in property <string> queue-from;
    callback clear-queue();
    // The player's "…": the playing song's menu with the player's own lines, and one chosen.
    callback player-menu() -> [SongGo];
    callback player-act(int, string);
    property <[SongGo]> player-lines;
    public function show-player-menu() {
        root.player-lines = root.player-menu();
        player-pop.show();
    }
    // The sleep timer's choices, "Off" first while one runs, and one chosen.
    in property <[string]> sleep-choices;
    callback sleep(int);
    public function show-sleep() { sleep-pop.show(); }
    // The lyrics' sheet: where they came from and how they are timed, the shift, whether it is the
    // listener's, and a step sooner (1), later (-1) or back (0).
    in-out property <bool> lyrics-sheet-open;
    in property <string> lyrics-from;
    in property <string> lyrics-timing;
    in property <string> lyrics-shift;
    in property <bool> lyrics-yours;
    callback lyrics-nudge(int);
    // A song's details, in a sheet.
    in-out property <bool> details-open;
    in property <[Detail]> details;
    // Adding a song to a playlist: the sheet open, the playlists offered, and a new one's name.
    in-out property <bool> picker-open;
    in property <[Card]> picker-playlists;
    in-out property <string> picker-name;
    callback add-to-playlist(string);
    callback add-to-new-playlist(string);
    // "Join a Jam": the sheet open, its link, why it failed, and joining under way.
    in-out property <bool> join-open;
    // Signing the profile's account in with cookies pasted from a browser (YouTube Music).
    in-out property <bool> signin-open;
    in-out property <string> signin-text;
    in property <bool> signin-busy;
    in property <string> signin-error;
    callback sign-in(string);
    callback open-sign-in-page();
    // The account sheet: who is signed in (empty: no one), and pasting unfolded under Sign in.
    in property <string> signin-user;
    in-out property <bool> signin-pasting;
    callback sign-in-window();
    callback sign-out();
    // The source ended the session: the sheet can be asked not to come back at start.
    in property <bool> signin-ended;
    callback sign-in-quiet();
    in-out property <string> join-link;
    in property <string> join-error;
    in property <bool> join-busy;
    callback join-jam(string);
    // A queue row's song taken out or moved (list indexes), and the last one taken out put back.
    callback remove-queued(int);
    callback move-queued(int, int);
    callback undo-removed();
    in property <string> queue-undo;
    // Settings tab: 0 General, 1 Playback, 2 Sound, 3 Lyrics, 4 Library, 5 Data, 6 Servers.
    in-out property <int> settings-tab;
    callback settings-tab-chosen(int);
    // The tabs the profile in use has (settings.rs `tabs`).
    in property <[string]> settings-tabs;

    in-out property <string> login-name;
    in-out property <string> login-url: "https://";
    in-out property <string> login-user;
    in-out property <string> login-password;
    in property <string> login-error;
    in property <bool> login-busy;
    in property <bool> can-cancel-login;
    // The kinds of profile offered, and the one being added.
    in property <[LoginKind]> login-kinds;
    in-out property <int> login-kind;

    callback go(int);
    callback back();
    callback open-album(string);
    callback open-artist(string);
    callback open-playlist(string);
    // The song `id` of Home's shelf `shelf`: the shelf's songs play from it.
    callback shelf-song(int, string);
    callback play-album(string);
    callback play-playlist(string);
    // A song of a list: 0 the page, 1 the songs, 2 search. `how`: -1 play, else a line of its menu
    // (`SongGo::kind`), whose lines `song-menu` gives.
    callback song(int, int, int);
    callback song-menu(int, int) -> [SongGo];
    callback play-page(bool);
    // Plays an album (0) or playlist (1) and starts a jam.
    callback jam-play(int, string);
    // Card `id` (`Card::kind`, or 4 a mix) next (true) or at the end of the queue.
    callback queue-card(int, string, bool);
    callback play-mix(string);
    // The page's songs added at the end of the queue.
    // The album's or artist's seal: offered where the profile keeps the account's favorites, and its state.
    in property <bool> page-can-star;
    in property <bool> page-starred;
    callback page-star();
    callback more();
    callback search-edited(string);
    // Nothing is typed in the search field: the page lists the searches made before.
    in property <bool> search-blank: true;
    // The search found nothing for `search-query`.
    in property <bool> search-nothing;
    in property <string> search-query;
    in property <[string]> recent-searches;
    callback search-again(string);
    callback forget-searches();
    callback toggle();
    // The heart of the song playing pressed.
    callback star();
    callback next();
    callback previous();
    callback seek(float);
    callback seek-by(int);
    callback set-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback jump(int);
    callback login();
    callback cancel-login();
    callback setting-toggled(string, bool);
    callback setting-chosen(string, int);
    callback setting-action(string);
    callback drag-window();
    callback zoom-window();
    // Worker messages are waiting in the app's inbox.
    callback messages-arrived();

    function clock(ms: int) -> string {
        let s = floor(max(0, ms) / 1000);
        return floor(s / 60) + ":" + (mod(s, 60) < 10 ? "0" : "") + mod(s, 60);
    }


    // The keys Music answers to without a menu: space plays and pauses, the arrows seek, escape leaves
    // Now Playing. A text field that has the keys keeps them.
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == " " {
                root.toggle();
                return accept;
            }
            if e.text == Key.Escape && root.full-player {
                root.full-player = false;
                return accept;
            }
            if e.text == Key.RightArrow && !e.modifiers.control {
                root.seek-by(10000);
                return accept;
            }
            if e.text == Key.LeftArrow && !e.modifiers.control {
                root.seek-by(-10000);
                return accept;
            }
            reject
        }

        Rectangle {
            background: Theme.ground;
        }

        if root.view == 7: Rectangle {
            TitleStrip {
                y: 0;
                drag => { root.drag-window(); }
                zoom => { root.zoom-window(); }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: 360px;
                        spacing: 12px;
                        HorizontalLayout {
                            alignment: center;
                            padding-bottom: 8px;
                            Image {
                                source: @image-url("assets/logo.png");
                                height: 54px;
                                image-fit: contain;
                            }
                        }
                        if root.login-kinds.length > 1: HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            for k[i] in root.login-kinds: Capsule {
                                text: k.name;
                                ink: i == root.login-kind ? Theme.pill : Theme.plate;
                                label: i == root.login-kind ? Theme.pill-ink : Theme.plate-ink;
                                clicked => { root.login-kind = i; }
                            }
                        }
                        Text {
                            text: root.login-kinds[root.login-kind].note;
                            color: Theme.dim;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            height: 10px;
                        }
                        if root.login-kinds[root.login-kind].asks-name: Field {
                            icon: Icons.user;
                            placeholder: "Name (optional)";
                            text <=> root.login-name;
                        }
                        if root.login-kinds[root.login-kind].asks-address: Field {
                            icon: Icons.server;
                            placeholder: "Server address";
                            text <=> root.login-url;
                        }
                        if root.login-kinds[root.login-kind].asks-user: Field {
                            icon: Icons.user;
                            placeholder: "User name";
                            text <=> root.login-user;
                        }
                        if root.login-kinds[root.login-kind].asks-password: Field {
                            icon: Icons.key;
                            placeholder: "Password";
                            secret: true;
                            text <=> root.login-password;
                            accepted => {
                                if !root.login-busy {
                                    root.login();
                                }
                            }
                        }
                        if root.login-error != "": Text {
                            text: root.login-error;
                            color: Theme.danger;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                        Rectangle {
                            height: 8px;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            if root.can-cancel-login: Capsule {
                                text: "Cancel";
                                ink: Theme.fill;
                                label: Theme.text;
                                clicked => { root.cancel-login(); }
                            }
                            Capsule {
                                text: root.login-busy ? "Signing in…" : root.login-kinds[root.login-kind].add;
                                clicked => {
                                    if !root.login-busy {
                                        root.login();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.view != 7: Rectangle {
            visible: full-screen.opacity < 1;
            // The page; it runs up under the top pill and under the player pill, and gives the panel its room.
            Rectangle {
                x: 0;
                width: parent.width;
                clip: true;


                if root.view == 0: Fade {
                    home-scroll := Remembered {
                        content-height: home.preferred-height;
                        home := VerticalLayout {
                            y: floor(home-scroll.content-y / 1phx + 0.5) * 1phx - home-scroll.content-y;
                            width: parent.width;
                            padding-bottom: 100px;
                            Heading {
                                title: root.greeting;
                            }
                            // The queue another device left, offered as Spotify offers to carry on here: a card on
                            // raised paper, the song, where it stands, Resume and a close.
                            if root.offer-shown: HorizontalLayout {
                                padding-left: 32px;
                                padding-right: 32px;
                                padding-bottom: 26px;
                                alignment: start;
                                Rectangle {
                                    width: min(560px, parent.width - 64px);
                                    height: 178px;
                                    border-radius: 18px;
                                    clip: true;
                                    background: Theme.raised;
                                    Image {
                                        x: 0;
                                        width: parent.height;
                                        height: parent.height;
                                        source: root.art(root.offer-art, 0, root.covers-rev);
                                        image-fit: cover;
                                    }
                                    Rectangle {
                                        x: 0;
                                        width: parent.height;
                                        background: @linear-gradient(90deg, Theme.raised.with-alpha(0) 55%, Theme.raised 100%);
                                    }
                                    VerticalLayout {
                                        x: parent.height + 6px;
                                        width: parent.width - self.x - 16px;
                                        padding-top: 16px;
                                        padding-bottom: 14px;
                                        Text {
                                            text: "CONTINUE";
                                            color: Theme.text.with-alpha(0.65);
                                            font-size: 11.5px;
                                            font-weight: 600;
                                            letter-spacing: 0.7px;
                                        }
                                        Text {
                                            text: root.offer-title;
                                            color: Theme.text;
                                            font-family: Type.title;
                                            font-size: 21px;
                                            font-weight: 600;
                                            wrap: word-wrap;
                                            overflow: elide;
                                            max-height: 52px;
                                        }
                                        Text {
                                            text: root.offer-line;
                                            color: Theme.text.with-alpha(0.7);
                                            font-size: 13px;
                                            overflow: elide;
                                        }
                                        Rectangle {
                                            vertical-stretch: 1;
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            Rectangle {
                                                height: 38px;
                                                width: resume.preferred-width + 28px;
                                                border-radius: 19px;
                                                background: Theme.text;
                                                resume := HorizontalLayout {
                                                    alignment: center;
                                                    spacing: 6px;
                                                    Icon {
                                                        y: (parent.height - self.height) / 2;
                                                        glyph: Icons.play-solid;
                                                        colour: Theme.raised;
                                                        width: 18px;
                                                        height: 18px;
                                                    }
                                                    Text {
                                                        text: "Resume";
                                                        color: Theme.raised;
                                                        font-size: 14px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.take-offer(); }
                                                }
                                            }
                                        }
                                    }
                                    IconButton {
                                        x: parent.width - self.width - 2px;
                                        y: 2px;
                                        glyph: Icons.xmark;
                                        size: 40px;
                                        icon: 18px;
                                        ink: Theme.text.with-alpha(0.6);
                                        clicked => { root.dismiss-offer(); }
                                    }
                                }
                            }
                            if !root.picks-loaded || root.picks.length > 0: picks-shelf := ShelfView {
                                title: "For you";
                                more: true;
                                show-all => { root.go(11); }
                                count: root.picks.length;
                                loading: !root.picks-loaded;
                                least: 200px;
                                below: self.side * 56 / 150;
                                for slot in picks-shelf.slots: PickCard {
                                    property <int> i: picks-shelf.first + slot;
                                    property <Pick> m: root.picks[self.i];
                                    x: floor((picks-shelf.gap + self.i * picks-shelf.step) / 1phx) * 1phx;
                                    side: picks-shelf.side;
                                    pick: self.m;
                                    picture: root.pick-art(self.m.covers, root.covers-rev);
                                    open => { root.open-mix(self.m.id); }
                                    play => { root.play-mix(self.m.id); }
                                    queue(next) => { root.queue-card(4, self.m.id, next); }
                                }
                            }
                            for shelf[index] in root.shelves: home-row := VerticalLayout {
                                property <length> top: self.y + home.y + home-scroll.content-y;
                                property <bool> on-screen: self.top + self.height > 0px && self.top < home-scroll.height;
                                if !shelf.loaded || shelf.cards.length > 0: albums-shelf := ShelfView {
                                    title: shelf.title;
                                    more: true;
                                    show-all => { root.shown-shelf = index; root.go(10); }
                                    count: shelf.cards.length;
                                    loading: !shelf.loaded;
                                    live: home-row.on-screen;
                                    // A source's feed mixes songs, albums, playlists and artists in a shelf: each opens or plays
                                    // as what it is, a song with the shelf's songs after it.
                                    for slot in albums-shelf.slots: CardView {
                                        property <int> i: albums-shelf.first + slot;
                                        property <Card> c: shelf.cards[self.i];
                                        x: albums-shelf.gap + self.i * albums-shelf.step;
                                        side: albums-shelf.side;
                                        card: self.c;
                                        round: self.c.kind == 1;
                                        picture: root.art(self.c.art, 0, root.covers-rev);
                                        open => {
                                            if self.c.kind == 1 {
                                                root.open-artist(self.c.id);
                                            } else if self.c.kind == 2 {
                                                root.open-playlist(self.c.id);
                                            } else if self.c.kind == 3 {
                                                root.shelf-song(index, self.c.id);
                                            } else {
                                                root.open-album(self.c.id);
                                            }
                                        }
                                        play => {
                                            if self.c.kind == 2 {
                                                root.play-playlist(self.c.id);
                                            } else if self.c.kind == 3 {
                                                root.shelf-song(index, self.c.id);
                                            } else if self.c.kind == 1 {
                                                root.open-artist(self.c.id);
                                            } else {
                                                root.play-album(self.c.id);
                                            }
                                        }
                                        queue(next) => { root.queue-card(self.c.kind, self.c.id, next); }
                                        jam => { root.jam-play(self.c.kind == 2 ? 1 : 0, self.c.id); }
                                    }
                                }
                            }
                        }
                    }
                }

                // What the top pill's search field found; the field is the pill's.
                if root.view == 1: Fade {
                    // The server is still being asked: a sliver sweeping under the top pill, over the page.
                    if root.search-busy: Rectangle {
                        y: Chrome.top-room - 6px;
                        x: 32px;
                        width: parent.width - 64px;
                        height: 3px;
                        border-radius: 1.5px;
                        clip: true;
                        background: Theme.accent.with-alpha(0.18);
                        Rectangle {
                            property <float> t: Motion.reduced ? 0.35 : mod(animation-tick() / 1.4s, 1);
                            x: (self.t * 1.4 - 0.4) * parent.width;
                            width: parent.width * 0.4;
                            border-radius: 1.5px;
                            background: Theme.accent;
                        }
                    }
                    // Nothing to list (no searches yet, or nothing found): a word in the middle of the page.
                    if (root.search-blank && root.recent-searches.length == 0) || root.search-nothing: VerticalLayout {
                        alignment: center;
                        spacing: 10px;
                        padding-top: Chrome.top-room;
                        padding-bottom: Chrome.bottom-room;
                        Icon {
                            x: (parent.width - self.width) / 2;
                            glyph: Icons.search;
                            colour: Theme.dim;
                            width: 44px;
                            height: 44px;
                        }
                        Text {
                            text: root.search-nothing ? "No results" : "Search";
                            color: Theme.text;
                            font-family: Type.title;
                            font-size: 24px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.search-nothing ? "Nothing matches “" + root.search-query + "”. Check the spelling or try other words." : "Your library and your server, by artist, album or song";
                            color: Theme.dim;
                            font-size: 14px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        Remembered {
                            vertical-stretch: 1;
                            content-height: found.preferred-height;
                            found := VerticalLayout {
                                width: parent.width;
                                padding-top: Chrome.top-room + 8px;
                                padding-bottom: 100px;
                                // The searches made before: a plain list under the top pill, newest first.
                                if root.search-blank && root.recent-searches.length > 0: HorizontalLayout {
                                    // Under the top pill, edge to edge with it (the page is the window's width).
                                    padding-left: Chrome.top-x;
                                    padding-right: max(0px, root.width - Chrome.top-x - Chrome.top-w);
                                    VerticalLayout {
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-bottom: 6px;
                                            SectionTitle {
                                                text: "Recent searches";
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            ShowAllLink {
                                                text: "Clear";
                                                clicked => { root.forget-searches(); }
                                            }
                                        }
                                        for q in root.recent-searches: Rectangle {
                                            height: 40px;
                                            border-radius: 10px;
                                            background: recent-touch.has-hover ? Theme.chosen : transparent;
                                            Icon {
                                                x: 10px;
                                                glyph: Icons.clock-rotate-right;
                                                colour: Theme.dim;
                                                width: 18px;
                                                height: 18px;
                                            }
                                            Text {
                                                x: 40px;
                                                width: parent.width - 52px;
                                                text: q;
                                                color: Theme.text;
                                                font-size: 15px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            recent-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.search-again(q); }
                                            }
                                        }
                                    }
                                }
                                if root.search-note != "": HorizontalLayout {
                                    padding-left: 34px;
                                    padding-bottom: 8px;
                                    Text {
                                        text: root.search-note;
                                        color: Theme.dim;
                                        height: 24px;
                                        vertical-alignment: center;
                                    }
                                }
                                if root.search-artists.length > 0: artists-found := ShelfView {
                                    title: "Artists";
                                    count: root.search-artists.length;
                                    round: true;
                                    for c[i] in root.search-artists: CardView {
                                        x: artists-found.gap + i * artists-found.step;
                                        side: artists-found.side;
                                        card: c;
                                        round: true;
                                        picture: root.art(c.art, 0, root.covers-rev);
                                        open => { root.open-artist(c.id); }
                                    }
                                }
                                if root.search-albums.length > 0: albums-found := ShelfView {
                                    title: "Albums";
                                    count: root.search-albums.length;
                                    for c[i] in root.search-albums: CardView {
                                        x: albums-found.gap + i * albums-found.step;
                                        side: albums-found.side;
                                        card: c;
                                        picture: root.art(c.art, 0, root.covers-rev);
                                        open => { root.open-album(c.id); }
                                        play => { root.play-album(c.id); }
                                        queue(next) => { root.queue-card(0, c.id, next); }
                                        jam => { root.jam-play(0, c.id); }
                                    }
                                }
                                if root.search-playlists.length > 0: playlists-found := ShelfView {
                                    title: "Playlists";
                                    count: root.search-playlists.length;
                                    for c[i] in root.search-playlists: CardView {
                                        x: playlists-found.gap + i * playlists-found.step;
                                        side: playlists-found.side;
                                        card: c;
                                        picture: root.art(c.art, 0, root.covers-rev);
                                        open => { root.open-playlist(c.id); }
                                        play => { root.play-playlist(c.id); }
                                        queue(next) => { root.queue-card(2, c.id, next); }
                                        jam => { root.jam-play(1, c.id); }
                                    }
                                }
                                if root.search-songs.length > 0: HorizontalLayout {
                                    padding-left: 32px;
                                    padding-bottom: 6px;
                                    SectionTitle {
                                        text: "Songs";
                                    }
                                }
                                VerticalLayout {
                                    padding-left: 24px;
                                    padding-right: 24px;
                                    for s[i] in root.search-songs: SongLine {
                                        song: s;
                                        number: i + 1;
                                        thumb: true;
                                        show-album: false;
                                        picture: root.art(s.art, 0, root.covers-rev);
                                        play => { root.song(2, i, -1); }
                                        menu => { return root.song-menu(2, i); }
                                        act(kind, id) => { root.song(2, i, kind); }
                                    }
                                }
                                if root.search-songs-more: HorizontalLayout {
                                    padding-left: 32px;
                                    padding-top: 6px;
                                    alignment: start;
                                    ShowAllButton {
                                        text: root.show-all-text;
                                        clicked => { root.all-songs(2); }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.view == 2 && root.albums-in-rows: Fade {
                    rows-scroll := Remembered {
                        property <int> columns: max(2, floor((self.width - 64px + 22px) / 198px));
                        property <length> side: (self.width - 64px - (self.columns - 1) * 22px) / self.columns;
                        // A shelf's title, its gap, its cards with their words, and the space under it (ShelfView).
                        property <length> row-step: 30px + 10px + self.side + 46px + 44px;
                        property <length> head: Chrome.top-room + 116px;
                        property <int> first: max(0, floor((-self.content-y - self.head) / self.row-step) - 1);
                        property <int> visible-count: max(0, min(root.album-rows.length - self.first, ceil(self.height / self.row-step) + 2));
                        property <int> slots;
                        init => { self.slots = self.visible-count; }
                        changed visible-count => { self.slots = self.visible-count; }
                        content-height: self.head + root.album-rows.length * self.row-step + 100px;
                        Text {
                            x: 32px;
                            y: Chrome.top-room + 8px;
                            text: root.list-name;
                            color: Theme.text;
                            font-family: Type.title;
                            font-size: 34px;
                            font-weight: 700;
                            letter-spacing: -0.5px;
                        }
                        HorizontalLayout {
                            x: 32px;
                            y: Chrome.top-room + 58px;
                            height: 34px;
                            spacing: 8px;
                            for o[i] in root.album-sorts: Chip {
                                text: o;
                                lit: i == root.album-sort;
                                clicked => { root.album-sort-chosen(i); }
                            }
                        }
                        for slot in self.slots: artist-row := ShelfView {
                            property <int> index: rows-scroll.first + slot;
                            property <Shelf> shelf: root.album-rows[self.index];
                            y: rows-scroll.head + self.index * rows-scroll.row-step;
                            width: rows-scroll.width;
                            title: self.shelf.title;
                            count: self.shelf.cards.length;
                            for card-slot in artist-row.slots: CardView {
                                property <int> i: artist-row.first + card-slot;
                                property <Card> c: artist-row.shelf.cards[self.i];
                                x: artist-row.gap + self.i * artist-row.step;
                                side: artist-row.side;
                                card: self.c;
                                picture: root.art(self.c.art, 0, root.covers-rev);
                                open => { root.open-album(self.c.id); }
                                play => { root.play-album(self.c.id); }
                                queue(next) => { root.queue-card(0, self.c.id, next); }
                                jam => { root.jam-play(0, self.c.id); }
                            }
                        }
                    }
                }

                if (root.view == 2 && !root.albums-in-rows) || root.view == 4 || root.view == 10: Fade {
                    push: root.view == 10;
                    Grid {
                        title: root.list-name;
                        orders: root.view == 2 ? root.album-sorts : [];
                        order: root.album-sort;
                        ordered(i) => { root.album-sort-chosen(i); }
                        cards: root.view == 10 ? root.shelves[root.shown-shelf].cards : root.view == 2 ? root.albums : root.playlists;
                        rev: root.covers-rev;
                        art(a, s, r) => { return root.art(a, s, r); }
                        // A shelf's cards open as what each is (a source's feed mixes kinds).
                        open(c) => {
                            if c.kind == 1 {
                                root.open-artist(c.id);
                            } else if c.kind == 3 {
                                root.shelf-song(root.shown-shelf, c.id);
                            } else if (root.view == 2 || root.view == 10) && c.kind == 0 {
                                root.open-album(c.id);
                            } else {
                                root.open-playlist(c.id);
                            }
                        }
                        play(c) => {
                            if c.kind == 3 {
                                root.shelf-song(root.shown-shelf, c.id);
                            } else if c.kind == 1 {
                                root.open-artist(c.id);
                            } else if (root.view == 2 || root.view == 10) && c.kind == 0 {
                                root.play-album(c.id);
                            } else {
                                root.play-playlist(c.id);
                            }
                        }
                        queue(c, next) => { root.queue-card(c.kind, c.id, next); }
                        jam(c) => { root.jam-play((root.view == 2 || root.view == 10) ? 0 : 1, c.id); }
                    }
                }

                if root.view == 11: Fade {
                    push: true;
                    picks-grid := Remembered {
                        property <int> columns: max(2, floor((self.width - 64px + 22px) / 222px));
                        property <length> side: (self.width - 64px - (self.columns - 1) * 22px) / self.columns;
                        content-height: Chrome.top-room + 64px + ceil(root.picks.length / self.columns) * (self.side * 206 / 150 + 22px) + 100px;
                        property <int> first: max(0, floor((-self.content-y - Chrome.top-room - 64px) / (self.side * 206 / 150 + 22px)) - 1) * self.columns;
                        property <int> visible-count: max(0, min(root.picks.length - self.first, (ceil(self.height / (self.side * 206 / 150 + 22px)) + 2) * self.columns));
                        property <int> slots;
                        init => { self.slots = self.visible-count; }
                        changed visible-count => { self.slots = self.visible-count; }
                        Text {
                            x: 32px;
                            y: Chrome.top-room + 8px;
                            text: root.list-name;
                            color: Theme.text;
                            font-family: Type.title;
                            font-size: 34px;
                            font-weight: 700;
                            letter-spacing: -0.5px;
                        }
                        for slot in self.slots: PickCard {
                            property <int> i: picks-grid.first + slot;
                            property <Pick> item: root.picks[self.i];
                            x: 32px + mod(self.i, parent.columns) * (parent.side + 22px);
                            y: Chrome.top-room + 64px + floor(self.i / parent.columns) * (parent.side * 206 / 150 + 22px);
                            side: parent.side;
                            pick: self.item;
                            picture: root.pick-art(self.item.covers, root.covers-rev);
                            open => { root.open-mix(self.item.id); }
                            play => { root.play-mix(self.item.id); }
                            queue(next) => { root.queue-card(4, self.item.id, next); }
                        }
                    }
                }

                // Artists as Music lists them: every artist down the left, the one chosen on the right.
                if root.view == 3: Fade {
                    Text {
                        x: 32px;
                        y: Chrome.top-room + 8px;
                        text: "Artists";
                        color: Theme.text;
                        font-family: Type.title;
                        font-size: 34px;
                        font-weight: 700;
                        letter-spacing: -0.5px;
                    }
                    ListView {
                        x: 0;
                        y: Chrome.top-room + 64px;
                        width: 300px;
                        height: parent.height - self.y;
                        for a in root.artists: Rectangle {
                            height: 52px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Rectangle {
                                    border-radius: 9px;
                                    background: root.artist-chosen == a.id ? Theme.chosen : (ar.has-hover ? Theme.hover : transparent);
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 12px;
                                        Art {
                                            y: (parent.height - self.height) / 2;
                                            width: 38px;
                                            height: 38px;
                                            border-radius: 19px;
                                            source: root.art(a.art, 0, root.covers-rev);
                                        }
                                        Text {
                                            text: a.title;
                                            color: Theme.text;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    ar := TouchArea {
                                        clicked => { root.choose-artist(a.id); }
                                        double-clicked => { root.open-artist(a.id); }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        x: 300px;
                        width: 1px;
                        background: Theme.hairline;
                    }
                    Flickable {
                        x: 301px;
                        y: Chrome.top-room;
                        width: parent.width - 301px;
                        height: parent.height - self.y;
                        content-height: chosen.preferred-height;
                        chosen := VerticalLayout {
                            width: parent.width;
                            padding-left: 30px;
                            padding-right: 30px;
                            padding-top: 16px;
                            padding-bottom: 100px;
                            spacing: 8px;
                            if root.artist-chosen != "": HorizontalLayout {
                                spacing: 8px;
                                // Clear of the page's find field, which floats over this row: 226 px wide, 32 px from
                                // the window's edge, and 12 px apart, less this pane's own 30 px.
                                padding-right: 226px + 32px + 12px - 30px;
                                Text {
                                    text: root.page-title;
                                    color: Theme.text;
                                    font-size: 28px;
                                    font-weight: 700;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                IconButton {
                                    y: (parent.height - self.height) / 2;
                                    glyph: Icons.play-solid;
                                    ink: Theme.plate-ink;
                                    base: Theme.plate;
                                    size: 32px;
                                    icon: 15px;
                                    clicked => { root.play-page(false); }
                                }
                                IconButton {
                                    y: (parent.height - self.height) / 2;
                                    glyph: Icons.shuffle;
                                    ink: Theme.plate-ink;
                                    base: Theme.plate;
                                    size: 32px;
                                    icon: 15px;
                                    clicked => { root.play-page(true); }
                                }
                            }
                            if root.artist-chosen != "": Text {
                                text: root.page-caption;
                                color: Theme.dim;
                                font-size: 12px;
                                font-weight: 600;
                            }
                            if root.artist-chosen != "": Rectangle {
                                height: 1px;
                                background: Theme.hairline;
                            }
                            if root.artist-chosen != "": ReleaseShelves {
                                shelves: root.page-shelves;
                                rev: root.covers-rev;
                                art(a, s, r) => { return root.art(a, s, r); }
                                open(c) => { root.open-album(c.id); }
                                play(c) => { root.play-album(c.id); }
                                queue(c, next) => { root.queue-card(0, c.id, next); }
                                jam(c) => { root.jam-play(0, c.id); }
                            }
                        }
                    }
                }

                if root.view == 5 || root.view == 12: Fade {
                    VerticalLayout {
                        Heading {
                            title: root.view == 12 ? "Favorites" : "Songs";
                        }
                        HorizontalLayout {
                            padding-left: 24px;
                            padding-right: 16px;
                            SongHeads {
                                height: 28px;
                                opacity: root.songs.length > 0 ? 1 : 0;
                            }
                        }
                        HorizontalLayout {
                            vertical-stretch: 1;
                            padding-left: 24px;
                            padding-right: 16px;
                            ListView {
                                // The next page is asked for as the end comes within a screen, or when the rows
                                // do not fill the list.
                                function near-end() {
                                    if root.more-songs && self.content-height + self.content-y < self.visible-height * 2 {
                                        root.more();
                                    }
                                }
                                changed content-y => { self.near-end(); }
                                changed content-height => { self.near-end(); }
                                for s[i] in root.songs: SongLine {
                                    song: s;
                                    number: i + 1;
                                    table: true;
                                    thumb: true;
                                    picture: root.art(s.art, 0, root.covers-rev);
                                    play => { root.song(1, i, -1); }
                                    menu => { return root.song-menu(1, i); }
                                    act(kind, id) => { root.song(1, i, kind); }
                                }
                            }
                        }
                    }
                }

                // An album, an artist, a playlist or a mix, as iOS 27 draws its artist pages: the picture dissolves
                // into the page, and the page wears the season's paper dyed with it.
                if root.view == 6: Fade {
                    push: true;
                    Rectangle {
                        // The cover's own wash across the top, running out into the page's dyed paper, as Android's
                        // page lets its cover melt into it. Inside the page, which is opaque while it slides in.
                        Image {
                            y: 0;
                            width: 100%;
                            height: 440px;
                            visible: root.covers-tint;
                            source: root.page-wash;
                            image-fit: fill;
                        }
                        Rectangle {
                            y: 0;
                            height: 440px;
                            background: @linear-gradient(180deg, Theme.ground.with-alpha(0.15) 0%, Theme.ground.with-alpha(0.55) 55%, Theme.ground 100%);
                        }
                        // An artist: the picture across the page's whole width, drifting up slower than the page
                        // as it scrolls, and dissolving into the page's colour.
                        if root.page-kind == 1: Rectangle {
                            y: max(-self.height, page-flick.content-y * 0.45);
                            width: parent.width;
                            height: max(420px, root.height * 0.64);
                            opacity: 1 + max(-0.8, page-flick.content-y / self.height);
                            clip: true;
                            Image {
                                width: 100%;
                                height: 100%;
                                source: root.art(root.page-art, 2, root.covers-rev);
                                image-fit: cover;
                                opacity: self.source.width > 0 ? 1 : 0;
                                animate opacity { duration: Motion.reduced ? 0ms : 400ms; easing: ease-out; }
                            }
                            Rectangle {
                                background: @linear-gradient(180deg, Theme.ground.with-alpha(0) 0%, Theme.ground.with-alpha(0) 45%, Theme.ground.with-alpha(0.7) 78%, Theme.ground 100%);
                            }
                        }

                        page-flick := Remembered {
                            // Up and down only: a long title or row is cut to the page, never scrolled sideways.
                            content-width: self.width;
                            content-height: detail.preferred-height;
                            detail := VerticalLayout {
                                width: parent.width;
                                padding-left: 32px;
                                padding-right: 32px;
                                padding-top: Chrome.top-room + 8px;
                                padding-bottom: 100px;
                                spacing: 26px;
                                // An artist: the name and the play button over the bottom of the picture.
                                if root.page-kind == 1: VerticalLayout {
                                    spacing: 16px;
                                    Rectangle {
                                        height: max(420px, root.height * 0.64) - Chrome.top-room - 8px - 170px;
                                    }
                                    Text {
                                        text: root.page-title;
                                        color: Theme.text;
                                        font-family: Type.title;
                                        font-size: 44px;
                                        font-weight: 800;
                                        letter-spacing: -1px;
                                        horizontal-alignment: center;
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        PageActions {
                                            seal: root.page-can-star;
                                            liked: root.page-starred;
                                            shuffle-lit: root.page-shuffle-lit;
                                            pausing: root.page-pausing;
                                            can-save: root.page-can-save;
                                            play(shuffle) => { root.play-page(shuffle); }
                                            star => { root.page-star(); }
                                            save => { root.page-save(); }
                                        }
                                    }
                                }
                                // An album, a playlist or a mix: the artwork beside its title, as the Mac lays them out;
                                // a mix's four covers two by two.
                                if root.page-kind != 1: HorizontalLayout {
                                    spacing: 28px;
                                    alignment: start;
                                    Art {
                                        width: 270px;
                                        height: 270px;
                                        border-radius: 8px;
                                        source: root.page-covers.length >= 4 ? root.pick-art(root.page-covers, root.covers-rev) : root.art(root.page-art, 1, root.covers-rev);
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Rectangle {
                                            height: 64px;
                                        }
                                        Text {
                                            text: root.page-title;
                                            color: Theme.text;
                                            font-family: Type.title;
                                            font-size: 30px;
                                            font-weight: 700;
                                            letter-spacing: -0.3px;
                                            wrap: word-wrap;
                                        }
                                        if root.page-sub != "": Link {
                                            text: root.page-sub;
                                            artist: root.page-sub-artist;
                                            color: Theme.text;
                                            font-size: 20px;
                                            font-weight: 500;
                                            wrap: word-wrap;
                                        }
                                        Rectangle {
                                            vertical-stretch: 1;
                                        }
                                        PageActions {
                                            alignment: start;
                                            seal: root.page-can-star && root.page-kind == 0;
                                            liked: root.page-starred;
                                            shuffle-lit: root.page-shuffle-lit;
                                            pausing: root.page-pausing;
                                            can-save: root.page-can-save;
                                            play(shuffle) => { root.play-page(shuffle); }
                                            star => { root.page-star(); }
                                            save => { root.page-save(); }
                                        }
                                    }
                                }
                                // The list's head: what it is ("2019 · 8 songs · 36:28 · FLAC") and the core's glyphs for
                                // its songs (`page_actions`), a hairline under.
                                VerticalLayout {
                                    HorizontalLayout {
                                        height: 48px;
                                        spacing: 2px;
                                        Text {
                                            horizontal-stretch: 1;
                                            text: root.page-caption;
                                            color: Theme.dim;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        for a in root.page-acts: IconButton {
                                            y: (parent.height - self.height) / 2;
                                            glyph: a == 2 ? Icons.check-circle : a == 4 ? Icons.playlist : a == 5 ? Icons.refresh : Icons.download;
                                            quiet: true;
                                            size: 44px;
                                            icon: 24px;
                                            clicked => { root.page-act(a); }
                                        }
                                    }
                                    Rectangle {
                                        height: 1px;
                                        background: Theme.hairline;
                                    }
                                }
                                if root.page-kind == 1: ReleaseShelves {
                                    shelves: root.page-shelves;
                                    titled: true;
                                    rev: root.covers-rev;
                                    art(a, s, r) => { return root.art(a, s, r); }
                                    open(c) => { root.open-album(c.id); }
                                    play(c) => { root.play-album(c.id); }
                                    queue(c, next) => { root.queue-card(0, c.id, next); }
                                    jam(c) => { root.jam-play(0, c.id); }
                                }
                                if root.page-kind == 1 && root.page-songs.length > 0: SectionTitle {
                                    text: "Songs";
                                }
                                // Only the rows on screen (and a few either side) are made: a playlist of thousands
                                // opens as fast as one of ten.
                                song-rows := Rectangle {
                                    // A playlist's and an artist's songs come from many albums: each row shows its cover and album.
                                    property <bool> mixed: root.page-kind != 0;
                                    property <length> row-h: self.mixed ? 56px : 44px;
                                    // Their column heads, right over the rows.
                                    property <length> head: self.mixed && root.page-songs.length > 0 ? 28px : 0;
                                    property <length> seen-from: -page-flick.content-y - self.y - self.head - 400px;
                                    property <length> seen-to: -page-flick.content-y - self.y - self.head + page-flick.height + 400px;
                                    height: self.head + root.page-songs.length * self.row-h;
                                    if song-rows.head > 0: SongHeads {
                                        y: 0;
                                        height: song-rows.head;
                                    }
                                    for s[i] in root.page-songs: Rectangle {
                                        y: song-rows.head + i * song-rows.row-h;
                                        height: song-rows.row-h;
                                        if (i + 1) * song-rows.row-h > song-rows.seen-from && i * song-rows.row-h < song-rows.seen-to: SongLine {
                                            width: parent.width;
                                            song: s;
                                            number: s.index + 1;
                                            table: song-rows.mixed;
                                            show-album: song-rows.mixed;
                                            thumb: song-rows.mixed;
                                            picture: song-rows.mixed ? root.art(s.art, 0, root.covers-rev) : root.art("", 0, 0);
                                            menu-picture: root.art(s.art, 0, root.covers-rev);
                                            play => { root.song(0, s.index, -1); }
                                            menu => { return root.song-menu(0, s.index); }
                                            act(kind, id) => { root.song(0, s.index, kind); }
                                        }
                                    }
                                }
                                if root.page-songs-more: HorizontalLayout {
                                    alignment: start;
                                    ShowAllButton {
                                        text: root.show-all-text;
                                        clicked => { root.all-songs(0); }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.view == 8: Fade {
                    Flickable {
                        // A mouse's press and drag is the lyrics services' handles'; the wheel and touch still scroll.
                        mouse-drag-pan-enabled: false;
                        content-height: prefs.preferred-height;
                        prefs := VerticalLayout {
                            width: parent.width;
                            padding-bottom: 100px;
                            // The title, then the tabs and the column at one reading width under the top pill.
                            Text {
                                text: "Settings";
                                color: Theme.text;
                                font-family: Type.title;
                                font-size: 34px;
                                font-weight: 700;
                                letter-spacing: -0.5px;
                                horizontal-alignment: center;
                                height: Chrome.top-room + 52px;
                                vertical-alignment: bottom;
                            }
                            HorizontalLayout {
                                padding-left: Chrome.top-x + max(0px, Chrome.top-w - 720px) / 2;
                                padding-right: max(0px, root.width - Chrome.top-x - Chrome.top-w) + max(0px, Chrome.top-w - 720px) / 2;
                                padding-top: 16px;
                                padding-bottom: 12px;
                                // The categories in Android's order and words, as chips; the one shown raised.
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    for t[i] in root.settings-tabs: Chip {
                                        text: t;
                                        lit: i == root.settings-tab;
                                        clicked => { root.settings-tab-chosen(i); }
                                    }
                                }
                            }
                            HorizontalLayout {
                                padding-left: Chrome.top-x + max(0px, Chrome.top-w - 720px) / 2;
                                padding-right: max(0px, root.width - Chrome.top-x - Chrome.top-w) + max(0px, Chrome.top-w - 720px) / 2;
                                VerticalLayout {
                                    for r in root.settings: SettingLine {
                                        item: r;
                                        toggled(name, on) => { root.setting-toggled(name, on); }
                                        chosen(name, i) => { root.setting-chosen(name, i); }
                                        action(name) => { root.setting-action(name); }
                                        slid(name, v, last) => { root.setting-slid(name, v, last); }
                                        typed(name, text) => { root.setting-typed(name, text); }
                                        placed(id, by) => { root.source-moved(id, by); }
                                        ask-key(id, title, set) => {
                                            root.key-service = id;
                                            root.key-title = title;
                                            root.key-set = set;
                                            root.key-text = "";
                                            root.key-open = true;
                                        }
                                        source(id, on) => { root.setting-toggled("lyricsService:" + id, on); }
                                    }
                                }
                            }
                        }
                    }
                }


                // The equalizer, as the Android app's: the switch, graphic or parametric, the bands, the presets,
                // the pre-amp, then the output.
                if root.view == 9: Fade {
                    EqualizerPage {
                        on: root.eq-on;
                        graphic: root.eq-graphic;
                        count: root.eq-count;
                        bands: root.eq-bands;
                        curve: root.eq-curve;
                        presets: root.eq-presets;
                        auto-preamp: root.eq-auto-preamp;
                        preamp: root.eq-preamp;
                        preamp-label: root.eq-preamp-label;
                        balance: root.eq-balance;
                        balance-label: root.eq-balance-label;
                        mono: root.eq-mono;
                        limiter: root.eq-limiter;
                        ceiling: root.eq-ceiling;
                        ceiling-label: root.eq-ceiling-label;
                        bypass: root.eq-bypass;
                        ranges: root.eq-ranges;
                        autoeq-count: root.eq-autoeq-count;
                        autoeq-search-words: root.eq-autoeq-search-words;
                        autoeq-hits: root.eq-autoeq-hits;
                        autoeq-for: root.eq-autoeq-for;
                        autoeq-note: root.eq-autoeq-note;
                        autoeq-busy: root.eq-autoeq-busy;
                        profiles: root.eq-profiles;
                        autoeq-search(q) => { root.eq-autoeq-search(q); }
                        autoeq-pick(i) => { root.eq-autoeq-pick(i); }
                        autoeq-download => { root.eq-autoeq-download(); }
                        profile-apply(i) => { root.eq-profile-apply(i); }
                        profile-delete(i) => { root.eq-profile-delete(i); }
                        profile-save(name) => { root.eq-profile-save(name); }
                        back => { root.go(8); }
                        set(name, value) => { root.eq-set(name, value); }
                        level(name, v, last) => { root.setting-slid(name, v, last); }
                        gain(i, v, last) => { root.eq-gain(i, v, last); }
                        tool(name, i) => { root.eq-tool(name, i); }
                        sized(w, h) => { root.eq-sized(w, h); }
                    }
                }

                // Said only when the read takes a moment, then faded in: a page that comes at once never shows it.
                if root.loading: Text {
                    property <bool> said;
                    text: "Loading…";
                    color: Theme.dim;
                    opacity: self.said ? 1 : 0;
                    animate opacity { duration: Motion.reduced ? 0ms : 180ms; easing: ease-out; }
                    Timer {
                        interval: 400ms;
                        running: !parent.said;
                        triggered => { parent.said = true; }
                    }
                }
                // A list that came back empty, or that the filter left nothing of.
                if !root.loading && root.failed == "" && root.list-empty: EmptyNote {
                    x: root.view == 3 ? 300px + (parent.width - 300px) * 0.15 : parent.width * 0.2;
                    width: root.view == 3 ? (parent.width - 300px) * 0.7 : parent.width * 0.6;
                    icon: root.find-text != "" ? Icons.search : root.view == 2 ? Icons.compact-disc : root.view == 3 ? Icons.user : root.view == 4 ? Icons.playlist : root.view == 12 ? Icons.seal-outline : Icons.music-note;
                    title: root.find-text != "" ? "Nothing matches" : root.view == 2 ? "No albums" : root.view == 3 ? "No artists" : root.view == 4 ? "No playlists" : root.view == 12 ? "No favorites" : "No songs";
                    line: root.find-text != "" ? "Nothing here has “" + root.find-text + "” in its name." : root.view == 12 ? "Songs you mark with the seal gather here." : root.view == 4 ? "Playlists you make or save gather here." : "Your library has none yet.";
                }
                if root.failed != "" && !root.loading: Text {
                    width: 60%;
                    text: root.failed;
                    color: Theme.dim;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                TitleStrip {
                    y: 0;
                    width: parent.width;
                    drag => { root.drag-window(); }
                    zoom => { root.zoom-window(); }
                }

                // Back, on a page that was opened from another: a disc under the top pill's left, where Android
                // has its arrow.
                if root.view == 6 || root.view == 10 || root.view == 11: Rectangle {
                    x: 20px;
                    y: Chrome.top-room + 6px;
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: Theme.ground.with-alpha(0.7);
                    border-width: 1px;
                    border-color: Theme.outline;
                    IconButton {
                        glyph: Icons.arrow-left;
                        size: 40px;
                        clicked => { root.back(); }
                    }
                }
                // A field that narrows what the page lists.
                if root.list-name != "" && root.view < 6 && root.view != 1: Field {
                    x: parent.width - self.width - 32px;
                    y: Chrome.top-room + 14px;
                    width: 226px;
                    height: 36px;
                    border-radius: 18px;
                    icon: Icons.search;
                    placeholder: "Find in " + root.list-name;
                    text <=> root.find-text;
                    edited(t) => { root.find-edited(t); }
                }
                // A note for a few seconds, over the page's top.
                Glass {
                    x: (parent.width - self.width) / 2;
                    y: root.note != "" ? Chrome.top-room : -50px;
                    animate y { duration: Motion.reduced ? 0ms : 260ms; easing: ease-out; }
                    width: min(parent.width - 40px, toast.preferred-width + 32px);
                    height: 32px;
                    radius: 16px;
                    toast := HorizontalLayout {
                        alignment: center;
                        spacing: 14px;
                        Text {
                            text: root.note;
                            color: root.note-error ? Theme.danger : Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if root.note-action != "": Text {
                            text: root.note-action;
                            color: Theme.accent;
                            font-weight: 600;
                            vertical-alignment: center;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.note-act(); }
                            }
                        }
                    }
                }
            }

            // The sheet on the right, floating between the two pills over the page (which stays where it is): the
            // lyrics sung line by line, what plays next, or the other devices, under their tabs. It wears the
            // page's own colour, as the player pill does, never the song's colours.
            Rectangle {
                width: Theme.panel-w;
                x: parent.width - self.width - 16px + (1 - root.panel-in) * 24px;
                y: Chrome.top-room - 8px;
                height: parent.height - self.y - Chrome.bottom-room + 12px;
                visible: root.panel-in > 0;
                opacity: root.panel-in;
                border-radius: 22px;
                border-width: 1px;
                border-color: Theme.outline;
                background: Theme.ground;
                clip: true;
                // Presses and scrolls on the sheet's own ground stay on it, rather than reaching the page under it.
                TouchArea {
                    scroll-event(e) => { accept }
                }
                PanelTabs {
                    x: 10px;
                    y: 10px;
                    current: root.shown-panel;
                    devices: root.devices-on;
                    picked(p) => { root.inspector = root.inspector == p ? 0 : p; }
                }
                // Under the tabs, the panel showing.
                if root.shown-panel == 2 && (root.lyrics-lines.length == 0 || root.lyrics-waiting): Text {
                    y: 56px;
                    height: 120px;
                    x: 24px;
                    width: parent.width - 48px;
                    text: root.lyrics-note != "" ? root.lyrics-note : "No lyrics";
                    opacity: root.lyrics-note-shown;
                    animate opacity { duration: Motion.reduced ? 0ms : 180ms; easing: ease-out; }
                    color: Theme.dim;
                    font-size: 15px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if root.shown-panel == 2 && root.lyrics-lines.length > 0: lyric-flick := Flickable {
                    // A song's lyrics fade in, and out while the next song's are looked for: the last song's
                    // words stay until then, so a change of song never jumps.
                    property <bool> came;
                    opacity: self.came && !root.lyrics-waiting ? 1 : 0;
                    animate opacity { duration: Motion.reduced ? 0ms : 200ms; easing: ease-out; }
                    init => { self.came = true; }
                    y: 56px;
                    height: parent.height - 56px;
                    // As tall as where the last line ends, as laid out: the layout's own sum counts a wrapped line
                    // as one row, and long lyrics stopped scrolling before their end.
                    property <length> end;
                    content-height: max(sung.preferred-height, self.end + self.height * 2 / 3);
                    // A new song's lyrics start from their top, gliding there from where the last song's were.
                    property <bool> waiting: root.lyrics-waiting;
                    changed waiting => {
                        if !self.waiting {
                            self.content-y = 0;
                        }
                    }
                    animate content-y { duration: Motion.reduced ? 0ms : 560ms; easing: cubic-bezier(0.25, 0.8, 0.3, 1); }
                    // The line being sung rests a third of the way down, as on Android: the words start there and can
                    // run on until the last line is there too, clear of the fades at either edge.
                    sung := VerticalLayout {
                        width: parent.width;
                        padding-left: 22px;
                        padding-right: 22px;
                        padding-top: lyric-flick.height / 3;
                        padding-bottom: lyric-flick.height * 2 / 3;
                        spacing: 22px;
                        for line[i] in root.lyrics-lines: Text {
                            property <bool> lit: i == root.lyrics-active;
                            property <length> bottom: i == root.lyrics-lines.length - 1 ? self.y + self.height : 0;
                            changed bottom => {
                                if self.bottom > 0 {
                                    lyric-flick.end = self.bottom;
                                }
                            }
                            changed height => {
                                if self.bottom > 0 {
                                    lyric-flick.end = self.bottom;
                                }
                            }
                            // How lit the line is, fading as it changes: set when it changes (a change handler
                            // runs whether or not the line is drawn just then), so a line sung fades from white.
                            property <float> level;
                            animate level { duration: Motion.reduced ? 0ms : 420ms; easing: ease-out; }
                            // Scrolled to when lit, and when the lyrics come in with this line already sung.
                            changed lit => {
                                self.level = self.lit ? 1 : 0;
                                if self.lit {
                                    lyric-flick.content-y = -max(0, self.y - lyric-flick.height / 3);
                                }
                            }
                            init => {
                                self.level = self.lit ? 1 : 0;
                                if self.lit {
                                    lyric-flick.content-y = -max(0, self.y - lyric-flick.height / 3);
                                }
                            }
                            // Laid out after init when the panel opens, and again when a resize wraps the lines.
                            changed y => {
                                if self.lit {
                                    lyric-flick.content-y = -max(0, self.y - lyric-flick.height / 3);
                                }
                            }
                            // With word times the lit line is drawn by its pieces over this text, which keeps its place;
                            // a line sung fades from white as the others do.
                            text: root.lyrics-side-rows.length > i ? root.lyrics-side-rows[i] : line;
                            wrap: word-wrap;
                            font-size: 22px;
                            font-weight: 700;
                            // As Now Playing's: gone over the last 48 px before either edge, unsung lines the ink at 36 %.
                            property <length> shown-at: self.y + lyric-flick.content-y;
                            opacity: clamp(self.shown-at / 48px, 0, 1) * clamp((lyric-flick.height - self.shown-at - self.height) / 48px, 0, 1);
                            color: !root.lyric-sweeping ? (!root.lyrics-synced || self.lit ? Theme.text : Theme.text.with-alpha(0.36))
                                : self.lit ? transparent : Theme.text.with-alpha(0.36 + (1 - 0.36) * self.level);
                            animate color { duration: root.lyric-sweeping || Motion.reduced ? 0ms : 420ms; easing: ease-out; }
                            // The lit line filling without pieces to draw it (no face to measure in).
                            if root.lyric-sweeping && self.lit && root.lyric-pieces-side.length == 0: StyledText {
                                width: 100%;
                                height: 100%;
                                default-font-size: 22px;
                                default-color: Theme.text.with-alpha(0.36 + (1 - 0.36) * parent.level);
                                text: parent.lit ? @markdown("**\{root.lyric-sung}<font color=\"\{Theme.text.with-alpha(0.36 + 0.64 * root.lyric-mix)}\">\{root.lyric-now}</font><font color=\"\{Theme.text.with-alpha(0.36)}\">\{root.lyric-rest}</font>**") : @markdown("**\{line}**");
                            }
                            if self.lit && root.lyric-sweeping && root.lyric-pieces-side.length > 0: Rectangle {
                                width: 100%;
                                height: 100%;
                                for p in root.lyric-pieces-side: Text {
                                    x: p.x * 1px;
                                    y: p.y * 1px - p.lift * 2px;
                                    width: p.w * 1px;
                                    text: p.text;
                                    wrap: no-wrap;
                                    font-size: 22px;
                                    font-weight: 700;
                                    color: @linear-gradient(90deg, Theme.text.with-alpha(p.a0) 0%, Theme.text.with-alpha(p.aa) p.a * 100%, Theme.text.with-alpha(p.ab) p.b * 100%, Theme.text.with-alpha(p.a1) 100%);
                                    transform-scale-x: (1 + 0.04 * p.swell) * 100%;
                                    transform-scale-y: (1 + 0.04 * p.swell) * 100%;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.lyric-tapped(i); }
                            }
                        }
                        if root.lyrics-note != "": Text {
                            text: root.lyrics-note;
                            color: Theme.faint;
                            font-size: 11px;
                        }
                    }
                }
                if root.shown-panel == 3: DevicesView {
                    y: 56px;
                    height: parent.height - 56px;
                    devices: root.devices;
                    pairing-link: root.pairing-link;
                    forget-devices => { root.forget-devices(); }
                    pick(id) => { root.pick-device(id); }
                    open-jam => { root.inspector = 1; }
                    join-jam => { root.join-open = true; }
                    show-pairing => { root.pairing-open = true; }
                }
                if root.shown-panel == 1 && root.panel-in > 0: QueueView {
                    y: 56px;
                    height: parent.height - 56px;
                    queue: root.queue;
                    from: root.queue-from;
                    covers-rev: root.covers-rev;
                    editable: !Jam.guest;
                    movable: !root.shuffle;
                    undo-text: root.queue-undo;
                    art(a, s, r) => { return root.art(a, s, r); }
                    jump(i) => { root.jump(i); }
                    clear => { root.clear-queue(); }
                    remove(i) => { root.remove-queued(i); }
                    move(f, t) => { root.move-queued(f, t); }
                    undo => { root.undo-removed(); }
                }
            }

        }

        // The player pill's menus, which open above it: the song playing's, and the sleep timer's.
        player-pop := PopupWindow {
            x: Chrome.player-x + Chrome.player-w - 12px - self.width;
            y: root.height - Chrome.bottom-room - self.height;
            width: MenuShape.width;
            close-policy: close-on-click-outside;
            SongMenuBody {
                picture: root.art(root.now-art, 0, root.covers-rev);
                title: root.now-title;
                line: root.now-album != "" ? root.now-artist + " · " + root.now-album : root.now-artist;
                lines: root.player-lines;
                // The menu closes after: closed, it can no longer reach the window.
                chosen(m) => {
                    if m.kind == 1 {
                        Go.album(m.id);
                    } else if m.kind == 2 {
                        Go.artist(m.id);
                    } else {
                        root.player-act(m.kind, m.id);
                    }
                    player-pop.close();
                }
            }
        }
        sleep-pop := PopupWindow {
            x: Chrome.player-x + Chrome.player-w - 12px - self.width;
            y: root.height - Chrome.bottom-room - self.height;
            width: MenuShape.width;
            close-policy: close-on-click-outside;
            // The sleep timer's choices, a list of values rather than of actions, are left plain.
            Popover {
                VerticalLayout {
                    padding: MenuShape.inset;
                    Text {
                        height: MenuShape.row;
                        x: 8px;
                        text: "Sleep timer";
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.hairline;
                    }
                    MenuGroup {
                        for c[i] in root.sleep-choices: MenuLine {
                            text: c;
                            divider: i < root.sleep-choices.length - 1;
                            clicked => {
                                root.sleep(i);
                                sleep-pop.close();
                            }
                        }
                    }
                }
            }
        }

        // The top pill's menus, which open under it: the settings', and the playlists'.
        gear := PopupWindow {
            x: Chrome.top-x + Chrome.top-w - self.width;
            y: Chrome.top-room - 12px;
            width: 300px;
            close-policy: close-on-click-outside;
            Popover {
                VerticalLayout {
                    padding: MenuShape.inset;
                    spacing: 2px;
                    Rectangle {
                        height: 52px;
                        border-radius: MenuShape.inner;
                        background: ac.has-hover ? Theme.hover : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 12px;
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 34px;
                                height: 34px;
                                border-radius: 17px;
                                background: Theme.chosen;
                                Text {
                                    text: root.account-initial;
                                    font-weight: 600;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.account;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                if root.server != "": Text {
                                    text: root.server;
                                    color: Theme.dim;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                        }
                        ac := TouchArea {
                            clicked => {
                                gear.close();
                                root.open-accounts();
                            }
                        }
                    }
                    Rectangle {
                        height: 9px;
                        Rectangle {
                            height: 1px;
                            background: Theme.hairline;
                        }
                    }
                    MenuRow {
                        icon: Icons.control-slider;
                        text: "Equalizer";
                        clicked => {
                            gear.close();
                            root.go(9);
                        }
                    }
                    MenuRow {
                        icon: Icons.settings;
                        text: "Settings";
                        clicked => {
                            gear.close();
                            root.go(8);
                        }
                    }
                    Rectangle {
                        height: 9px;
                        Rectangle {
                            height: 1px;
                            background: Theme.hairline;
                        }
                    }
                    SeasonTiles {
                        options: ["Spring", "Summer", "Autumn", "Winter"];
                        chosen: root.season-worn;
                        tile-height: 60px;
                        picked(i) => { root.setting-chosen("season", i); }
                    }
                    ToggleLine {
                        padding-top: 6px;
                        padding-bottom: 10px;
                        title: "Follow the calendar";
                        detail: root.season-detail;
                        on: root.season-following;
                        toggled(on) => { root.setting-toggled(root.season-switch, on); }
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 4px;
                        for o[i] in ["System", "Day", "Night", "Midnight"]: Chip {
                            text: o;
                            lit: i == root.appearance-pick;
                            clicked => { root.setting-chosen("appearance", i); }
                        }
                    }
                }
            }
        }
        // ---- Now Playing, over the whole window, as Music has it ----
        // The song's own colours behind everything; the artwork and the controls on the left; on the right the
        // lyrics (the line sung sharp, the rest soft: the compositor blurs them, glass.wgsl) or what plays next.

        full-screen := Rectangle {
            opacity: root.full-player ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity { duration: Motion.reduced ? 0ms : 300ms; easing: ease-out; }
            background: Theme.ground;
            Image {
                width: 100%;
                height: 100%;
                source: root.wash-a;
                image-fit: cover;
                visible: root.covers-tint;
                opacity: root.wash-on-b ? 0 : 1;
                animate opacity { duration: Motion.reduced ? 0ms : 800ms; easing: ease-in-out; }
            }
            Image {
                width: 100%;
                height: 100%;
                source: root.wash-b;
                image-fit: cover;
                visible: root.covers-tint;
                opacity: root.wash-on-b ? 1 : 0;
                animate opacity { duration: Motion.reduced ? 0ms : 800ms; easing: ease-in-out; }
            }
            // Swallows the clicks meant for the page underneath.
            TouchArea { }
            TitleStrip {
                y: 0;
                drag => { root.drag-window(); }
                zoom => { root.zoom-window(); }
            }
            // Back to the window: a disc level with the traffic lights, or in the corner without them.
            Rectangle {
                x: root.traffic-lights ? 84px : 8px;
                y: 8px;
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: Theme.ground.with-alpha(0.6);
                border-width: 1px;
                border-color: Theme.outline;
                IconButton {
                    glyph: Icons.nav-arrow-down;
                    size: 36px;
                    clicked => { root.full-player = false; }
                }
            }

            // The artwork and the controls: centred in the window with nothing beside them, in the left half
            // with the lyrics or the queue.
            property <length> side: min(460px, root.height - 330px, (root.full-panel != 0 ? root.width / 2 : root.width) - 120px);
            property <float> art-centre: root.full-panel != 0 ? 0.25 : 0.5;
            animate art-centre { duration: Motion.reduced ? 0ms : 380ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
            property <length> art-rise: root.full-player ? 0px : 30px;
            animate art-rise { duration: Motion.reduced ? 0ms : 420ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
            full-art := VerticalLayout {
                x: root.width * parent.art-centre - parent.side / 2;
                y: (root.height - self.preferred-height) / 2 + parent.art-rise;
                width: parent.side;
                height: self.preferred-height;
                spacing: 0;
                Art {
                    width: parent.width;
                    height: self.width;
                    border-radius: 8px;
                    source: root.art(root.now-art, 1, root.covers-rev);
                    transform-scale: root.playing ? 1 : 0.9;
                    animate transform-scale { duration: Motion.reduced ? 0ms : 500ms; easing: cubic-bezier(0.3, 1.35, 0.6, 1); }
                }
                Rectangle {
                    height: 26px;
                }
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                horizontal-stretch: 1;
                                text: root.now-title;
                                color: Theme.text;
                                font-size: 16px;
                                font-weight: 600;
                                overflow: elide;
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            ArtistLine {
                                max-width: self.preferred-width;
                                // The artists before the album, which elides first.
                                horizontal-stretch: 0;
                                text: root.now-artist;
                                artist: root.now-artist-id;
                                credits: root.now-credits;
                                color: Theme.text;
                                font-size: 14px;
                            }
                            if root.now-album != "": Text {
                                text: " — ";
                                color: Theme.text;
                                font-size: 14px;
                            }
                            if root.now-album != "": Link {
                                horizontal-stretch: 1;
                                text: root.now-album;
                                album: root.now-album-id;
                                color: Theme.text;
                                font-size: 14px;
                                overflow: elide;
                            }
                        }
                        if root.playing-on != "": HorizontalLayout {
                            padding-top: 6px;
                            spacing: 5px;
                            alignment: start;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                glyph: Output.shown;
                                colour: Theme.text;
                                width: 15px;
                                height: 15px;
                            }
                            Text {
                                text: root.playing-on;
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.full-player = false;
                                        root.inspector = 3;
                                    }
                                }
                            }
                        }
                    }
                    if !Jam.guest: Seal {
                        y: 0px;
                        liked: root.now-starred;
                        size: 28px;
                        clicked => { root.star(); }
                    }
                }
                Rectangle {
                    height: 20px;
                }
                if root.live: Text {
                    height: 14px;
                    text: "Live";
                    color: Theme.accent;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                if !root.live: Rectangle {
                    height: 14px;
                    property <int> dragged: -1;
                    Bar {
                        width: 100%;
                        thin: 5px;
                        thick: 8px;
                        fill: Theme.text;
                        track: Theme.faint;
                        value: root.duration-ms > 0 ? (parent.dragged >= 0 ? parent.dragged : root.display-position-ms) / root.duration-ms : 0;
                        progress: true;
                        settling: 250ms;
                        moved(v) => { parent.dragged = v * root.duration-ms; }
                        done(v) => {
                            parent.dragged = -1;
                            root.seek(v);
                        }
                    }
                }
                if !root.live: HorizontalLayout {
                    padding-top: 4px;
                    Text {
                        text: root.clock(root.display-position-ms);
                        color: Theme.dim;
                        font-size: 10px;
                    }
                    Text {
                        text: root.mixing-label;
                        color: Theme.dim;
                        font-size: 10px;
                        font-weight: 600;
                        letter-spacing: 1.4px;
                        horizontal-alignment: center;
                        opacity: root.mixing ? 1 : 0;
                        animate opacity { duration: Motion.reduced ? 0ms : 360ms; }
                    }
                    Text {
                        text: "-" + root.clock(root.duration-ms - root.display-position-ms);
                        color: Theme.dim;
                        font-size: 10px;
                        horizontal-alignment: right;
                    }
                }
                Rectangle {
                    height: 16px;
                }
                HorizontalLayout {
                    alignment: space-between;
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        glyph: Icons.shuffle;
                        lit: root.shuffle;
                        ink: Theme.text;
                        icon: 19px;
                        size: 36px;
                        clicked => { root.toggle-shuffle(); }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        glyph: Icons.rewind-solid;
                        ink: Theme.text;
                        size: 50px;
                        icon: 34px;
                        clicked => { root.previous(); }
                    }
                    PlayPause {
                        y: (parent.height - self.height) / 2;
                        playing: root.playing;
                        waiting: root.buffering;
                        size: 76px;
                        icon: 52px;
                        clicked => { root.toggle(); }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        glyph: Icons.forward-solid;
                        ink: Theme.text;
                        size: 50px;
                        icon: 34px;
                        clicked => { root.next(); }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        glyph: root.repeat == 1 ? Icons.repeat-once : Icons.repeat;
                        lit: root.repeat != 0;
                        ink: Theme.text;
                        icon: 19px;
                        size: 36px;
                        clicked => { root.cycle-repeat(); }
                    }
                }
                Rectangle {
                    height: 14px;
                }
                if !Jam.guest: HorizontalLayout {
                    spacing: 10px;
                    height: 24px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        glyph: Icons.sound-low;
                        colour: Theme.dim;
                        width: 20px;
                        height: 20px;
                    }
                    Bar {
                        y: (parent.height - self.height) / 2;
                        horizontal-stretch: 1;
                        thin: 5px;
                        thick: 7px;
                        fill: Theme.text;
                        track: Theme.chosen;
                        value: root.volume;
                        moved(v) => { root.set-volume(v); }
                        done(v) => { root.set-volume(v); }
                    }
                    Icon {
                        y: (parent.height - self.height) / 2;
                        glyph: Icons.sound-high;
                        colour: Theme.dim;
                        width: 20px;
                        height: 20px;
                    }
                }
            }

            // The lyrics: big, the line sung at a fixed height and sharp, the rest soft and dim.
            if root.full-panel == 2 && (root.lyrics-lines.length == 0 || root.lyrics-waiting): Text {
                x: root.width / 2 + 20px;
                width: root.width / 2 - 100px;
                text: root.lyrics-note != "" ? root.lyrics-note : "No lyrics for this song";
                opacity: root.lyrics-note-shown;
                animate opacity { duration: Motion.reduced ? 0ms : 180ms; easing: ease-out; }
                color: Theme.dim;
                font-size: 26px;
                font-weight: 700;
                wrap: word-wrap;
            }
            // Kept inside the part the compositor blurs (clear of the pills above and below). Always there, so
            // the window can say where the line sung is; its lines only while shown.
            full-lyrics := Flickable {
                visible: root.full-panel == 2 && root.lyrics-lines.length > 0;
                opacity: root.lyrics-waiting ? 0 : 1;
                animate opacity { duration: Motion.reduced ? 0ms : 200ms; easing: ease-out; }
                property <bool> waiting: root.lyrics-waiting;
                changed waiting => {
                    if !self.waiting {
                        self.content-y = 0;
                    }
                }
                flicked => { root.full-lyrics-browsed = true; }
                x: root.width / 2 + 20px;
                width: root.width / 2 - 140px;
                y: 48px;
                height: root.height - 48px - 56px;
                content-height: full-sung.preferred-height;
                animate content-y { duration: Motion.reduced ? 0ms : 640ms; easing: cubic-bezier(0.25, 0.8, 0.3, 1); }
                full-sung := VerticalLayout {
                    width: parent.width;
                    padding-top: root.height * 0.36 - 48px;
                    padding-bottom: root.height;
                    spacing: 36px;
                    for line[i] in full-lyrics.visible ? root.lyrics-lines : []: Text {
                        property <bool> lit: i == root.lyrics-active;
                        // The line the lyrics are scrolled to: the one sung, or the last once all are over.
                        property <bool> aimed: i == min(root.lyrics-active, root.lyrics-lines.length - 1);
                        // As the panel's: how lit, fading as it changes, whether or not the line is drawn just then.
                        property <float> level;
                        animate level { duration: Motion.reduced ? 0ms : 500ms; easing: ease-out; }
                        changed lit => {
                            self.level = self.lit ? 1 : 0;
                        }
                        changed aimed => {
                            if self.aimed {
                                full-lyrics.content-y = -(self.y - (root.height * 0.36 - 48px));
                                root.full-lyric-h = self.height;
                                root.full-lyric-at = self.y;
                                root.full-lyrics-browsed = false;
                            }
                        }
                        init => {
                            self.level = self.lit ? 1 : 0;
                            if self.aimed {
                                full-lyrics.content-y = -(self.y - (root.height * 0.36 - 48px));
                                root.full-lyric-h = self.height;
                                root.full-lyric-at = self.y;
                            }
                        }
                        // Laid out after init when the lyrics open, and again when a resize wraps the lines.
                        changed y => {
                            if self.aimed {
                                full-lyrics.content-y = -(self.y - (root.height * 0.36 - 48px));
                                root.full-lyric-h = self.height;
                                root.full-lyric-at = self.y;
                            }
                        }
                        text: root.lyrics-full-rows.length > i ? root.lyrics-full-rows[i] : line;
                        wrap: word-wrap;
                        font-size: 44px;
                        font-weight: 700;
                        // A line fades out over the last 72 px before either edge, gone before the edge would cut it.
                        property <length> shown-at: self.y + full-lyrics.content-y;
                        opacity: clamp(self.shown-at / 72px, 0, 1) * clamp((full-lyrics.height - self.shown-at - self.height) / 72px, 0, 1);
                        // Unsung lines are the ink at 36 %, as the swept line's are, so the cover's colours show through.
                        color: !root.lyric-sweeping ? (!root.lyrics-synced || self.lit ? Theme.text : Theme.text.with-alpha(0.36))
                            : self.lit ? transparent : Theme.text.with-alpha(0.36 + (1 - 0.36) * self.level);
                        animate color { duration: root.lyric-sweeping || Motion.reduced ? 0ms : 500ms; easing: ease-out; }
                        // The lit line filling without pieces to draw it (no face to measure in).
                        if root.lyric-sweeping && self.lit && root.lyric-pieces-full.length == 0: StyledText {
                            width: 100%;
                            height: 100%;
                            default-font-size: 44px;
                            default-color: Theme.text.with-alpha(0.36 + (1 - 0.36) * parent.level);
                            text: parent.lit ? @markdown("**\{root.lyric-sung}<font color=\"\{Theme.text.with-alpha(0.36 + 0.64 * root.lyric-mix)}\">\{root.lyric-now}</font><font color=\"\{Theme.dim}\">\{root.lyric-rest}</font>**") : @markdown("**\{line}**");
                        }
                        if self.lit && root.lyric-sweeping && root.lyric-pieces-full.length > 0: Rectangle {
                            width: 100%;
                            height: 100%;
                            for p in root.lyric-pieces-full: Text {
                                x: p.x * 1px;
                                y: p.y * 1px - p.lift * 3px;
                                width: p.w * 1px;
                                text: p.text;
                                wrap: no-wrap;
                                font-size: 44px;
                                font-weight: 700;
                                color: @linear-gradient(90deg, Theme.text.with-alpha(p.a0) 0%, Theme.text.with-alpha(p.aa) p.a * 100%, Theme.text.with-alpha(p.ab) p.b * 100%, Theme.text.with-alpha(p.a1) 100%);
                                transform-scale-x: (1 + 0.04 * p.swell) * 100%;
                                transform-scale-y: (1 + 0.04 * p.swell) * 100%;
                            }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.lyric-tapped(i); }
                        }
                    }
                }
            }
            if full-screen.visible && root.full-panel == 1: QueueView {
                x: root.width / 2 + 10px;
                width: root.width / 2 - 70px;
                y: 84px;
                height: root.height - 84px - 70px;
                queue: root.queue;
                from: root.queue-from;
                covers-rev: root.covers-rev;
                editable: !Jam.guest;
                movable: !root.shuffle;
                undo-text: root.queue-undo;
                art(a, s, r) => { return root.art(a, s, r); }
                jump(i) => { root.jump(i); }
                clear => { root.clear-queue(); }
                remove(i) => { root.remove-queued(i); }
                move(f, t) => { root.move-queued(f, t); }
                undo => { root.undo-removed(); }
            }

            // The panel's tabs, heading the right half: the devices, lyrics, the queue. Pressing the lit one shows the
            // artwork alone.
            PanelTabs {
                x: root.width / 2 + 10px;
                y: 8px;
                current: root.full-panel;
                devices: root.devices-on;
                picked(p) => { root.full-panel = root.full-panel == p ? 0 : p; }
            }
            if full-screen.visible && root.full-panel == 3: DevicesView {
                x: root.width / 2 + 10px;
                width: root.width / 2 - 70px;
                y: 64px;
                height: root.height - 64px - 40px;
                devices: root.devices;
                pairing-link: root.pairing-link;
                forget-devices => { root.forget-devices(); }
                pick(id) => { root.pick-device(id); }
                open-jam => { root.full-panel = 1; }
                join-jam => { root.join-open = true; }
                show-pairing => { root.pairing-open = true; }
            }
        }

        // Join a Jam: a sheet over the window, as the Mac's sheets come down from its top.
        // A lyrics service's key: typed, it is kept and the service switched on; removed, every service that
        // needs it is switched off.
        if root.key-open: Rectangle {
            background: Theme.ground.with-alpha(0.6);
            TouchArea {
                clicked => { root.key-open = false; }
            }
            MenuSheet {
                x: (parent.width - self.width) / 2;
                y: 80px;
                width: 380px;
                height: key-sheet.preferred-height;
                TouchArea {}
                key-sheet := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text {
                        text: root.key-title + " key";
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 700;
                    }
                    Field {
                        height: 34px;
                        border-radius: 8px;
                        clip: true;
                        icon: Icons.key;
                        secret: true;
                        placeholder: "Key";
                        text <=> root.key-text;
                        accepted => {
                            root.setting-typed("lyricsKey:" + root.key-service, root.key-text);
                            root.key-open = false;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        if root.key-set: SmallButton {
                            y: (parent.height - self.height) / 2;
                            text: "Remove key";
                            clicked => {
                                root.setting-typed("lyricsKey:" + root.key-service, "");
                                root.key-open = false;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        SmallButton {
                            y: (parent.height - self.height) / 2;
                            text: "Cancel";
                            clicked => { root.key-open = false; }
                        }
                        Capsule {
                            text: "Save";
                            clicked => {
                                root.setting-typed("lyricsKey:" + root.key-service, root.key-text);
                                root.key-open = false;
                            }
                        }
                    }
                }
            }
        }

        if root.lyrics-sheet-open: Rectangle {
            background: Theme.ground.with-alpha(0.6);
            TouchArea {
                clicked => { root.lyrics-sheet-open = false; }
            }
            MenuSheet {
                x: (parent.width - self.width) / 2;
                y: 80px;
                width: 380px;
                height: timing-sheet.preferred-height;
                TouchArea {}
                timing-sheet := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text {
                        text: "Lyrics";
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.lyrics-from;
                        color: Theme.text;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    if root.lyrics-synced: Text {
                        text: root.lyrics-timing;
                        color: Theme.dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    // The shift in a slot of its own width, so − and + stay put as it changes.
                    if root.lyrics-synced: HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        SmallButton {
                            y: (parent.height - self.height) / 2;
                            text: "−";
                            clicked => { root.lyrics-nudge(-1); }
                        }
                        Text {
                            width: 96px;
                            text: root.lyrics-shift;
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        SmallButton {
                            y: (parent.height - self.height) / 2;
                            text: "+";
                            clicked => { root.lyrics-nudge(1); }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        if root.lyrics-yours: SmallButton {
                            y: (parent.height - self.height) / 2;
                            text: "Reset";
                            clicked => { root.lyrics-nudge(0); }
                        }
                        Capsule {
                            text: "Close";
                            clicked => { root.lyrics-sheet-open = false; }
                        }
                    }
                }
            }
        }

        if root.details-open: Rectangle {
            background: Theme.ground.with-alpha(0.6);
            TouchArea {
                clicked => { root.details-open = false; }
            }
            MenuSheet {
                x: (parent.width - self.width) / 2;
                y: 60px;
                width: 440px;
                height: min(details-sheet.preferred-height, parent.height - 120px);
                TouchArea {}
                details-sheet := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text {
                        text: "Details";
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 700;
                    }
                    Flickable {
                        vertical-stretch: 1;
                        min-height: min(lines.preferred-height, 120px);
                        preferred-height: lines.preferred-height;
                        content-height: lines.preferred-height;
                        lines := VerticalLayout {
                            spacing: 8px;
                            for d in root.details: VerticalLayout {
                                Text {
                                    text: d.label;
                                    color: Theme.dim;
                                    font-size: 11px;
                                }
                                Text {
                                    text: d.value;
                                    color: Theme.text;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        Capsule {
                            text: "Close";
                            clicked => { root.details-open = false; }
                        }
                    }
                }
            }
        }

        if root.picker-open: Rectangle {
            background: Theme.ground.with-alpha(0.6);
            TouchArea {
                clicked => { root.picker-open = false; }
            }
            MenuSheet {
                x: (parent.width - self.width) / 2;
                y: 60px;
                width: 380px;
                height: min(picker-sheet.preferred-height, parent.height - 120px);
                TouchArea {}
                picker-sheet := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text {
                        text: "Add to playlist";
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 700;
                    }
                    Field {
                        height: 34px;
                        border-radius: 8px;
                        clip: true;
                        icon: Icons.plus;
                        placeholder: "New playlist";
                        text <=> root.picker-name;
                        accepted => {
                            if root.picker-name != "" {
                                root.add-to-new-playlist(root.picker-name);
                            }
                        }
                    }
                    Flickable {
                        vertical-stretch: 1;
                        min-height: min(choices.preferred-height, 120px);
                        preferred-height: choices.preferred-height;
                        content-height: choices.preferred-height;
                        choices := VerticalLayout {
                            for c in root.picker-playlists: MenuRow {
                                icon: Icons.playlist;
                                text: c.title;
                                clicked => { root.add-to-playlist(c.id); }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        SmallButton {
                            y: (parent.height - self.height) / 2;
                            text: "Cancel";
                            clicked => { root.picker-open = false; }
                        }
                        Capsule {
                            text: "Create";
                            clicked => {
                                if root.picker-name != "" {
                                    root.add-to-new-playlist(root.picker-name);
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.join-open: Rectangle {
            background: Theme.ground.with-alpha(0.6);
            TouchArea {
                clicked => { root.join-open = false; }
            }
            MenuSheet {
                x: (parent.width - self.width) / 2;
                y: 80px;
                width: 420px;
                height: sheet.preferred-height;
                TouchArea {}
                sheet := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    HorizontalLayout {
                        alignment: center;
                        Icon {
                            glyph: Icons.community;
                            colour: Theme.text;
                            width: 30px;
                            height: 30px;
                        }
                    }
                    Text {
                        text: "Join a jam or pair devices";
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Paste the invite link someone sent you. You can ask for songs, and see what plays and who added it.";
                        color: Theme.dim;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    Field {
                        height: 34px;
                        border-radius: 8px;
                        clip: true;
                        icon: Icons.community;
                        placeholder: "https://…/nori/jam#…";
                        text <=> root.join-link;
                        accepted => { root.join-jam(root.join-link); }
                    }
                    if root.join-error != "": Text {
                        text: root.join-error;
                        color: Theme.danger;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        SmallButton {
                            text: "Cancel";
                            clicked => { root.join-open = false; }
                        }
                        Capsule {
                            text: root.join-busy ? "Joining…" : "Join";
                            icon: Icons.community;
                            clicked => {
                                if !root.join-busy {
                                    root.join-jam(root.join-link);
                                }
                            }
                        }
                    }
                }
            }
        }

        // Sign in: the steps to copy a signed-in browser's cookies, and the field they are pasted in.
        if root.signin-open: Rectangle {
            background: Theme.ground.with-alpha(0.6);
            TouchArea {
                clicked => { root.signin-open = false; }
            }
            MenuSheet {
                x: (parent.width - self.width) / 2;
                y: max(40px, (parent.height - self.height) / 2);
                width: 440px;
                height: signin-sheet.preferred-height;
                TouchArea {}
                signin-sheet := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text {
                        text: root.signin-user != "" ? "YouTube Music" : "Sign in to YouTube Music";
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    if root.signin-user != "": Text {
                        text: "Signed in as " + root.signin-user;
                        color: Theme.dim;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                    if root.signin-user != "": HorizontalLayout {
                        alignment: center;
                        Capsule {
                            text: "Sign out";
                            icon: Icons.log-out;
                            ink: Theme.plate;
                            label: Theme.plate-ink;
                            clicked => { root.sign-out(); }
                        }
                    }
                    if root.signin-user == "": Text {
                        text: root.signin-busy ? "Finish signing in in the window that opened." : root.signin-ended ? "YouTube signed you out. Sign in again to see your library and likes." : "See your own Home, your library and your likes. Music plays without it too.";
                        color: Theme.dim;
                        font-size: 13px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    if root.signin-user == "": HorizontalLayout {
                        alignment: center;
                        Capsule {
                            text: root.signin-busy ? "Signing in…" : "Sign in with Google";
                            icon: Icons.user;
                            clicked => { root.sign-in-window(); }
                        }
                    }
                    if root.signin-error != "": Text {
                        text: root.signin-error;
                        color: Theme.danger;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    // Pasting, the advanced way in: a quiet link until asked for.
                    if root.signin-user == "" && !root.signin-pasting: HorizontalLayout {
                        alignment: center;
                        ShowAllLink {
                            text: "Paste cookies instead";
                            font-size: 12px;
                            clicked => { root.signin-pasting = true; }
                        }
                    }
                    if root.signin-user == "" && root.signin-pasting: Text {
                        text: "Sign in to music.youtube.com in a private browser window, copy the Cookie header of any request it makes from the developer tools, and paste it here.";
                        color: Theme.dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    if root.signin-user == "" && root.signin-pasting: HorizontalLayout {
                        spacing: 8px;
                        Field {
                            icon: Icons.key;
                            secret: true;
                            placeholder: "Cookie header";
                            text <=> root.signin-text;
                            accepted => { root.sign-in(root.signin-text); }
                        }
                        SmallButton {
                            y: (parent.height - self.height) / 2;
                            text: "Open YouTube Music";
                            clicked => { root.open-sign-in-page(); }
                        }
                        SmallButton {
                            y: (parent.height - self.height) / 2;
                            text: "Sign in";
                            enabled: root.signin-text != "";
                            clicked => { root.sign-in(root.signin-text); }
                        }
                    }
                    Text {
                        text: "Unofficial apps are against YouTube’s terms, and YouTube may flag an account that uses one.";
                        color: Theme.faint;
                        font-size: 11px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        if root.signin-ended: SmallButton {
                            text: "Don’t show again";
                            clicked => { root.sign-in-quiet(); }
                        }
                        SmallButton {
                            text: "Close";
                            clicked => { root.signin-open = false; }
                        }
                    }
                }
            }
        }

        // Pair a device: this computer's code to scan with nori, or to copy, in a sheet over the window.
        if root.pairing-open: Rectangle {
            background: Theme.ground.with-alpha(0.6);
            TouchArea {
                clicked => { root.pairing-open = false; }
            }
            MenuSheet {
                x: (parent.width - self.width) / 2;
                y: max(40px, (parent.height - self.height) / 2);
                width: 380px;
                height: pair-sheet.preferred-height;
                TouchArea {}
                pair-sheet := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text {
                        text: "Pair a device";
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Scan this code on your other device, or paste the link there. Paired devices can move and control playback on this network.";
                        color: Theme.dim;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 208px;
                            height: 208px;
                            border-radius: 16px;
                            background: white;
                            Image {
                                width: 184px;
                                height: 184px;
                                source: root.pairing-qr;
                                image-rendering: pixelated;
                            }
                        }
                    }
                    Rectangle {
                        height: 32px;
                        border-radius: 8px;
                        background: Theme.fill;
                        Text {
                            x: 10px;
                            width: parent.width - 20px;
                            text: root.pairing-link;
                            color: Theme.dim;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        SmallButton {
                            y: (parent.height - self.height) / 2;
                            text: "Done";
                            clicked => { root.pairing-open = false; }
                        }
                        Capsule {
                            text: "Copy link";
                            icon: Icons.copy;
                            clicked => { root.copy-pairing(); }
                        }
                    }
                }
            }
        }
    }
}

// The player as its own window, composited as a glass layer over the page (compositor.rs).
// The player pill as a window of its own, laid over the blurred page by the compositor (compositor.rs).
export component PlayerBar inherits Window {
    title: "nori player";
    no-frame: true;
    preferred-width: 900px;
    preferred-height: 64px;
    background: transparent;
    default-font-size: 13px;
    default-font-family: Type.body;
    in property <bool> has-song;
    in property <string> now-title;
    in property <string> now-artist;
    in property <string> now-album;
    in property <string> now-artist-id;
    in property <Credits> now-credits;
    in property <bool> now-starred;
    in property <string> now-album-id;
    in property <string> now-art;
    in property <bool> playing;
    in property <bool> buffering;
    in property <int> position-ms;
    in property <int> duration-ms;
    // A radio station or live stream plays: "Live" stands where the seek bar would.
    in property <bool> live;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <float> volume: 1;
    in property <int> inspector;
    in property <int> covers-rev;
    in property <bool> devices-on;
    in property <string> jam;
    in property <string> playing-on;
    in property <bool> guest;
    in property <bool> can-play: true;
    in property <bool> can-skip: true;
    in property <bool> can-seek: true;
    in property <length> room;
    pure callback art(string, int, int) -> image;
    callback toggle();
    callback star();
    callback next();
    callback previous();
    callback seek(float);
    callback set-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback set-inspector(int);
    callback open-full();
    // The song playing's menu, which opens in the main window.
    callback open-song-menu();
    // The pill: the page's colour over the blur the compositor draws behind (55 %), and the chrome's outline.
    Rectangle {
        border-radius: Chrome.player-radius;
        background: Theme.ground.with-alpha(Chrome.tint);
        border-width: 1px;
        border-color: Theme.outline;
    }
    PlayerControls {
        width: parent.width;
        height: parent.height;
        room: root.room;
        has-song: root.has-song;
        now-title: root.now-title;
        now-artist: root.now-artist;
        now-album: root.now-album;
        now-artist-id: root.now-artist-id;
        now-credits: root.now-credits;
        now-starred: root.now-starred;
        now-album-id: root.now-album-id;
        now-art: root.now-art;
        playing: root.playing;
        buffering: root.buffering;
        position-ms: root.position-ms;
        duration-ms: root.duration-ms;
        live: root.live;
        shuffle: root.shuffle;
        repeat: root.repeat;
        volume: root.volume;
        inspector: root.inspector;
        covers-rev: root.covers-rev;
        devices-on: root.devices-on;
        jam: root.jam;
        guest: root.guest;
        can-play: root.can-play;
        can-skip: root.can-skip;
        can-seek: root.can-seek;
        playing-on: root.playing-on;
        art(a, s, r) => { return root.art(a, s, r); }
        toggle => { root.toggle(); }
        star => { root.star(); }
        next => { root.next(); }
        previous => { root.previous(); }
        seek(v) => { root.seek(v); }
        set-volume(v) => { root.set-volume(v); }
        toggle-shuffle => { root.toggle-shuffle(); }
        cycle-repeat => { root.cycle-repeat(); }
        set-inspector(i) => { root.set-inspector(i); }
        open-full => { root.open-full(); }
        open-song-menu => { root.open-song-menu(); }
    }
}

// The top pill as a window of its own, laid over the blurred page by the compositor (compositor.rs).
export component TopBar inherits Window {
    title: "nori";
    no-frame: true;
    preferred-width: 900px;
    preferred-height: 48px;
    background: transparent;
    default-font-size: 13px;
    default-font-family: Type.body;
    // The pill's width (app.rs keeps it from the compositor's), which the tabs' names depend on.
    in property <length> room;
    in property <int> view;
    in property <int> page-kind;
    in property <bool> guest;
    in-out property <string> search-text;
    callback go(int);
    callback open-menu();
    callback search-edited(string);
    callback typing(bool);
    public function focus-search() {
        content.focus-search();
    }
    public function end-search() {
        content.end-search();
    }
    Rectangle {
        border-radius: Chrome.top-radius;
        background: Theme.ground.with-alpha(Chrome.tint);
        border-width: 1px;
        border-color: Theme.outline;
    }
    content := TopContent {
        width: parent.width;
        height: parent.height;
        room: root.room;
        view: root.view;
        page-kind: root.page-kind;
        guest: root.guest;
        search-text <=> root.search-text;
        go(v) => { root.go(v); }
        open-menu => { root.open-menu(); }
        search-edited(t) => { root.search-edited(t); }
        typing(on) => { root.typing(on); }
    }
}
