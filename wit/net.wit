package nori:plugin@2.0.0;

/// TCP and UDP. With `lan` only to private addresses; each socket closes when its handle is dropped.
interface sockets {
    use types.{error};

    resource tcp {
        connect: static func(host: string, port: u16, timeout-ms: u32) -> result<tcp, error>;
        /// Up to `max` bytes; empty at the end of the stream. Waits at most `timeout-ms`.
        read: func(max: u32, timeout-ms: u32) -> result<list<u8>, error>;
        write: func(bytes: list<u8>) -> result<_, error>;
        /// Wraps the stream in TLS (rustls in the host).
        tls: func(server-name: string, verify: tls-verify) -> result<_, error>;
    }

    variant tls-verify {
        /// The system's roots.
        system,
        /// Only this certificate (DER).
        pinned(list<u8>),
        /// None: only for a private address the plugin discovered (a Chromecast's own certificate).
        none,
    }

    /// IPv6 and IPv4 both, where the system has IPv6.
    resource udp {
        bind: static func(port: u16) -> result<udp, error>;
        /// Joins a multicast group of the LAN ("239.255.255.250", "ff02::c", "ff02::fb%3" on interface
        /// 3); the host holds Android's multicast lock while one is joined.
        join: func(group: string) -> result<_, error>;
        send: func(host: string, port: u16, bytes: list<u8>) -> result<_, error>;
        /// A datagram and who sent it, waiting at most `timeout-ms`; none on timeout. A link-local
        /// IPv6 sender comes with its zone ("fe80::1%3"), which `send` and `tcp.connect` take.
        receive: func(timeout-ms: u32) -> result<option<tuple<string, u16, list<u8>>>, error>;
    }
}

/// mDNS browsing (Android's NSD, the desktop's mDNS), only while the plugin asks (an output picker open).
interface discovery {
    /// Starts browsing `kind` ("_googlecast._tcp"); services found come to the `discovered` hook.
    browse: func(kind: string);
    stop: func(kind: string);
}

/// HTTP endpoints under nori's LAN door, at `/p/<plugin>/...`: requests come to the `served` hook.
interface lan-serve {
    /// The door's base URL other devices on the LAN reach, once it is open.
    base: func() -> option<string>;
    open: func();
    close: func();
}

/// Nori's final audio for a cast. The host moves every byte; no plugin code runs per buffer.
interface audio-out {
    use types.{error};
    use sockets.{tcp};

    enum encoding {
        pcm16,
        wav,
        flac,
    }

    /// How the audio goes into the socket.
    variant pace {
        /// In real time, a little ahead, as `encoding` (a snapserver's source, a small speaker).
        real-time,
        /// nori-sink-protocol, which the host speaks (docs/developers/plugins.md, "Deep sinks"): the
        /// device holds tens of seconds and asks for bursts, and says what it decodes, the rates and
        /// widths it takes and its cover size. The depth preferred, ms (the host fits it to the
        /// device's buffer). `encoding` is not used.
        deep(option<u32>),
    }

    /// Sends the audio into a socket the plugin opened, at `rate` and `channels`; none: each song's own.
    /// A deep sink is said Hello and answers before this returns.
    to-socket: func(socket: borrow<tcp>, encoding: encoding, rate: option<u32>, channels: option<u8>, pace: pace) -> result<_, error>;
    /// Serves it at a LAN URL under the door; the URL.
    serve: func(encoding: encoding) -> result<string, error>;
    /// The device's delay, ms: the seek bar and lyrics move by it.
    set-latency: func(ms: u32);
    stop: func();
}

/// What another device on the LAN fetches to play a song itself.
interface media {
    use types.{error};

    /// The song's stream URL reachable from the LAN (the server's own signed URL, or the door proxying it).
    stream-url: func(id: string) -> result<string, error>;
    cover-url: func(id: string, size: u32) -> result<string, error>;
}

/// A cast is a session the host owns: while one runs it holds what the platform needs (a Wi-Fi lock
/// for a sink, the session showing the cast, the volume keys), and drops it all when it ends, the
/// plugin stops or the device is lost.
interface cast {
    enum kind {
        /// Nori's final audio goes to the device (`audio-out`).
        sink,
        /// The device plays songs itself from URLs (`media`).
        target,
    }

    start: func(kind: kind, device-name: string);
    /// The device's state, for the player.
    report: func(playing: bool, position-ms: u64, volume: option<u8>);
    end: func();
}

/// Bluetooth to the devices the manifest's filter matches.
interface bluetooth {
    use types.{error};

    record device {
        /// The host's id of it.
        id: string,
        name: string,
        services: list<string>,
        vendor: option<u16>,
        product: option<u16>,
    }

    /// The connected devices the filter matches.
    connected: func() -> list<device>;

    /// An RFCOMM channel by service UUID. Bytes that come while no `read` waits come to the `notified`
    /// hook, with the service UUID as the characteristic.
    resource rfcomm {
        open: static func(device: string, service: string) -> result<rfcomm, error>;
        read: func(max: u32, timeout-ms: u32) -> result<list<u8>, error>;
        write: func(bytes: list<u8>) -> result<_, error>;
    }

    /// A BLE GATT connection; notifications come to the `notified` hook.
    resource gatt {
        open: static func(device: string) -> result<gatt, error>;
        mtu: func() -> u16;
        /// The UUIDs of the device's GATT services.
        services: func() -> list<string>;
        read: func(service: string, characteristic: string) -> result<list<u8>, error>;
        write: func(service: string, characteristic: string, bytes: list<u8>, with-response: bool) -> result<_, error>;
        notify: func(service: string, characteristic: string, on: bool) -> result<_, error>;
    }
}
